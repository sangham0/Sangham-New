# Sangham Library environment contract.
# Copy to .env for local development. NEVER commit real values.
# Server-only secrets must not carry the PUBLIC_ prefix.

# --- Supabase (canonical project: Sangham Back-end / uqvuqbwhbrqjynyxzecs) ---
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- PayFast (sandbox test credentials are public documentation values) ---
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# --- PayPal (sandbox app credentials from developer.paypal.com) ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Transactional email ('log' = record only, deliver nothing) ---
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM="Sangham <library@sangham.org>"

# --- Access control ---
ASSET_SIGN_TTL_SECONDS=900
ACCESS_LOG_SALT=
ADMIN_ALERT_EMAIL=

# --- Content ingestion (local runbook only; path outside this repo) ---
INGEST_SOURCE_DIR=
