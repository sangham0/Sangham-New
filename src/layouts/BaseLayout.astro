---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import StickyConsultationCTA from '../components/StickyConsultationCTA.astro';
import { Image } from 'astro:assets';
import sanghamLogo from '../assets/sangham-logo.png';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  jsonLd?: Record<string, unknown>[];
  hideStickyBar?: boolean;
  minimalNav?: boolean;
  noNav?: boolean;
}

const {
  title,
  description = 'Sangham offers integrative counselling, breathwork, and inner work online via video call. A place for careful, honest inner work.',
  image = '/images/og-default.jpg',
  canonicalURL = Astro.url.href,
  type = 'website',
  publishedDate,
  jsonLd,
  hideStickyBar = false,
  minimalNav = false,
  noNav = false,
} = Astro.props;

const siteName = 'Sangham';
// Pages should pass bare titles; the suffix is appended here. The endsWith
// guard prevents a double "| Sangham" if a page slips the suffix in anyway.
const fullTitle =
  title === siteName || title.endsWith(`| ${siteName}`)
    ? title
    : `${title} | ${siteName}`;

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://www.sangham.org/#organization',
  name: 'Sangham',
  url: 'https://www.sangham.org',
  logo: {
    '@type': 'ImageObject',
    url: 'https://www.sangham.org/sangham-logo.png',
    width: 400,
    height: 400,
  },
  description: 'Grounded counselling, breathwork, and meditation, integrated into a single practical process.',
  founder: {
    '@type': 'Person',
    name: 'Michael Kaplan',
    alternateName: 'Swami Ramarishi',
    jobTitle: 'Wellness Counsellor',
    url: 'https://www.sangham.org/about/',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'ramarishi@sangham.org',
    telephone: '+27736738063',
    contactType: 'customer service',
    availableLanguage: 'English',
  },
  sameAs: ['https://instagram.com/sangham.space'],
};

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://www.sangham.org/about/#michael-kaplan',
  name: 'Michael Kaplan',
  alternateName: 'Swami Ramarishi',
  url: 'https://www.sangham.org/about/',
  image: 'https://www.sangham.org/images/michael-kaplan.jpg',
  jobTitle: 'Wellness Counsellor',
  worksFor: { '@id': 'https://www.sangham.org/#organization' },
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'Professional Registration',
    name: 'ASCHP Registered Wellness Counsellor',
    identifier: 'Reg. No. 10559',
    recognizedBy: {
      '@type': 'Organization',
      name: 'Association for Supportive Counsellors and Holistic Practitioners',
      alternateName: 'ASCHP',
    },
  },
  sameAs: ['https://instagram.com/sangham.space'],
};

const canonicalPath = new URL(canonicalURL, Astro.site).pathname;
const hasBreadcrumb = jsonLd?.some((item) => item['@type'] === 'BreadcrumbList');
const pageLabel = title.split('|')[0].trim();
const breadcrumbJsonLd = canonicalPath === '/' || hasBreadcrumb
  ? null
  : {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://www.sangham.org/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: pageLabel,
          item: new URL(canonicalPath, Astro.site).href,
        },
      ],
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />

    {publishedDate && (
      <meta property="article:published_time" content={publishedDate} />
    )}

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    {breadcrumbJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    )}
    {jsonLd?.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <!-- Open Graph locale -->
    <meta property="og:locale" content="en_ZA" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <!-- Google Consent Mode v2: MUST load before GTM (production only) -->
    {import.meta.env.PROD && (
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}

        // Determine if visitor is in EEA (conservative: treat unknown as EEA)
        var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        var eeaZones = ['Europe/'];
        var isEEA = eeaZones.some(function(z){ return tz.indexOf(z) === 0; });

        // Default consent state
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: isEEA ? 'denied' : 'granted',
          wait_for_update: 500
        });

        // Check for previously stored consent
        try {
          var stored = JSON.parse(localStorage.getItem('sangham_consent') || 'null');
          if (stored && stored.ts && (Date.now() - stored.ts < 31536000000)) {
            gtag('consent', 'update', {
              ad_storage: stored.ad ? 'granted' : 'denied',
              ad_user_data: stored.ad ? 'granted' : 'denied',
              ad_personalization: stored.ad ? 'granted' : 'denied',
              analytics_storage: stored.analytics ? 'granted' : 'denied'
            });
          }
        } catch(e){}
      </script>
    )}

    <!-- Google Tag Manager (production only) -->
    {import.meta.env.PROD && (
      <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-M6SVCRV8');</script>
    )}
    <!-- End Google Tag Manager -->

    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    {import.meta.env.PROD && (
      <noscript>
        <iframe
          src="https://www.googletagmanager.com/ns.html?id=GTM-M6SVCRV8"
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <!-- End Google Tag Manager (noscript) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70] focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-foreground focus:rounded-lg font-body text-sm"
    >Skip to content</a>
    {noNav ? (
      <div class="fixed top-0 left-0 right-0 z-50 bg-nav/95 backdrop-blur-md border-b border-nav-foreground/10">
        <div class="container mx-auto px-6 py-4 flex items-center justify-center">
          <a href="/" aria-label="Sangham home">
            <Image src={sanghamLogo} alt="Sangham" class="h-10 w-auto opacity-70" widths={[80, 160]} loading="eager" />
          </a>
        </div>
      </div>
    ) : minimalNav ? (
      <nav class="fixed top-0 left-0 right-0 z-50 bg-nav/95 backdrop-blur-md border-b border-nav-foreground/10">
        <div class="container mx-auto px-6 py-4 flex items-center justify-between">
          <a href="/" class="flex items-center gap-3" aria-label="Sangham home">
            <Image src={sanghamLogo} alt="Sangham" class="h-10 w-auto" widths={[80, 160]} loading="eager" />
          </a>
          <div class="flex items-center gap-3 sm:gap-5">
            <a href="/about" class="hidden sm:block text-sm tracking-widest uppercase font-body text-nav-foreground/60 hover:text-nav-foreground transition-colors duration-200">About</a>
            <a href="/counselling" class="hidden sm:block text-sm tracking-widest uppercase font-body text-nav-foreground/60 hover:text-nav-foreground transition-colors duration-200">Counselling</a>
            <a href="/contact" class="px-5 py-2 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg text-xs tracking-wider uppercase font-body" data-cta="header-get-in-touch">Get in Touch</a>
            <a
              href="https://wa.me/27736738063"
              target="_blank"
              rel="noopener"
              class="hidden sm:inline-flex items-center gap-2 px-5 py-2 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg text-xs tracking-wider uppercase font-body"
              data-cta="header-whatsapp"
            >WhatsApp Me</a>
            <a
              href="https://wa.me/27736738063"
              target="_blank"
              rel="noopener"
              class="sm:hidden flex items-center justify-center w-9 h-9 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg"
              data-cta="header-whatsapp"
              aria-label="WhatsApp Me"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
          </div>
        </div>
      </nav>
    ) : (
      <Navigation />
    )}
    <main id="main-content" class="pt-[72px]">
      <slot />
    </main>
    <Footer />

    {!hideStickyBar && <StickyConsultationCTA />}

    <!-- WhatsApp floating button: mobile only. Hidden while the consent
         banner or a sticky CTA bar occupies the bottom edge, to avoid
         stacking three fixed elements on small screens. -->
    <a
      id="whatsapp-float"
      href="https://wa.me/27736738063"
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-6 right-6 z-50 flex items-center gap-2 px-4 py-3 rounded-full shadow-lg transition-all duration-300 hover:scale-105 md:hidden"
      style="background-color: #25D366;"
      aria-label="Chat on WhatsApp"
    >
      <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span class="text-white text-sm font-body font-medium">Chat on WhatsApp</span>
    </a>

    <!-- Cookie Consent Banner -->
    <div
      id="consent-banner"
      class="fixed bottom-3 left-3 right-3 md:left-auto md:right-4 md:max-w-xs z-[60] bg-nav border border-nav-foreground/10 rounded-xl shadow-xl shadow-black/20 p-4 max-h-[85vh] overflow-y-auto hidden"
      role="dialog"
      aria-label="Cookie consent"
    >
      <p class="font-body text-sm text-nav-foreground/70 leading-relaxed mb-4">
        This site uses cookies for analytics and advertising measurement.
        <a href="/privacy" class="underline text-nav-foreground/50 hover:text-gold-light transition-colors">Privacy policy</a>
      </p>
      <div class="flex flex-wrap gap-2">
        <button
          id="consent-accept"
          class="px-4 py-2 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg text-xs tracking-wider uppercase font-body"
        >Accept all</button>
        <button
          id="consent-reject"
          class="px-4 py-2 border border-nav-foreground/15 text-nav-foreground/60 hover:text-nav-foreground hover:border-nav-foreground/30 transition-all duration-300 rounded-lg text-xs tracking-wider uppercase font-body"
        >Reject all</button>
        <button
          id="consent-prefs"
          class="px-4 py-2 text-nav-foreground/40 hover:text-nav-foreground/60 transition-colors text-xs tracking-wider uppercase font-body"
        >Preferences</button>
      </div>
      <!-- Preferences panel (hidden by default) -->
      <div id="consent-prefs-panel" class="hidden mt-4 pt-4 border-t border-nav-foreground/10 space-y-3">
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" id="consent-analytics" checked class="accent-primary w-4 h-4" />
          <span class="font-body text-sm text-nav-foreground/60">Analytics (site improvement)</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" id="consent-ads" class="accent-primary w-4 h-4" />
          <span class="font-body text-sm text-nav-foreground/60">Advertising measurement</span>
        </label>
        <button
          id="consent-save"
          class="w-full mt-2 px-4 py-2 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg text-xs tracking-wider uppercase font-body"
        >Save preferences</button>
      </div>
    </div>

    <!-- Consent + Analytics Script -->
    <script>
      import '../scripts/analytics';
      import '../scripts/usd-rate';

      // Cookie Consent Banner Logic
      (function() {
        const banner = document.getElementById('consent-banner');
        const acceptBtn = document.getElementById('consent-accept');
        const rejectBtn = document.getElementById('consent-reject');
        const prefsBtn = document.getElementById('consent-prefs');
        const prefsPanel = document.getElementById('consent-prefs-panel');
        const saveBtn = document.getElementById('consent-save');
        const analyticsCheck = document.getElementById('consent-analytics') as HTMLInputElement;
        const adsCheck = document.getElementById('consent-ads') as HTMLInputElement;

        function hasConsent(): boolean {
          try {
            const stored = JSON.parse(localStorage.getItem('sangham_consent') || 'null');
            return stored && stored.ts && (Date.now() - stored.ts < 31536000000);
          } catch { return false; }
        }

        function saveConsent(analytics: boolean, ad: boolean) {
          const consent = { analytics, ad, ts: Date.now() };
          localStorage.setItem('sangham_consent', JSON.stringify(consent));

          // Update Consent Mode
          if (typeof window.dataLayer !== 'undefined') {
            function gtag(...args: any[]) { window.dataLayer.push(args); }
            window.dataLayer.push('consent', 'update', {
              ad_storage: ad ? 'granted' : 'denied',
              ad_user_data: ad ? 'granted' : 'denied',
              ad_personalization: ad ? 'granted' : 'denied',
              analytics_storage: analytics ? 'granted' : 'denied',
            });
          }

          banner?.classList.add('hidden');
          const float = document.getElementById('whatsapp-float');
          if (float && !document.querySelector('#sticky-cta.translate-y-0')) {
            float.style.display = '';
          }
        }

        // Show banner if no stored consent. While it is open, tuck the
        // WhatsApp float away so the bottom edge is not triple-stacked
        // on mobile.
        const waFloat = document.getElementById('whatsapp-float');
        if (!hasConsent() && banner) {
          banner.classList.remove('hidden');
          if (waFloat) waFloat.style.display = 'none';
        }

        acceptBtn?.addEventListener('click', () => saveConsent(true, true));
        rejectBtn?.addEventListener('click', () => saveConsent(false, false));
        prefsBtn?.addEventListener('click', () => prefsPanel?.classList.toggle('hidden'));
        saveBtn?.addEventListener('click', () => {
          saveConsent(analyticsCheck?.checked ?? false, adsCheck?.checked ?? false);
        });
      })();

      // "Cookie Preferences" footer link handler
      document.querySelectorAll('a[data-consent-reopen]').forEach(el => {
        el.addEventListener('click', (e) => {
          e.preventDefault();
          const banner = document.getElementById('consent-banner');
          banner?.classList.remove('hidden');
        });
      });
    </script>
  </body>
</html>
