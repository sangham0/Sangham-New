---
import { Image } from 'astro:assets';
import sanghamLogo from '../assets/sangham-logo.png';

const mainLinks = [
  { path: '/', label: 'Home' },
  { path: '/practices', label: 'Practices' },
  { path: '/about', label: 'About' },
  { path: '/workshops', label: 'Workshops' },
  { path: '/wisdom', label: 'Writing' },
  { path: '/contact', label: 'Contact' },
];

const counsellingSubItems = [
  { path: '/counselling', label: 'Counselling Overview' },
  { path: '/counselling-for-meditators', label: 'Counselling for Meditators' },
  { path: '/mentoring-for-adolescents', label: 'Mentoring for Teenagers' },
  { path: '/mentoring-for-young-men', label: 'Mentoring for Young Men' },
];

const currentPath = Astro.url.pathname;
const isCounsellingActive =
  currentPath === '/counselling' ||
  currentPath === '/counselling-for-meditators' ||
  currentPath.startsWith('/mentoring-');
---

<nav
  class="fixed top-0 left-0 right-0 z-50 bg-nav/95 backdrop-blur-md border-b border-nav-foreground/10"
>
  <div class="container mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <Image src={sanghamLogo} alt="Sangham" class="h-10 w-auto" widths={[80, 160]} />
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex items-center gap-8">
      <!-- Home -->
      <a
        href="/"
        class:list={[
          'text-sm tracking-widest uppercase font-body transition-colors duration-300',
          currentPath === '/' ? 'text-gold-light' : 'text-nav-foreground/60 hover:text-nav-foreground',
        ]}
      >Home</a>

      <!-- Counselling dropdown -->
      <div class="relative" id="counselling-dropdown">
        <a
          href="/counselling"
          class:list={[
            'text-sm tracking-widest uppercase font-body transition-colors duration-300 flex items-center gap-1.5',
            isCounsellingActive
              ? 'text-gold-light'
              : 'text-nav-foreground/75 hover:text-gold-light border-b border-primary/30',
          ]}
          aria-haspopup="true"
          aria-expanded="false"
          id="counselling-trigger"
        >
          Counselling
          <svg class="w-3 h-3 opacity-50 transition-transform duration-200" id="counselling-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        <div
          id="counselling-panel"
          class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible transition-all duration-200"
          role="menu"
        >
          <div class="bg-nav border border-nav-foreground/10 rounded-lg shadow-lg shadow-black/20 py-2 min-w-[240px]">
            {counsellingSubItems.map((item, i) => (
              <a
                href={item.path}
                role="menuitem"
                class:list={[
                  'block px-5 py-2.5 text-sm font-body transition-colors duration-200',
                  currentPath === item.path
                    ? 'text-gold-light'
                    : 'text-nav-foreground/60 hover:text-nav-foreground hover:bg-nav-foreground/5',
                  i < counsellingSubItems.length - 1 ? 'border-b border-nav-foreground/5' : '',
                ]}
                data-cta="nav-subitem"
                data-nav-item={item.label}
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Remaining links -->
      {mainLinks.filter(l => l.path !== '/').map((link) => (
        <a
          href={link.path}
          class:list={[
            'text-sm tracking-widest uppercase font-body transition-colors duration-300',
            currentPath === link.path
              ? 'text-gold-light'
              : 'text-nav-foreground/60 hover:text-nav-foreground',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Mobile toggle -->
    <button
      id="mobile-menu-toggle"
      class="lg:hidden text-nav-foreground"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden bg-nav border-b border-nav-foreground/10 overflow-hidden"
  >
    <div class="container mx-auto px-6 py-6 flex flex-col gap-1">
      <!-- Home -->
      <a
        href="/"
        class:list={[
          'text-sm tracking-widest uppercase font-body transition-colors py-2',
          currentPath === '/' ? 'text-gold-light' : 'text-nav-foreground/60 hover:text-nav-foreground',
        ]}
      >Home</a>

      <!-- Counselling with submenu -->
      <div>
        <button
          id="mobile-counselling-toggle"
          class:list={[
            'w-full text-left text-sm tracking-widest uppercase font-body transition-colors py-2 flex items-center justify-between',
            isCounsellingActive ? 'text-gold-light' : 'text-nav-foreground/75 hover:text-gold-light',
          ]}
          aria-expanded="false"
        >
          Counselling
          <svg class="w-3.5 h-3.5 opacity-50 transition-transform duration-200" id="mobile-counselling-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="mobile-counselling-submenu" class="hidden pl-4 pb-2 flex flex-col gap-1">
          {counsellingSubItems.map((item) => (
            <a
              href={item.path}
              class:list={[
                'text-sm font-body transition-colors py-1.5',
                currentPath === item.path
                  ? 'text-gold-light'
                  : 'text-nav-foreground/50 hover:text-nav-foreground',
              ]}
              data-cta="nav-subitem"
              data-nav-item={item.label}
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Remaining links -->
      {mainLinks.filter(l => l.path !== '/').map((link) => (
        <a
          href={link.path}
          class:list={[
            'text-sm tracking-widest uppercase font-body transition-colors py-2',
            currentPath === link.path
              ? 'text-gold-light'
              : 'text-nav-foreground/60 hover:text-nav-foreground',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  // Desktop dropdown: hover
  const dropdown = document.getElementById('counselling-dropdown');
  const panel = document.getElementById('counselling-panel');
  const trigger = document.getElementById('counselling-trigger');
  const chevron = document.getElementById('counselling-chevron');
  let closeTimer: ReturnType<typeof setTimeout>;

  function openDropdown() {
    clearTimeout(closeTimer);
    panel?.classList.remove('opacity-0', 'invisible');
    panel?.classList.add('opacity-100', 'visible');
    chevron?.classList.add('rotate-180');
    trigger?.setAttribute('aria-expanded', 'true');
    window.dataLayer?.push({ event: 'nav_dropdown_open', page_path: window.location.pathname });
  }

  function closeDropdown() {
    closeTimer = setTimeout(() => {
      panel?.classList.add('opacity-0', 'invisible');
      panel?.classList.remove('opacity-100', 'visible');
      chevron?.classList.remove('rotate-180');
      trigger?.setAttribute('aria-expanded', 'false');
    }, 150);
  }

  dropdown?.addEventListener('mouseenter', openDropdown);
  dropdown?.addEventListener('mouseleave', closeDropdown);

  // Keyboard: Down-arrow opens dropdown, Esc closes, Enter on trigger navigates
  trigger?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      openDropdown();
      const firstItem = panel?.querySelector('a');
      (firstItem as HTMLElement)?.focus();
    }
  });

  panel?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      closeDropdown();
      (trigger as HTMLElement)?.focus();
    }
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      const items = [...(panel?.querySelectorAll('a') ?? [])];
      const idx = items.indexOf(document.activeElement as HTMLAnchorElement);
      const next = e.key === 'ArrowDown' ? idx + 1 : idx - 1;
      if (next >= 0 && next < items.length) (items[next] as HTMLElement).focus();
    }
  });

  // Sub-item click tracking
  panel?.querySelectorAll('a[data-cta="nav-subitem"]').forEach(a => {
    a.addEventListener('click', () => {
      window.dataLayer?.push({
        event: 'nav_subitem_click',
        page_path: window.location.pathname,
        button_text: (a as HTMLElement).dataset.navItem,
        placement: 'header'
      });
    });
  });

  // Mobile counselling submenu toggle
  const mobileToggle = document.getElementById('mobile-counselling-toggle');
  const mobileSub = document.getElementById('mobile-counselling-submenu');
  const mobileChevron = document.getElementById('mobile-counselling-chevron');

  mobileToggle?.addEventListener('click', () => {
    const isOpen = !mobileSub?.classList.contains('hidden');
    mobileSub?.classList.toggle('hidden');
    mobileChevron?.classList.toggle('rotate-180');
    mobileToggle.setAttribute('aria-expanded', String(!isOpen));
    if (!isOpen) {
      window.dataLayer?.push({ event: 'nav_dropdown_open', page_path: window.location.pathname });
    }
  });

  // Mobile sub-item click tracking
  mobileSub?.querySelectorAll('a[data-cta="nav-subitem"]').forEach(a => {
    a.addEventListener('click', () => {
      window.dataLayer?.push({
        event: 'nav_subitem_click',
        page_path: window.location.pathname,
        button_text: (a as HTMLElement).dataset.navItem,
        placement: 'header'
      });
    });
  });
</script>
