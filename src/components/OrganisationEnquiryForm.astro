---
/**
 * A compact enquiry form for the two organisational counselling pages.
 *
 * It reuses the contact page's infrastructure wholesale: the same Formspree
 * endpoint, the same first-touch attribution helper, and the same honeypot.
 * No new backend is involved.
 *
 * The success event fires only on a 2xx response from Formspree. A click on
 * the button is already tracked separately as intent
 * (`organisation_enquiry_click`); this is the one that means an enquiry
 * actually arrived.
 */
import AttributionFields from './AttributionFields.astro';

interface Props {
  /** Analytics data-service, distinguishing the two organisational offers. */
  service: string;
  /** Subject line Michael sees in his inbox. */
  subject: string;
  /** Label for the size field, which counts employees on one page and participants on the other. */
  sizeLabel: string;
  sizePlaceholder: string;
  messagePlaceholder: string;
}

const { service, subject, sizeLabel, sizePlaceholder, messagePlaceholder } = Astro.props;

const field =
  'w-full bg-background/80 border border-border/70 rounded-lg px-4 py-3 text-foreground font-body placeholder:text-foreground/35 focus:outline-none focus:border-primary/60 transition-colors';
const labelClass = 'block text-sm font-body text-foreground/65 mb-2';
---

<div class="rounded-xl border border-border/60 bg-background/70 p-7 md:p-8" data-org-form-shell>
  <p class="font-body text-xs tracking-[0.14em] uppercase text-foreground/55 mb-5">Or send the details here</p>

  <form id="org-enquiry-form" class="space-y-5" data-form="organisation-enquiry" data-service={service}>
    <AttributionFields />
    <input type="hidden" name="_subject" value={subject} />
    <input type="hidden" name="enquiry_service" value={service} />

    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label for="org-name" class={labelClass}>Name</label>
        <input type="text" id="org-name" name="name" required class={field} placeholder="Your name" autocomplete="name" />
      </div>
      <div>
        <label for="org-organisation" class={labelClass}>Organisation</label>
        <input type="text" id="org-organisation" name="organisation" required class={field} placeholder="Organisation name" autocomplete="organization" />
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label for="org-email" class={labelClass}>Email</label>
        <input type="email" id="org-email" name="email" required class={field} placeholder="you@organisation.org" autocomplete="email" />
      </div>
      <div>
        <label for="org-size" class={labelClass}>{sizeLabel}</label>
        <input type="text" id="org-size" name="organisation_size" class={field} placeholder={sizePlaceholder} />
      </div>
    </div>

    <div>
      <label for="org-message" class={labelClass}>Anything you would like to add</label>
      <textarea id="org-message" name="message" rows="4" class={`${field} resize-none`} placeholder={messagePlaceholder}></textarea>
    </div>

    <!-- Honeypot: hidden from people, filled by bots. -->
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for="org-website-url">Website</label>
      <input type="text" id="org-website-url" name="website_url" tabindex="-1" autocomplete="off" />
    </div>

    <button
      id="org-submit-btn"
      type="submit"
      class="w-full sm:w-auto px-8 py-3.5 bg-primary text-primary-foreground hover:bg-gold-light transition-colors duration-300 rounded-lg text-sm tracking-wider uppercase font-body disabled:opacity-50 disabled:cursor-not-allowed"
      data-service={service}
      data-placement="enquiry-form"
    >Send enquiry</button>

    <p id="org-form-error" class="hidden font-body text-sm text-[hsl(0_45%_35%)]" role="alert" tabindex="-1"></p>

    <p class="font-body text-xs text-foreground/55 leading-relaxed">
      Used only to reply to your enquiry. Michael normally responds within 1 to 2 business days.
    </p>
  </form>

  <div id="org-form-success" class="hidden" role="status" tabindex="-1">
    <p class="font-heading text-2xl text-foreground mb-3">Thank you. Your enquiry has been sent.</p>
    <p class="font-body text-base text-foreground/75 leading-relaxed max-w-[52ch]">
      Michael normally replies within 1 to 2 business days. If you would rather add something in the meantime, WhatsApp reaches him directly.
    </p>
  </div>
</div>

<script>
  import { appendAttribution, pushDataLayer } from '../scripts/tracking';

  const form = document.getElementById('org-enquiry-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('org-submit-btn') as HTMLButtonElement | null;
  const formError = document.getElementById('org-form-error') as HTMLParagraphElement | null;
  const success = document.getElementById('org-form-success') as HTMLDivElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!submitBtn || !formError || !success) return;

    const service = form.dataset.service || 'organisation';
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    formError.classList.add('hidden');

    // Honeypot: fake success rather than revealing the trap.
    const honeypot = (document.getElementById('org-website-url') as HTMLInputElement | null)?.value;
    if (honeypot) {
      form.classList.add('hidden');
      success.classList.remove('hidden');
      return;
    }

    const data = appendAttribution(new FormData(form));

    try {
      const response = await fetch('https://formspree.io/f/mojpzywj', {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });

      if (!response.ok) throw new Error(`formspree_${response.status}`);

      // Only here: the enquiry reached Formspree.
      pushDataLayer('organisation_enquiry_submitted', {
        service,
        placement: 'enquiry-form',
      });

      form.classList.add('hidden');
      success.classList.remove('hidden');
      success.focus();
      success.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (error) {
      pushDataLayer('organisation_enquiry_failure', {
        service,
        error_type: error instanceof Error ? error.message : 'unknown',
      });
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send enquiry';
      formError.textContent =
        'Something went wrong sending that. Please try again, or email michael@sangham.org directly.';
      formError.classList.remove('hidden');
      formError.focus();
    }
  });
</script>
