---
interface Props {
  minHeight?: string;
  service?: string;
}
const { minHeight = '600px', service = 'adult-counselling' } = Astro.props;
---

<div class="cal-embed-shell" style={`min-height: ${minHeight};`}>
  <div
    id="cal-inline-embed"
    class="cal-embed-frame"
    style={`min-height: ${minHeight};`}
    aria-label="Fit call booking calendar"
  ></div>
  <div class="cal-embed-fallback" data-cal-fallback>
    <p>
      If the calendar does not load, you can
      <a
        href="https://cal.com/sangham/fit"
        target="_blank"
        rel="noopener noreferrer"
        data-cta="calendar-fallback"
        data-service={service}
        data-placement="calendar-fallback"
      >open the booking page directly</a>.
    </p>
  </div>
  <noscript>
    <p class="cal-embed-noscript">
      JavaScript is required for the embedded calendar. You can
      <a href="https://cal.com/sangham/fit">book the free 15-minute fit call on Cal.com</a>.
    </p>
  </noscript>
</div>

<style>
  .cal-embed-shell {
    width: 100%;
    max-height: 900px;
    overflow: auto;
    scroll-margin-top: 88px;
    background: var(--color-background);
  }

  .cal-embed-frame {
    width: 100%;
  }

  .cal-embed-fallback,
  .cal-embed-noscript {
    border-top: 1px solid var(--color-border);
    padding: 0.9rem 1.25rem;
    text-align: center;
    color: var(--color-muted-foreground);
    font-family: var(--font-body);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .cal-embed-fallback a,
  .cal-embed-noscript a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .cal-embed-shell {
      max-height: 760px;
    }
  }
</style>

<script is:inline define:vars={{ service }}>
(function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]);} else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");

var attribution = {};
try {
  attribution = JSON.parse(sessionStorage.getItem("sangham_attribution") || "{}");
} catch (e) {}

var calConfig = { layout: "month_view" };
["utm_source", "utm_medium", "utm_campaign", "utm_content"].forEach(function(key) {
  if (attribution[key]) calConfig[key] = attribution[key];
});

var fallback = document.querySelector("[data-cal-fallback] a");
if (fallback) {
  try {
    var fallbackUrl = new URL(fallback.href);
    ["utm_source", "utm_medium", "utm_campaign", "utm_content"].forEach(function(key) {
      if (attribution[key]) fallbackUrl.searchParams.set(key, attribution[key]);
    });
    fallback.href = fallbackUrl.toString();
  } catch (e) {}
}

function calEventParameters() {
  return {
    page_path: window.location.pathname,
    service: service,
    placement: "cal-embed",
    utm_source: attribution.utm_source || "",
    utm_medium: attribution.utm_medium || "",
    utm_campaign: attribution.utm_campaign || "",
    utm_content: attribution.utm_content || "",
    referral_code: attribution.ref || "",
    initial_landing_page: attribution.initial_landing_page || window.location.pathname,
    initial_referrer: attribution.initial_referrer || ""
  };
}

Cal("init", "fit-call", { origin: "https://cal.com" });
Cal.ns["fit-call"]("inline", {
  elementOrSelector: "#cal-inline-embed",
  calLink: "sangham/fit",
  config: calConfig
});
Cal.ns["fit-call"]("ui", { theme: "auto", hideEventTypeDetails: false, layout: "month_view" });

Cal.ns["fit-call"]("on", {
  action: "bookerViewed",
  callback: function(e) {
    var viewedKey = "sangham_cal_booker_viewed:" + window.location.pathname;
    try {
      if (sessionStorage.getItem(viewedKey)) return;
      sessionStorage.setItem(viewedKey, "1");
    } catch (error) {}

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(Object.assign({
      event: "cal_booking_initiated",
      cal_event_slug: "fit",
      cal_event_type_id: (e && e.detail && e.detail.data && e.detail.data.eventId) || ""
    }, calEventParameters()));
  }
});

Cal.ns["fit-call"]("on", {
  action: "bookingSuccessfulV2",
  callback: function(e) {
    var data = (e && e.detail && e.detail.data) || {};
    var payload = {
      booking_uid: data.uid || "",
      booking_status: data.status || "",
      event_type_id: data.eventTypeId || "",
      event_slug: "fit"
    };
    var destination = "/thank-you-fit-call/";

    try {
      sessionStorage.setItem("sangham_pending_fit_call", JSON.stringify(payload));
    } catch (error) {
      destination += "?booking_confirmed=1";
    }

    window.location.assign(destination);
  }
});
</script>
