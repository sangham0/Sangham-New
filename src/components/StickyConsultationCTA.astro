---
interface Props {
  /** Visible link text. */
  label?: string;
  /** Where the link points. */
  href?: string;
  /**
   * Optional CSS selector for an element the reader must scroll past before the
   * bar becomes available. When omitted, the bar appears after 60% scroll depth
   * (the original, site-wide behaviour).
   */
  afterSelector?: string;
  /** Visual register. 'dark' keeps the original site-wide chrome; 'light' is a warm parchment bar. */
  variant?: 'dark' | 'light';
  /** Optional WhatsApp link rendered as a quiet secondary action. */
  whatsappHref?: string;
  /**
   * When true, render a slim full-width bar on mobile and an unobtrusive
   * floating pill anchored bottom-right on desktop. When false (default), the
   * original single full-width bar is used at every width.
   */
  desktopFloating?: boolean;
  /** Analytics service identifier for the prompt. */
  service?: string;
  /** Conversion identifier for the primary prompt. */
  ctaId?: 'book-fit-call' | 'book-parent-consultation';
  /**
   * When true, the mobile bar shows WhatsApp as a visible second action at
   * every width instead of hiding it below 640px. Opt-in, so pages that treat
   * WhatsApp as a quiet fallback keep their existing behaviour.
   */
  prominentWhatsapp?: boolean;
}

const {
  label = 'Book a free 15-minute fit call →',
  href = '/contact/#cal-section',
  afterSelector = '',
  variant = 'dark',
  whatsappHref = '',
  desktopFloating = false,
  service = 'general',
  ctaId = 'book-fit-call',
  prominentWhatsapp = false,
} = Astro.props;

const light = variant === 'light';
---

<div
  id="sticky-cta"
  class="fixed bottom-0 left-0 right-0 z-40 translate-y-full transition-transform duration-500 ease-out"
  role="complementary"
  aria-label="Consultation prompt"
  data-after={afterSelector}
>
  {desktopFloating ? (
    <div class="pointer-events-none">
      <!-- Mobile: slim full-width bar -->
      <div
        class:list={[
          'md:hidden pointer-events-auto backdrop-blur-md border-t',
          light ? 'bg-background/95 border-border' : 'bg-nav/95 border-nav-foreground/10',
        ]}
      >
        <div class="container mx-auto px-6 py-3 flex items-center justify-between gap-4 max-w-4xl">
          <a
            href={href}
            class:list={[
              'text-sm font-body transition-colors',
              light ? 'text-foreground/80 hover:text-primary' : 'text-nav-foreground/70 hover:text-gold-light',
            ]}
            data-cta={ctaId}
            data-service={service}
            data-placement="sticky-mobile"
          >
            {label}
          </a>
          <div class="flex items-center gap-3">
            {whatsappHref && (prominentWhatsapp ? (
              <a
                href={whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-body transition-colors shrink-0',
                  light
                    ? 'border-primary/40 text-foreground/80 hover:border-primary hover:bg-primary/10'
                    : 'border-gold-light/30 text-nav-foreground/75 hover:border-gold-light hover:text-gold-light',
                ]}
                data-cta="whatsapp"
                data-channel="whatsapp"
                data-service={service}
                data-placement="sticky-mobile"
              >
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                WhatsApp
              </a>
            ) : (
              <a
                href={whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'hidden sm:inline text-xs font-body transition-colors',
                  light ? 'text-muted-foreground hover:text-primary' : 'text-nav-foreground/45 hover:text-gold-light',
                ]}
                data-cta="whatsapp"
                data-channel="whatsapp"
                data-service={service}
                data-placement="sticky-mobile"
              >
                or WhatsApp
              </a>
            ))}
            <button
              data-cta-dismiss
              class:list={[
                'transition-colors p-1',
                light ? 'text-muted-foreground/60 hover:text-foreground' : 'text-nav-foreground/40 hover:text-nav-foreground/70',
              ]}
              aria-label="Dismiss consultation prompt"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Desktop: unobtrusive gold-accented floating pill, bottom-right -->
      <div class="hidden md:flex justify-end px-6 lg:px-8 pb-5">
        <div
          class:list={[
            'pointer-events-auto flex items-center gap-2.5 rounded-full border backdrop-blur-md pl-5 pr-2.5 py-2.5',
            light ? 'bg-background/95 border-primary/30 shadow-lg shadow-black/10' : 'bg-nav/95 border-gold-light/25 shadow-lg shadow-black/30',
          ]}
        >
          <span class:list={['w-1.5 h-1.5 rounded-full shrink-0', light ? 'bg-primary' : 'bg-gold-light']}></span>
          <a
            href={href}
            class:list={[
              'text-sm font-body transition-colors',
              light ? 'text-foreground/80 hover:text-primary' : 'text-nav-foreground/75 hover:text-gold-light',
            ]}
            data-cta={ctaId}
            data-service={service}
            data-placement="sticky-desktop"
          >
            {label}
          </a>
          <button
            data-cta-dismiss
            class:list={[
              'transition-colors p-1 rounded-full',
              light ? 'text-muted-foreground/50 hover:text-foreground' : 'text-nav-foreground/40 hover:text-nav-foreground/70',
            ]}
            aria-label="Dismiss consultation prompt"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  ) : (
    <div
      class:list={[
        'backdrop-blur-md border-t',
        light ? 'bg-background/95 border-border' : 'bg-nav/95 border-nav-foreground/10',
      ]}
    >
      <div class="container mx-auto px-6 py-3 flex items-center justify-between gap-4 max-w-4xl">
        <a
          href={href}
          class:list={[
            'text-sm font-body transition-colors',
            light ? 'text-foreground/80 hover:text-primary' : 'text-nav-foreground/70 hover:text-gold-light',
          ]}
          data-cta={ctaId}
          data-service={service}
          data-placement="sticky"
        >
          {label}
        </a>
        <div class="flex items-center gap-3">
          {whatsappHref && (
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                'hidden sm:inline text-xs font-body transition-colors',
                light ? 'text-muted-foreground hover:text-primary' : 'text-nav-foreground/45 hover:text-gold-light',
              ]}
              data-cta="whatsapp"
              data-channel="whatsapp"
              data-service={service}
              data-placement="sticky"
            >
              or WhatsApp
            </a>
          )}
          <button
            data-cta-dismiss
            class:list={[
              'transition-colors p-1',
              light ? 'text-muted-foreground/60 hover:text-foreground' : 'text-nav-foreground/40 hover:text-nav-foreground/70',
            ]}
            aria-label="Dismiss consultation prompt"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  )}
</div>

<style>
  /* Honour reduced-motion: appear without sliding */
  @media (prefers-reduced-motion: reduce) {
    #sticky-cta {
      transition: none;
    }
  }
</style>

<script>
  const cta = document.getElementById('sticky-cta');
  const dismissBtns = cta ? Array.from(cta.querySelectorAll('[data-cta-dismiss]')) : [];

  if (cta && !sessionStorage.getItem('sticky-cta-dismissed')) {
    let shown = false;

    const reveal = () => {
      if (shown) return;
      shown = true;
      cta.classList.remove('translate-y-full');
      cta.classList.add('translate-y-0');
      // The bar carries its own WhatsApp link; hide the floating WhatsApp
      // button so the bottom edge holds one prompt at a time on mobile.
      const waFloat = document.getElementById('whatsapp-float');
      if (waFloat) waFloat.style.display = 'none';
    };

    const afterSel = cta.dataset.after;
    const marker = afterSel ? document.querySelector(afterSel) : null;

    if (marker) {
      // Reveal once the marker has been scrolled up out of view (the reader has
      // moved beyond the opening / recognition section).
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
            reveal();
            io.disconnect();
          }
        }
      });
      io.observe(marker);
    } else {
      // Original behaviour: reveal after 60% scroll depth.
      window.addEventListener('scroll', () => {
        if (shown) return;
        const scrollPercent =
          window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
        if (scrollPercent > 0.6) reveal();
      });
    }

    const hide = () => {
      cta.classList.remove('translate-y-0');
      cta.classList.add('translate-y-full');
      sessionStorage.setItem('sticky-cta-dismissed', 'true');
      const waFloat = document.getElementById('whatsapp-float');
      if (waFloat) waFloat.style.display = '';
    };

    dismissBtns.forEach((btn) => btn.addEventListener('click', hide));
  }
</script>
