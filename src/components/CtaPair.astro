---
/**
 * A two-option conversion prompt: booking as the primary action, WhatsApp as a
 * genuine second pathway rather than a line of small print.
 *
 * Both actions carry the site's existing analytics attributes, so a new
 * checkpoint is tracked the same way as the hero and closing CTAs. Pass a
 * distinct `placement` at each checkpoint so scroll depth stays legible in
 * the dataLayer.
 *
 * The defaults are the individual fit-call pathway used across the counselling
 * pages. The organisational pages open with an email conversation instead of a
 * personal booking calendar, so the primary action's label, target, analytics
 * identifier and channel can each be overridden without duplicating the layout.
 */
interface Props {
  /** Background the prompt sits on. Chooses the button treatments. */
  tone?: 'light' | 'dark';
  /** Analytics data-placement, unique per checkpoint. */
  placement: string;
  /** Analytics data-service. */
  service: string;
  /** Primary action target. */
  href?: string;
  /** Primary action label. Defaults to the fit-call wording. */
  primaryLabel?: string;
  /** Analytics data-cta for the primary action. */
  primaryCta?: string;
  /** Analytics data-channel for the primary action, where it is a contact channel. */
  primaryChannel?: string;
  /** WhatsApp link, ideally with a prefilled opening message. */
  whatsappHref: string;
  /** WhatsApp action label. */
  whatsappLabel?: string;
  /** Optional reassurance line under the buttons. */
  note?: string;
  align?: 'left' | 'center';
}

const {
  tone = 'light',
  placement,
  service,
  href = '#book-call',
  primaryLabel = 'Book a free 15-minute fit call',
  primaryCta = 'book-fit-call',
  primaryChannel,
  whatsappHref,
  whatsappLabel = 'Start a conversation on WhatsApp',
  note,
  align = 'left',
} = Astro.props;

const dark = tone === 'dark';
// whitespace-nowrap keeps each label on one line; the row wraps to stacked
// buttons instead of breaking a label across two lines in a narrow column.
const base =
  'inline-flex items-center justify-center whitespace-nowrap rounded-lg text-sm font-body transition-colors duration-300';
// The gold fill is carried by the component's own scoped style below. It used
// to rely on a `.ctc-button` rule defined in one page's global style block,
// which left the primary action unfilled on any other page that used this
// component. The values are unchanged.
const primary = `cta-primary ${base} px-6 py-4 tracking-wider uppercase font-medium`;
const secondary = dark
  ? `${base} gap-2.5 px-5 py-4 tracking-wide border border-parchment/30 text-parchment/85 hover:border-gold-light hover:text-gold-light`
  : `${base} gap-2.5 px-5 py-4 tracking-wide border border-primary/45 text-foreground/85 hover:border-primary hover:bg-primary/10`;
---

<div class={align === 'center' ? 'text-center' : ''}>
  <div
    class:list={[
      'flex flex-col sm:flex-row sm:flex-wrap gap-3',
      align === 'center' && 'sm:justify-center',
    ]}
  >
    <a
      href={href}
      class={primary}
      data-cta={primaryCta}
      data-channel={primaryChannel}
      data-service={service}
      data-placement={placement}
    >
      {primaryLabel}
    </a>
    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class={secondary}
      data-cta="whatsapp"
      data-channel="whatsapp"
      data-service={service}
      data-placement={placement}
    >
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
        ><path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
        /></svg
      >
      {whatsappLabel}
    </a>
  </div>
  {note && (
    <p
      class:list={[
        'font-body text-sm italic mt-4',
        dark ? 'text-parchment/60' : 'text-foreground/65',
      ]}
    >
      {note}
    </p>
  )}
</div>

<style>
  .cta-primary {
    background: #d4a95c;
    color: #0f1422;
    text-align: center;
  }

  .cta-primary:hover {
    background: #e6be76;
  }
</style>
