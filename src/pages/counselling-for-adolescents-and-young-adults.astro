---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import CalEmbed from '../components/CalEmbed.astro';
import { Image } from 'astro:assets';
import swamiPortrait from '../assets/swami-ramarishi-portrait.jpg';
import forestPond from '../assets/forest-pond.jpg';

const canonicalURL = 'https://www.sangham.org/counselling-for-adolescents-and-young-adults';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Counselling for Adolescents and Young Adults',
    url: canonicalURL,
    description:
      'Online wellness counselling for adolescents and young adults. Practical, structured, and developmentally appropriate. ASCHP-registered. Available worldwide via video call.',
    serviceType: 'Wellness Counselling',
    provider: {
      '@type': 'Person',
      name: 'Michael Kaplan',
      alternateName: 'Swami Ramarishi',
      jobTitle: 'Wellness Counsellor',
      url: 'https://www.sangham.org/about',
      image: {
        '@type': 'ImageObject',
        url: 'https://www.sangham.org/images/michael-kaplan.jpg',
      },
      affiliation: {
        '@type': 'Organization',
        name: 'Association for Supportive Counsellors and Holistic Practitioners',
        alternateName: 'ASCHP',
        identifier: 'Reg. No. 10559',
      },
    },
    audience: {
      '@type': 'Audience',
      audienceType: 'Adolescents and Young Adults',
    },
    areaServed: [
      { '@type': 'Country', name: 'South Africa' },
      { '@type': 'Place', name: 'Worldwide' },
    ],
    availableChannel: {
      '@type': 'ServiceChannel',
      serviceType: 'Online via video call',
      availableLanguage: 'English',
    },
    offers: [
      {
        '@type': 'Offer',
        name: 'Single Session',
        price: '850',
        priceCurrency: 'ZAR',
        availability: 'https://schema.org/InStock',
        description: 'One 60-minute online session via video call.',
      },
      {
        '@type': 'Offer',
        name: 'Five-Session Process',
        price: '3400',
        priceCurrency: 'ZAR',
        availability: 'https://schema.org/InStock',
        description:
          'A structured five-session process: Mapping, Identifying, Intervening, Applying, Consolidating. Paid in advance.',
      },
    ],
  },
];

const fitItems = [
  'Pressure around academic performance and the future',
  'Difficulty managing strong emotions or reactions',
  'Anxiety, restlessness, or a persistent sense of something being off',
  'Relationship difficulties with peers, family, or authority',
  'Identity questions and the search for a clear sense of self',
  'Transitions: school to university, home to independence, one chapter to the next',
  'Difficulty following through on what matters despite genuine effort',
];

const howItWorksItems = [
  {
    num: '01',
    title: 'Practical, not abstract',
    text: 'Sessions focus on real situations and specific patterns rather than concepts or theory. What is actually happening gets examined directly.',
  },
  {
    num: '02',
    title: 'Non-judgmental',
    text: 'There is no expectation to arrive with the right vocabulary, a tidy story, or clear goals. Confusion and uncertainty are a normal starting point.',
  },
  {
    num: '03',
    title: 'Developmentally appropriate',
    text: 'The pace, depth, and focus are adapted to what is developmentally relevant. This is not adult counselling delivered to a younger person.',
  },
  {
    num: '04',
    title: 'Body-based and grounded',
    text: 'Breathwork and body-awareness are central tools. Young people often respond well to practical regulation techniques that do not require extended verbal processing.',
  },
];

const faqItems = [
  {
    q: 'Is this therapy?',
    a: 'No. Sangham is supportive wellness counselling, registered with the ASCHP. It is not psychology, psychotherapy, psychiatry, or clinical mental health treatment. Families who have previously worked with therapists often find this approach complements or extends what therapy began.',
  },
  {
    q: 'What age range does this cover?',
    a: 'This work is suited to people roughly between 14 and 28. The approach is adapted to what is developmentally relevant. Michael has extensive experience with both adolescents still in school and young adults navigating early independence.',
  },
  {
    q: 'Does the young person need to be willing to engage?',
    a: 'Yes. This kind of work requires genuine participation. It is not something that can be done to someone who is entirely resistant. That said, some initial reluctance is normal and does not need to be resolved before reaching out. The first conversation helps clarify whether now is the right time.',
  },
  {
    q: 'Can parents be involved?',
    a: 'The primary relationship is between Michael and the young person. Parent involvement, if any, is kept minimal and agreed upon clearly. Confidentiality is explained and respected. The young person needs to feel safe to speak honestly.',
  },
  {
    q: 'How does the free 15-minute fit call work?',
    a: 'The fit call is a short, no-obligation conversation to establish whether this is the right approach and the right moment. It is not a session. No deep processing, no intake forms. Just a direct conversation to see whether working together makes sense.',
  },
  {
    q: 'How quickly can we start?',
    a: 'Most enquiries receive a response within one to two business days. A fit call can typically be arranged within the same week.',
  },
];
---

<BaseLayout
  title="Counselling for Adolescents & Young Adults | Sangham"
  description="Online wellness counselling for adolescents and young adults. Practical, structured, and grounded. ASCHP-registered. Start with a free 15-minute fit call."
  canonicalURL={canonicalURL}
  image="/images/og-default.jpg"
  jsonLd={jsonLd}
  minimalNav={true}
  hideStickyBar={true}
>

  <!-- ═══ 1. HERO ═══════════════════════════════════════════════════════ -->
  <section class="-mt-[72px] pt-[72px] bg-header text-header-foreground">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-3xl">

      <p class="text-primary/45 text-xs tracking-widest uppercase font-body mb-8">
        Sangham &middot; Adolescents &amp; Young Adults
      </p>

      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-parchment/95 leading-tight mb-6">
        Counselling for<br class="hidden sm:block" />
        <span class="text-gold-gradient">Young People</span>
      </h1>

      <p class="font-body text-xl md:text-2xl text-parchment/65 leading-relaxed mb-4 max-w-2xl">
        Practical, grounded support for adolescents and young adults navigating pressure, uncertainty, and the complexity of early life.
      </p>

      <p class="font-body text-sm text-parchment/40 leading-relaxed mb-10 max-w-lg">
        Online sessions worldwide. Michael Kaplan (Swami Ramarishi),
        ASCHP-registered Wellness Counsellor (Reg.&nbsp;10559).
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="#cal-section"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg text-sm tracking-wider uppercase font-body font-medium shadow-lg shadow-primary/20"
        >
          Book a Free 15-Minute Fit Call
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-parchment/20 text-parchment/55 hover:border-parchment/40 hover:text-parchment/80 transition-all duration-300 rounded-lg text-sm tracking-wider uppercase font-body"
        >
          Send a Written Enquiry
        </a>
      </div>

    </div>
  </section>

  <!-- ═══ 2. WHO THIS IS FOR ════════════════════════════════════════════ -->
  <section class="bg-background">
    <div class="container mx-auto px-6 py-16 md:py-20 max-w-3xl">

      <h2 class="font-heading text-2xl md:text-3xl text-foreground mb-8 leading-snug">
        This work tends to support young people who are dealing with:
      </h2>

      <ul class="space-y-4 list-disc list-outside ml-6 marker:text-primary/40">
        {fitItems.map((item) => (
          <li class="text-muted-foreground font-body leading-relaxed">{item}</li>
        ))}
      </ul>

      <p class="mt-8 text-muted-foreground/70 font-body text-sm leading-relaxed max-w-xl">
        The approach integrates counselling, breathwork, and body-based awareness into a single practical process. No background in meditation or inner work is required.
      </p>

    </div>
  </section>

  <!-- ═══ 3. HOW IT WORKS ═══════════════════════════════════════════════ -->
  <section class="bg-header text-header-foreground">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-4xl">

      <p class="text-primary/45 text-xs tracking-widest uppercase font-body mb-3 text-center">
        The approach
      </p>
      <h2 class="font-heading text-3xl md:text-4xl text-gold-gradient text-center mb-5">
        Not adult counselling delivered smaller
      </h2>
      <p class="text-header-foreground/50 font-body leading-relaxed text-center max-w-2xl mx-auto mb-12">
        The process is adapted to be developmentally appropriate. What is worked with, how it is worked with, and the pace at which it proceeds reflects what is actually relevant at this stage of life.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-px rounded-xl overflow-hidden bg-header-foreground/8">
        {howItWorksItems.map((item) => (
          <div class="bg-void/50 p-8">
            <p class="text-primary/30 font-heading text-2xl leading-none mb-3">{item.num}</p>
            <h3 class="font-heading text-sm text-header-foreground/85 mb-2">{item.title}</h3>
            <p class="text-header-foreground/45 text-sm font-body leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══ 4. FIT CALL ═══════════════════════════════════════════════════ -->
  <section id="cal-section" class="bg-background">
    <div class="container mx-auto px-6 py-20 md:py-24 max-w-3xl">

      <p class="text-primary/45 text-xs tracking-widest uppercase font-body mb-3 text-center">
        Free &middot; 15 minutes &middot; No obligation
      </p>
      <h2 class="font-heading text-3xl md:text-4xl text-foreground text-center mb-4">
        Start with a fit call
      </h2>
      <p class="text-muted-foreground/70 font-body text-sm text-center max-w-md mx-auto mb-10 leading-relaxed">
        A short conversation to see whether this is the right approach and the right moment. Not a session. No intake forms. Just a direct exchange to establish fit.
      </p>

      <div class="border border-border/40 rounded-xl overflow-hidden">
        <CalEmbed minHeight="650px" />
      </div>

      <p class="text-muted-foreground/40 text-xs font-body text-center mt-6 leading-relaxed">
        Prefer to write first? <a href="/contact" class="text-primary/60 hover:text-primary transition-colors underline underline-offset-2 decoration-primary/20">Send an enquiry instead.</a>
      </p>

    </div>
  </section>

  <!-- ═══ 5. PRICING ════════════════════════════════════════════════════ -->
  <section class="bg-header text-header-foreground">
    <div class="container mx-auto px-6 py-20 md:py-24 max-w-3xl">

      <h2 class="font-heading text-3xl md:text-4xl text-gold-gradient text-center mb-12">
        What this costs
      </h2>

      <div class="border border-primary/20 rounded-2xl p-8 md:p-10 bg-void/30 max-w-sm mx-auto w-full">

        <div class="flex items-start justify-between gap-4 mb-5">
          <div>
            <p class="font-body text-sm text-header-foreground/65 mb-0.5">Single session</p>
            <p class="font-body text-xs text-header-foreground/30">60 minutes · online via video call</p>
          </div>
          <p class="font-heading text-2xl text-header-foreground/90 shrink-0 tabular-nums">R850</p>
        </div>

        <div class="border-t border-header-foreground/8 pt-5 flex items-start justify-between gap-4">
          <div>
            <p class="font-body text-sm text-header-foreground/65 mb-0.5">Five-session process</p>
            <p class="font-body text-xs text-header-foreground/30">R680 per session · paid in advance</p>
          </div>
          <div class="text-right shrink-0">
            <p class="font-heading text-2xl text-header-foreground/90 tabular-nums">R3,400</p>
            <p class="text-xs text-primary/45 font-body">Save R250</p>
          </div>
        </div>

        <div class="border-t border-header-foreground/8 pt-5 mt-5 space-y-2">
          <p class="text-header-foreground/40 text-xs font-body leading-relaxed">
            If cost is a genuine barrier, mention it when reaching out. A small number of reduced-rate spaces are available.
          </p>
          <p class="text-header-foreground/30 text-xs font-body leading-relaxed">
            Sessions are paid in advance via EFT. International clients may pay via PayPal.
          </p>
        </div>

      </div>

      <div class="mt-10 text-center">
        <a
          href="#cal-section"
          class="inline-flex items-center justify-center gap-2 px-10 py-4 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg text-sm tracking-wider uppercase font-body shadow-lg shadow-primary/20"
        >
          Book a Free Fit Call First
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
        <p class="text-header-foreground/30 text-xs font-body mt-3">
          No obligation. 15 minutes. You choose whether to continue.
        </p>
      </div>

    </div>
  </section>

  <!-- ═══ 6. ABOUT MICHAEL ═════════════════════════════════════════════ -->
  <section class="bg-background">
    <div class="container mx-auto px-6 py-20 md:py-24 max-w-3xl">

      <h2 class="font-heading text-2xl md:text-3xl text-foreground text-center mb-12">
        About Michael
      </h2>

      <div class="flex flex-col md:flex-row gap-10 items-start">

        <div class="shrink-0 mx-auto md:mx-0">
          <div class="w-40 h-40 rounded-full overflow-hidden border-2 border-primary/20">
            <Image
              src={swamiPortrait}
              alt="Michael Kaplan (Swami Ramarishi), ASCHP-registered Wellness Counsellor"
              class="w-full h-full object-cover"
              width={160}
              height={160}
              loading="lazy"
            />
          </div>
        </div>

        <div class="space-y-4">
          <p class="font-heading text-lg text-foreground/85">
            Michael Kaplan <span class="text-foreground/45 font-body text-sm">(Swami Ramarishi)</span>
          </p>
          <div class="space-y-3 text-muted-foreground font-body text-sm leading-relaxed">
            <p>
              Registered Wellness Counsellor with the Association for Supportive Counsellors
              and Holistic Practitioners (ASCHP, Reg.&nbsp;10559). Yoga Alliance RYS 300.
            </p>
            <p>
              Extensive experience working with adolescents and young adults in both individual and group settings, across South Africa and India. Background includes sustained work within schools, residential settings, and one-on-one practice.
            </p>
            <p>
              All sessions are conducted online via video call. Currently accepting new clients.
            </p>
          </div>
          <a
            href="/about"
            class="inline-flex items-center gap-1.5 text-primary/60 hover:text-primary text-sm font-body transition-colors"
          >
            Read more on the About page
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>

      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        <span class="px-4 py-2 border border-border/50 rounded-full text-xs font-body text-muted-foreground/55 tracking-wide">ASCHP Registered, Reg.&nbsp;10559</span>
        <span class="px-4 py-2 border border-border/50 rounded-full text-xs font-body text-muted-foreground/55 tracking-wide">Adolescents &amp; Young Adults</span>
        <span class="px-4 py-2 border border-border/50 rounded-full text-xs font-body text-muted-foreground/55 tracking-wide">Online worldwide</span>
        <span class="px-4 py-2 border border-border/50 rounded-full text-xs font-body text-muted-foreground/55 tracking-wide">Currently accepting new clients</span>
      </div>

    </div>
  </section>

  <!-- ═══ 7. SCOPE & ETHICS ════════════════════════════════════════════ -->
  <section class="bg-background border-t border-border/25">
    <div class="container mx-auto px-6 py-10 md:py-12 max-w-3xl">
      <div class="bg-muted/25 border border-border/40 rounded-lg p-6 md:p-8">
        <p class="text-xs text-muted-foreground/45 tracking-widest uppercase font-body mb-3">
          Scope and Ethics
        </p>
        <p class="font-body text-sm text-muted-foreground/65 leading-relaxed">
          Sangham is supportive wellness counselling under South African ASCHP registration.
          It is not psychology, psychiatry, psychotherapy, medical treatment, diagnosis, medication management,
          crisis support, or emergency mental health care. If clinical or acute support is needed,
          referral to an appropriate locally-licensed professional may be recommended.
        </p>
        <a
          href="/scope"
          class="inline-flex items-center gap-1 text-primary/45 hover:text-primary/80 text-xs font-body mt-4 transition-colors"
        >
          Full scope and ethics
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ 8. FAQ ════════════════════════════════════════════════════════ -->
  <section class="bg-header">
    <div class="container mx-auto px-6 py-20 md:py-24 max-w-3xl">
      <h2 class="font-heading text-3xl md:text-4xl text-gold-gradient text-center mb-12">
        Common questions
      </h2>
      <FAQ items={faqItems} dark={true} />
    </div>
  </section>

  <!-- ═══ 9. FINAL CTA ═════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden">
    <Image
      src={forestPond}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      widths={[640, 1024, 1536]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-void/83"></div>
    <div class="relative z-10 container mx-auto px-6 py-24 md:py-32 max-w-2xl text-center">

      <h2 class="font-heading text-3xl md:text-4xl text-gold-gradient mb-4">
        Start with a 15-minute conversation.
      </h2>
      <p class="text-parchment/55 font-body leading-relaxed mb-10 max-w-md mx-auto">
        Free. No obligation. Just a direct exchange to see whether this is the right fit.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#cal-section"
          class="inline-flex items-center justify-center gap-2 px-10 py-4 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg text-sm tracking-wider uppercase font-body shadow-lg shadow-primary/20"
        >
          Book a Fit Call
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-10 py-4 border border-parchment/20 text-parchment/55 hover:border-parchment/40 hover:text-parchment/80 transition-all duration-300 rounded-lg text-sm tracking-wider uppercase font-body"
        >
          Send an Enquiry
        </a>
      </div>

    </div>
  </section>

</BaseLayout>
