---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AttributionFields from '../components/AttributionFields.astro';
import PageHeader from '../components/PageHeader.astro';
import ArticleBadge from '../components/ArticleBadge.astro';
import { staticEssays } from '../data/static-essays';

// ─── Reading time ─────────────────────────────────────────────────────────────
function getReadingTime(body: string): number {
  const wordCount = body.split(/\s+/).length;
  return Math.max(1, Math.round(wordCount / 200));
}

// ─── Category system ──────────────────────────────────────────────────────────
type FilterId =
  | 'all'
  | 'start-here'
  | 'psychology'
  | 'meditation'
  | 'breathwork'
  | 'body'
  | 'relationship'
  | 'contemplative'
  | 'practice-guides';

const filters: { id: FilterId; label: string }[] = [
  { id: 'all',             label: 'All' },
  { id: 'psychology',      label: 'Psychology & Change' },
  { id: 'meditation',      label: 'Meditation' },
  { id: 'breathwork',      label: 'Breathwork & Nervous System' },
  { id: 'body',            label: 'Body & Movement' },
  { id: 'contemplative',   label: 'Contemplative Reflections' },
  { id: 'practice-guides', label: 'Practice Guides' },
];

// Human-readable labels shown as tags on individual cards
const cardTagLabels: Partial<Record<FilterId, string>> = {
  psychology:    'Psychology',
  meditation:    'Meditation',
  breathwork:    'Breathwork',
  body:          'Body',
  relationship:  'Relationships',
  contemplative: 'Contemplative',
};

// ─── Unified item list ────────────────────────────────────────────────────────
// Filter categories live in each piece's frontmatter (`categories`); the three
// art-directed essays contribute metadata from src/data/static-essays.ts.
interface LibraryItem {
  id: string;
  title: string;
  excerpt: string;
  datePublished: string;
  dateLabel: string;
  isGuide: boolean;
  notebook: boolean;
  cats: FilterId[];
  readTime: number;
  displayCats: FilterId[];
}

const entries = await getCollection('writing', ({ data }) => !data.draft);

const allItems: LibraryItem[] = [
  ...staticEssays.map((e) => {
    const cats = e.categories as FilterId[];
    return {
      id: e.id,
      title: e.title,
      excerpt: e.excerpt,
      datePublished: e.datePublished,
      dateLabel: e.dateLabel,
      isGuide: false,
      notebook: false,
      cats,
      readTime: e.readTime,
      displayCats: cats.filter(c => c !== 'start-here' && c !== 'practice-guides') as FilterId[],
    };
  }),
  ...entries.map((entry) => {
    const cats = entry.data.categories as FilterId[];
    return {
      id: entry.id,
      title: entry.data.title,
      excerpt: entry.data.excerpt,
      datePublished: entry.data.publishedDate.toISOString().slice(0, 10),
      dateLabel: entry.data.dateLabel,
      isGuide: entry.data.category === 'practice-guide',
      notebook: entry.data.notebook,
      cats,
      readTime: getReadingTime(entry.body ?? ''),
      displayCats: cats.filter(c => c !== 'start-here' && c !== 'practice-guides') as FilterId[],
    };
  }),
].sort((a, b) => b.datePublished.localeCompare(a.datePublished));

// The contemplative notebooks are presented in their own framed section
// below the main library rather than in the filterable grid.
const libraryItems = allItems.filter(item => !item.notebook);
const notebookItems = allItems.filter(item => item.notebook);

// ─── Featured items ───────────────────────────────────────────────────────────
const featuredIds = [
  'can-meditation-make-anxiety-or-dissociation-worse',
  'what-happens-in-a-five-session-counselling-process',
  'confidentiality-in-mentoring-for-teenage-boys',
];
const featuredItems: LibraryItem[] = featuredIds
  .map(id => allItems.find(a => a.id === id))
  .filter((x): x is LibraryItem => x !== undefined);

// ─── JSON-LD ──────────────────────────────────────────────────────────────────
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Writing | Essays & Practice Guides',
    description: 'Essays and practice guides on meditation, breathwork, psychology, and inner work. Written by Michael Kaplan (Swami Ramarishi) of Sangham.',
    publisher: { '@type': 'Organization', name: 'Sangham', url: 'https://www.sangham.org' },
  },
];
---

<BaseLayout
  title="Writing | Essays & Practice Guides"
  description="Essays and practice guides on meditation, breathwork, psychology, and inner work. Written by Michael Kaplan (Swami Ramarishi) of Sangham."
  jsonLd={jsonLd}
>

  <PageHeader
    title="Writing"
    subtitle="Essays, reflections, and practice guides."
  />

  <!-- ═══ INTRO ═══════════════════════════════════════════════════════════════ -->
  <section class="bg-background">
    <div class="container mx-auto px-6 py-12 md:py-16 max-w-3xl">
      <p class="text-muted-foreground font-body leading-relaxed text-center">
        The writing here explores the territory this work moves through: attention, the body, breath, relationship, and the mechanics of genuine change. Essays take a broader, reflective angle on psychology and contemplation. Practice guides offer focused instruction in specific skills. Use the filters below to find what is most relevant to where you are.
      </p>
      <div class="grid sm:grid-cols-3 gap-3 mt-10">
        <a href="/wisdom/can-meditation-make-anxiety-or-dissociation-worse" class="rounded-lg border border-border/50 bg-card p-4 hover:border-primary/35 transition-colors">
          <span class="block text-[11px] uppercase tracking-wider text-primary/60 font-body mb-2">Meditation feels destabilising</span>
          <span class="font-heading text-base text-foreground/85">Start with practice safety</span>
        </a>
        <a href="/wisdom/what-happens-in-a-five-session-counselling-process" class="rounded-lg border border-border/50 bg-card p-4 hover:border-primary/35 transition-colors">
          <span class="block text-[11px] uppercase tracking-wider text-primary/60 font-body mb-2">Considering counselling</span>
          <span class="font-heading text-base text-foreground/85">See how the process works</span>
        </a>
        <a href="/wisdom/how-to-find-a-mentor-for-a-young-man-in-south-africa" class="rounded-lg border border-border/50 bg-card p-4 hover:border-primary/35 transition-colors">
          <span class="block text-[11px] uppercase tracking-wider text-primary/60 font-body mb-2">Looking for mentoring</span>
          <span class="font-heading text-base text-foreground/85">Choose the right relationship</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ START HERE ══════════════════════════════════════════════════════════ -->
  <section id="featured-start-here" class="bg-header">
    <div class="container mx-auto px-6 py-16 md:py-20 max-w-5xl">

      <!-- Section label -->
      <div class="flex items-center gap-5 mb-10">
        <span class="text-[11px] font-body tracking-widest uppercase text-primary/55 shrink-0">Start Here</span>
        <div class="flex-1 border-t border-header-foreground/10"></div>
        <span class="text-[11px] font-body text-header-foreground/25 shrink-0 hidden sm:block">Three recommended entry points</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {featuredItems.map((item) => (
          <a
            href={`/wisdom/${item.id}`}
            class="group flex flex-col border border-header-foreground/10 rounded-lg p-7 hover:border-primary/30 hover:-translate-y-[2px] bg-void/50 hover:bg-cosmos/50 transition-all duration-200 ease-out"
          >
            <div class="mb-3">
              <ArticleBadge type={item.isGuide ? 'practice-guide' : 'essay'} context="header" />
            </div>
            <h3 class="font-heading text-xl text-header-foreground/90 group-hover:text-header-foreground mb-3 leading-snug transition-colors">
              {item.title}
            </h3>
            <p class="text-header-foreground/45 font-body text-sm leading-relaxed line-clamp-3 flex-1">
              {item.excerpt}
            </p>
            <div class="flex items-center gap-2 mt-6 pt-4 border-t border-header-foreground/8">
              <span class="font-body text-xs text-header-foreground/25">{item.readTime} min read</span>
              <span class="ml-auto text-primary/40 group-hover:text-primary/70 transition-colors text-base leading-none">&rarr;</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══ FILTER BAR + LIBRARY GRID ══════════════════════════════════════════ -->
  <section class="bg-background">
    <div class="container mx-auto px-6 pt-16 pb-20 md:pt-20 md:pb-28 max-w-5xl">

      <!-- Filter heading -->
      <div class="flex items-center gap-5 mb-8">
        <span class="text-[11px] font-body tracking-widest uppercase text-muted-foreground/50 shrink-0">Browse by topic</span>
        <div class="flex-1 border-t border-border/40"></div>
      </div>

      <!-- Filter chips – horizontally scrollable on mobile -->
      <div class="overflow-x-auto -mx-6 px-6 mb-10 no-scrollbar">
        <div
          role="tablist"
          aria-label="Filter writing by category"
          class="flex gap-2 min-w-max"
        >
          {filters.map((f, i) => (
            <button
              type="button"
              role="tab"
              data-category={f.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              class="filter-chip px-4 py-2 rounded-full text-xs font-body tracking-wide border whitespace-nowrap transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:ring-offset-2"
            >
              {f.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Card grid -->
      <div
        id="library-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"
      >
        {libraryItems.map((item) => (
          <a
            href={`/wisdom/${item.id}`}
            data-categories={item.cats.join(' ')}
            class="group flex flex-col border border-border/50 rounded-lg bg-card hover:border-primary/30 hover:-translate-y-[2px] transition-all duration-200 ease-out overflow-hidden"
          >
            <div class="flex flex-col flex-1 p-6">
              <div class="mb-2">
                <ArticleBadge type={item.isGuide ? 'practice-guide' : 'essay'} context="card" />
              </div>
              <h3 class="font-heading text-lg text-foreground/90 group-hover:text-foreground mb-3 leading-snug transition-colors">
                {item.title}
              </h3>
              <p class="text-muted-foreground font-body text-sm leading-relaxed line-clamp-3 flex-1">
                {item.excerpt}
              </p>
              <div class="flex items-center gap-2 mt-5 pt-4 border-t border-border/40 flex-wrap">
                {item.displayCats.slice(0, 2).map((cat) => (
                  <span class="inline-block px-2 py-0.5 text-[10px] font-body tracking-wider uppercase rounded-full border border-primary/15 text-primary/50">
                    {cardTagLabels[cat] ?? cat}
                  </span>
                ))}
                <span class="font-body text-xs text-muted-foreground/35 ml-auto">{item.readTime} min</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Empty state (shown by JS when no cards match) -->
      <p
        id="no-results"
        class="hidden text-muted-foreground/50 font-body text-sm text-center py-16 font-heading italic"
        aria-live="polite"
      >
        No articles in this category yet.
      </p>

    </div>
  </section>

  <!-- ═══ FROM THE CONTEMPLATIVE NOTEBOOKS ════════════════════════════════════ -->
  <section class="bg-background border-t border-border/30">
    <div class="container mx-auto px-6 py-16 md:py-20 max-w-5xl">

      <div class="flex items-center gap-5 mb-6">
        <span class="text-[11px] font-body tracking-widest uppercase text-muted-foreground/50 shrink-0">From the Contemplative Notebooks</span>
        <div class="flex-1 border-t border-border/40"></div>
      </div>

      <p class="text-muted-foreground/80 font-body text-sm leading-relaxed max-w-2xl mb-10">
        These pieces were written during years of traditional training and practice in India. They reflect the contemplative traditions in their own language, metaphysical claims, classical framing, and all. They sit alongside the counselling work without replacing or contradicting it; they are notes from a different mode of inquiry.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {notebookItems.map((item) => (
          <a
            href={`/wisdom/${item.id}`}
            class="group flex flex-col border border-border/40 rounded-lg bg-muted/20 hover:border-primary/25 hover:-translate-y-[2px] transition-all duration-200 ease-out p-5"
          >
            <h3 class="font-heading text-base text-foreground/80 group-hover:text-foreground mb-2 leading-snug transition-colors">
              {item.title}
            </h3>
            <p class="text-muted-foreground/80 font-body text-xs leading-relaxed line-clamp-2 flex-1">
              {item.excerpt}
            </p>
            <div class="flex items-center gap-2 mt-4 pt-3 border-t border-border/30">
              <span class="font-body text-[11px] text-muted-foreground/60">{item.dateLabel}</span>
              <span class="font-body text-[11px] text-muted-foreground/60 ml-auto">{item.readTime} min</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══ EMAIL SUBSCRIPTION ══════════════════════════════════════════════════ -->
  <section class="bg-header">
    <div class="container mx-auto px-6 py-16 md:py-20 max-w-md text-center">
      <h3 class="font-heading text-xl md:text-2xl text-header-foreground/80 mb-6">
        Receive occasional essays by email
      </h3>
      <div id="wisdom-subscribe-container">
        <form id="wisdom-subscribe-form" class="flex gap-3" data-form="newsletter">
          <input type="hidden" name="_subject" value="New essay subscriber | Sangham" />
          <AttributionFields />
          <input
            type="email"
            name="email"
            required
            placeholder="your@email.com"
            class="flex-1 bg-cosmos border border-header-foreground/10 rounded-lg px-4 py-3 text-header-foreground/90 font-body text-sm placeholder:text-header-foreground/30 focus:outline-none focus:border-primary/40 transition-colors"
          />
          <button
            type="submit"
            class="px-6 py-3 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg text-sm tracking-wider uppercase font-body whitespace-nowrap"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- ═══ CLOSING ══════════════════════════════════════════════════════════════ -->
  <section class="bg-background border-t border-border/25">
    <div class="container mx-auto px-6 py-12 md:py-16 max-w-2xl text-center">
      <p class="text-muted-foreground font-body leading-relaxed mb-8">
        If you want to explore this work more directly, begin with a free 15-minute fit call.
      </p>
      <a
        href="/contact"
        data-cta="book-fit-call"
        data-service="adult-counselling"
        data-placement="writing-index-closing"
        class="inline-block px-8 py-3 border border-primary/30 text-primary/70 hover:border-primary/60 hover:text-primary transition-all duration-300 rounded-lg text-sm tracking-wider uppercase font-body"
      >
        Book a free 15-minute fit call
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hide scrollbar on filter rail while keeping functionality */
  .no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
  .no-scrollbar::-webkit-scrollbar { display: none; }

  /* Filter chip default state */
  .filter-chip {
    color: var(--color-muted-foreground);
    opacity: 0.65;
    border-color: var(--color-border);
    background: transparent;
    cursor: pointer;
  }
  .filter-chip:not([aria-selected="true"]):hover {
    opacity: 1;
    color: var(--color-foreground);
    background-color: color-mix(in srgb, var(--color-foreground) 4%, transparent);
  }
  /* Active chip */
  .filter-chip[aria-selected="true"] {
    opacity: 1;
    color: var(--color-primary);
    border-color: color-mix(in srgb, var(--color-primary) 28%, transparent);
    background-color: color-mix(in srgb, var(--color-primary) 7%, transparent);
  }
</style>

<!-- Filter logic -->
<script>
  import { appendAttribution, pushDataLayer } from '../scripts/tracking';

  (function () {
    const featuredSection = document.getElementById('featured-start-here');
    const grid = document.getElementById('library-grid');
    const noResults = document.getElementById('no-results');
    const cards: HTMLElement[] = grid
      ? Array.from(grid.querySelectorAll<HTMLElement>('[data-categories]'))
      : [];
    const buttons: HTMLButtonElement[] = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[role="tab"][data-category]')
    );

    function activate(categoryId: string) {
      // Persist to URL (no page reload)
      const url = new URL(window.location.href);
      if (categoryId === 'all') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', categoryId);
      }
      history.replaceState(null, '', url.toString());

      // Update button aria states
      buttons.forEach(btn => {
        const active = btn.dataset.category === categoryId;
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      // Show / hide featured section (only visible on All)
      if (featuredSection) {
        featuredSection.style.display = categoryId === 'all' ? '' : 'none';
      }

      // Show / hide cards
      let visible = 0;
      cards.forEach(card => {
        const cats = (card.dataset.categories ?? '').split(' ');
        const show = categoryId === 'all' || cats.includes(categoryId);
        card.style.display = show ? '' : 'none';
        card.setAttribute('aria-hidden', show ? 'false' : 'true');
        if (show) visible++;
      });

      // Empty state
      if (noResults) noResults.classList.toggle('hidden', visible > 0);
    }

    // Click handlers
    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        activate(btn.dataset.category ?? 'all');
      });

      // Keyboard: arrow navigation within tablist
      btn.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          buttons[(i + 1) % buttons.length].focus();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          buttons[(i - 1 + buttons.length) % buttons.length].focus();
        } else if (e.key === 'Home') {
          e.preventDefault();
          buttons[0].focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          buttons[buttons.length - 1].focus();
        }
      });
    });

    // Initialise from URL on page load
    const initial = new URLSearchParams(window.location.search).get('category') ?? 'all';
    activate(initial);

    // Scroll active chip into view (helpful on mobile)
    const activeBtn = buttons.find(b => b.dataset.category === initial);
    if (activeBtn) {
      activeBtn.scrollIntoView({ inline: 'center', behavior: 'instant', block: 'nearest' });
    }
  })();
</script>

<!-- Email subscription -->
<script>
  function setupSubscribeForm(formId: string, containerId: string) {
    const form = document.getElementById(formId) as HTMLFormElement;
    const container = document.getElementById(containerId)!;
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = appendAttribution(new FormData(form));

      try {
        const response = await fetch('https://formspree.io/f/mojpzywj', {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          pushDataLayer('newsletter_subscription_success', { form_placement: 'writing-index' });
          container.innerHTML = `<p class="font-body text-sm text-header-foreground/60">You're subscribed. Thank you.</p>`;
        } else {
          throw new Error(`formspree_${response.status}`);
        }
      } catch (error) {
        pushDataLayer('newsletter_subscription_failure', {
          form_placement: 'writing-index',
          error_type: error instanceof Error ? error.message : 'unknown',
        });
        container.innerHTML = `<p class="font-body text-sm text-header-foreground/60">Something went wrong. Please try again or email <a href="mailto:ramarishi@sangham.org" class="text-primary/70 hover:text-primary transition-colors">ramarishi@sangham.org</a>.</p>`;
      }
    });
  }

  setupSubscribeForm('wisdom-subscribe-form', 'wisdom-subscribe-container');
</script>
