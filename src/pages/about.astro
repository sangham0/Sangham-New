---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Image } from 'astro:assets';
import michaelPortrait from '../assets/michael-portrait-new.jpg';
import goldenSavanna from '../assets/golden-savanna.jpg';
import ancientTree from '../assets/ancient-tree.jpg';
import mountainLake from '../assets/mountain-lake.jpg';
import desertStars from '../assets/desert-stars.jpg';
import bernardAltmanPortrait from '../assets/bernard-altman-portrait.jpg';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About Sangham',
    url: 'https://www.sangham.org/about',
    description: 'The story and philosophy behind Sangham\'s approach to counselling and inner work.',
    mainEntity: {
      '@type': 'Person',
      name: 'Michael Kaplan',
      alternateName: 'Swami Ramarishi',
      jobTitle: 'Wellness Counsellor',
      url: 'https://www.sangham.org/about',
      image: {
        '@type': 'ImageObject',
        url: 'https://www.sangham.org/images/michael-kaplan.jpg',
      },
      worksFor: {
        '@type': 'Organization',
        name: 'Sangham',
        url: 'https://www.sangham.org',
      },
      affiliation: {
        '@type': 'Organization',
        name: 'Association for Supportive Counsellors and Holistic Practitioners',
        alternateName: 'ASCHP',
      },
      hasCredential: {
        '@type': 'EducationalOccupationalCredential',
        name: 'Registered Wellness Counsellor',
        credentialCategory: 'Professional Registration',
        recognizedBy: {
          '@type': 'Organization',
          name: 'Association for Supportive Counsellors and Holistic Practitioners',
          alternateName: 'ASCHP',
        },
        identifier: 'Reg. No. 10559',
      },
      knowsAbout: [
        'Wellness Counselling',
        'Breathwork',
        'Meditation',
        'Hatha Yoga',
        'Pranayama',
        'Inner Work',
        'Contemplative Practice',
        'Attention Training',
      ],
      sameAs: ['https://instagram.com/sangham.space'],
    },
  },
];

const basedOnCards = [
  {
    title: 'Psychological understanding',
    text: 'Working directly with patterns of thought, emotion, behaviour, and relationship. This is not academic psychology applied from a distance. It is a grounded, relational practice of seeing how someone actually functions and helping them shift what is not serving them. It draws on counselling methodology, process work, and the practical intelligence that comes from sitting with hundreds of people and learning to recognise the patterns beneath the surface.',
  },
  {
    title: 'Contemplative practice',
    text: 'Meditation, breathwork, pranayama, hatha yoga, and related methods used to stabilise attention, regulate the nervous system, and deepen awareness. These are not taught as lifestyle activities or relaxation techniques. They are precise interventions that, when properly applied, can fundamentally alter how a person perceives and responds to experience. The key is that they must be contextualised, adjusted to the individual, and integrated into real life.',
  },
  {
    title: 'Lived experience and observation',
    text: 'Understanding what actually holds up under pressure, what translates from the cushion or the consulting room into the complexity of daily life. This is perhaps the most undervalued dimension of inner work. Theory is abundant. Practical wisdom, developed through years of sustained practice, teaching, and honest self-observation, is rare. Sangham prioritises what works, tested through experience and refined through relationship.',
  },
];

const guideCards = [
  {
    number: '01',
    title: 'Background and Guidance',
    paragraphs: [
      `Sangham is guided by Michael Kaplan (Swami Ramarishi), a registered Wellness Counsellor working with individuals online across South Africa and internationally.`,
      `Michael has been working with people in counselling, mentorship, and developmental contexts for more than twelve years. Much of that work has been carried out under the long-standing mentorship of clinical and forensic psychologist Bernard Altman, who has supervised and supported his development across the full arc of this career.`,
      `The name Swami Ramarishi was given within a traditional contemplative context. The work here, however, remains grounded in ordinary human life. Sangham is not built around a persona or a spiritual identity, but around lived experience, professional responsibility, and honest relationship.`,
    ],
  },
  {
    number: '02',
    title: 'Counselling Foundation',
    paragraphs: [
      `Michael is registered with the ASCHP as a Wellness Counsellor. The core of the work at Sangham is one-on-one counselling: structured, relational, and practical.`,
      `His counselling approach has been shaped over many years of direct client work and sustained training under Bernard Altman, with whom he has worked closely across adolescent developmental work, group process, and the deeper psychological dimensions of one-on-one practice.`,
      `The emphasis is on careful listening, honest reflection, appropriate challenge, and the gradual development of greater self-awareness and responsibility in clients' actual lives.`,
    ],
  },
  {
    number: '03',
    title: 'Experience Across Contexts',
    paragraphs: [
      `Over the years, Michael has worked with a wide range of people: adolescents navigating identity and emotional difficulty, young adults working through direction and responsibility, and adults moving through anxiety, relational patterns, loss, and life transition.`,
      `This has included sustained one-on-one counselling, mentorship relationships carried over long periods, and group facilitation across South Africa, India, and Europe.`,
      `What has emerged from this range of work is a clearer sense of what actually helps people change, and what tends to leave them more capable of standing within their own lives rather than dependent on a method or a guide.`,
    ],
  },
  {
    number: '04',
    title: 'Contemplative Training',
    paragraphs: [
      `Alongside this counselling work, Michael's background includes intensive training in pranayama, hatha yoga, meditation, and related contemplative practices within established traditions, with significant periods of practice in the Indian Himalayas under experienced teachers.`,
      `These practices inform how he works, particularly around attention, nervous system regulation, embodied awareness, and the integration of insight into daily life. Where appropriate, they may be introduced carefully and practically within client work.`,
      `They are not treated as ideology or required belief. They are tools, used selectively and only where genuinely useful for the individual.`,
    ],
  },
  {
    number: '05',
    title: 'How the Work Is Held',
    paragraphs: [
      `Over time, it became clear that technique alone is never sufficient. What matters most is how practice is held, how it is integrated into daily life, and how it is supported through honest relationship. The same approach that helps one person can quietly reinforce the patterns another person is trying to dissolve.`,
      `Precision in application matters more than breadth of method. Guidance is offered not as a set of answers to adopt, but as a way of helping people see their situation more clearly and begin responding differently within it.`,
      `The work is held within a clear, boundaried, and respectful framework. It is not a substitute for psychiatric care, crisis intervention, addiction treatment, or specialist clinical services where those are required. Where appropriate, referrals or collaborative support may be recommended.`,
    ],
  },
];
---

<style>
  .sg-swiper {
    overflow: hidden;
    width: 100%;
  }

  .sg-swiper .swiper-wrapper {
    align-items: stretch;
  }

  .sg-swiper .swiper-slide {
    height: auto;
    box-sizing: border-box;
  }

  .sg-swiper .sg-slide {
    height: 100%;
    box-sizing: border-box;
  }

  .sg-nav-btn.swiper-button-disabled {
    opacity: 0.15 !important;
    cursor: not-allowed;
    pointer-events: none;
  }

  .sg-pag {
    padding: 16px 0;
  }

  .sg-pag .swiper-pagination-bullet {
    position: relative;
    width: 24px !important;
    height: 24px !important;
    margin: 0 5px !important;
    background: transparent !important;
    border-radius: 0 !important;
    opacity: 1 !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .sg-pag .swiper-pagination-bullet::after {
    content: '';
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 9999px;
    background: rgba(90, 78, 62, 0.35);
    transition: width 0.22s ease, height 0.22s ease, background 0.22s ease;
  }

  .sg-pag .swiper-pagination-bullet:hover::after {
    background: rgba(90, 78, 62, 0.55);
  }

  .sg-pag .swiper-pagination-bullet-active::after {
    width: 18px;
    height: 14px;
    border-radius: 7px;
    background: #b48c50;
  }

  @media (max-width: 767px) {
    .sg-pag .swiper-pagination-bullet {
      width: 28px !important;
      height: 28px !important;
      margin: 0 6px !important;
    }

    .sg-pag .swiper-pagination-bullet::after {
      width: 16px;
      height: 16px;
    }

    .sg-pag .swiper-pagination-bullet-active::after {
      width: 20px;
      height: 16px;
      border-radius: 8px;
    }
  }
</style>

<BaseLayout
  title="About | Michael Kaplan (Swami Ramarishi)"
  description="Sangham is guided by Michael Kaplan (Swami Ramarishi), a registered Wellness Counsellor with years of contemplative practice and one-on-one client work."
  jsonLd={jsonLd}
>

  <PageHeader
    title="About Sangham"
    subtitle="A grounded approach to inner work, built on lived experience and practical application."
  />

  <!-- OPENING -->
  <section class="bg-background">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-3xl">
      <div class="space-y-6 text-muted-foreground font-body leading-relaxed">
        <p class="text-lg text-foreground/90">
          Sangham is a structured way of working with attention, behaviour, and experience.
        </p>
        <p>
          The aim is simple but uncommon. Not more ideas. Not more concepts. Not more spiritual vocabulary. Clearer understanding, and the practical ability to respond differently in the situations that matter most.
        </p>
        <p>
          In practice, this means one-on-one counselling and structured reflective process, conducted online. Breathwork, meditation, and body-based practices support and inform that work. But the core offering is relational, grounded, and practical, not primarily spiritual or technique-driven.
        </p>
      </div>
    </div>
  </section>

  <!-- THE MEANING OF SANGHAM -->
  <section class="bg-header text-header-foreground">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-3xl">
      <h2 class="font-heading text-3xl md:text-4xl text-gold-gradient text-center mb-12">
        The Meaning of Sangham
      </h2>

      <div class="space-y-6 text-header-foreground/65 font-body leading-relaxed">
        <p class="text-header-foreground/80">
          The word Sangham comes from Sanskrit and refers to the coming together of many streams.
        </p>
        <p>
          In this context, it reflects the integration of different ways of working: psychological understanding, contemplative practice, and lived experience, brought together into a single, coherent approach. Rather than treating these as separate paths, the emphasis is on how they meet, inform one another, and become practical within the reality of a person's life.
        </p>
        <p>
          This is not a philosophical claim or a spiritual branding exercise. It is a description of how the work actually operates. The name reflects the method: integration, not fragmentation. Wholeness, not specialisation.
        </p>
      </div>
    </div>
  </section>

  <!-- WHAT THIS WORK IS BASED ON -->
  <section class="bg-background">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-3xl">
      <h2 class="font-heading text-3xl md:text-4xl text-foreground text-center mb-12">
        What This Work Is Based On
      </h2>

      <p class="text-muted-foreground font-body leading-relaxed mb-10">
        The Sangham approach draws from three main areas, each informing the others. Together they create something that is more than the sum of its parts.
      </p>

      <div class="space-y-8">
        {basedOnCards.map((item) => (
          <div class="border border-border rounded-lg p-8">
            <h3 class="font-heading text-xl text-foreground mb-4">{item.title}</h3>
            <p class="text-muted-foreground font-body text-sm leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>

      <p class="text-muted-foreground font-body leading-relaxed mt-10">
        These are not treated as separate domains. They are woven into a single, practical approach where each element supports and informs the others. The result is something that feels both more complete and more precise than what any one tradition can offer alone.
      </p>
    </div>
  </section>

  <!-- HOW SANGHAM IS POSITIONED -->
  <section class="relative overflow-hidden">
    <Image
      src={goldenSavanna}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      widths={[640, 1024, 1536]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-void/72"></div>
    <div class="relative z-10 container mx-auto px-6 py-20 md:py-28 max-w-3xl">
      <h2 class="font-heading text-3xl md:text-4xl text-gold-gradient text-center mb-10">
        How Sangham Is Positioned
      </h2>

      <div class="space-y-6 text-header-foreground/65 font-body leading-relaxed">
        <p>
          Sangham is not a belief system. It is not a philosophy to adopt. It is not a spiritual brand. It is a way of working.
        </p>
        <p>
          What matters is not what someone agrees with, but what actually changes how they function. The emphasis is always on clarity, application, and integration into real life. There is no expectation to adopt a worldview, commit to a path, or identify with a tradition. The invitation is to look honestly at how things are functioning and to engage with what might help them function better.
        </p>
        <p>
          It is designed for people who want something that is simultaneously deeper and more practical than what they have found elsewhere.
        </p>
      </div>
    </div>
  </section>

  <!-- QUOTE DIVIDER -->
  <section class="relative overflow-hidden border-t border-white/8">
    <Image
      src={ancientTree}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      widths={[640, 1024, 1536]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-void/65"></div>
    <div class="relative z-10 container mx-auto px-6 py-24 md:py-28 max-w-3xl">
      <blockquote class="border-l-2 border-primary/40 pl-8">
        <p class="font-heading text-xl md:text-2xl text-parchment/75 italic leading-relaxed">
          Depth without dogma. Discipline without rigidity. Insight without spectacle.
        </p>
      </blockquote>
    </div>
  </section>

  <!-- ABOUT THE GUIDE -->
  <section class="bg-background">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-3xl">
      <h2 class="font-heading text-3xl md:text-4xl text-foreground text-center mb-4">
        About the Guide
      </h2>

      <div class="flex justify-center my-10">
        <div class="w-44 h-44 md:w-52 md:h-52 rounded-full overflow-hidden border-2 border-primary/20">
          <Image
            src={michaelPortrait}
            alt="Michael Kaplan (Swami Ramarishi)"
            class="w-full h-full object-cover object-top"
            width={208}
            height={208}
          />
        </div>
      </div>

      <p class="text-center text-muted-foreground/60 font-body text-sm tracking-widest uppercase mb-3">
        Michael Kaplan (Swami Ramarishi)
      </p>
      <p class="text-center text-muted-foreground/60 font-body text-xs tracking-wide mb-10">
        BA Psychology &middot; ASCHP Registered Wellness Counsellor (Reg. 10559) &middot; Certified Yoga Teacher (RYS 300)
      </p>

      <div class="mb-4">
        <div class="swiper sg-swiper" id="sw-guide">
          <div class="swiper-wrapper">
            {guideCards.map((card, i) => (
              <div class="swiper-slide">
                <div class="sg-slide border border-border/35 rounded-xl p-8 md:p-12 bg-muted/10 flex flex-col">
                  <div class="mb-5">
                    <p class="font-heading text-[32px] md:text-[40px] leading-none text-primary/65 mb-1 tabular-nums">
                      {card.number}
                    </p>
                    <p class="text-[11px] md:text-[12px] font-body tracking-[0.18em] uppercase text-primary/55">
                      {i + 1} of {guideCards.length}
                    </p>
                  </div>
                  <h3 class="font-heading text-xl md:text-2xl lg:text-[26px] text-foreground/85 leading-snug mb-5">
                    {card.title}
                  </h3>
                  <div class="space-y-4 flex-1">
                    {card.paragraphs.map((paragraph) => (
                      <p class="font-body text-[17px] md:text-lg text-muted-foreground/70 leading-relaxed">
                        {paragraph}
                      </p>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="flex items-center gap-3 mt-6">
          <button id="sw-guide-prev" class="sg-nav-btn w-10 h-10 rounded-full border border-border/50 flex items-center justify-center text-muted-foreground/55 hover:text-foreground/75 hover:border-border transition-all" aria-label="Previous guide card">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 19l-7-7 7-7" /></svg>
          </button>
          <div id="sw-guide-pag" class="flex-1 flex justify-center sg-pag"></div>
          <button id="sw-guide-next" class="sg-nav-btn w-10 h-10 rounded-full border border-border/50 flex items-center justify-center text-muted-foreground/55 hover:text-foreground/75 hover:border-border transition-all" aria-label="Next guide card">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" /></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- APPROACH AND ETHOS -->
  <section class="relative overflow-hidden">
    <Image
      src={mountainLake}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      widths={[640, 1024, 1536]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-void/78"></div>
    <div class="relative z-10 container mx-auto px-6 py-24 md:py-32 max-w-3xl">
      <h2 class="font-heading text-3xl md:text-4xl text-gold-gradient text-center mb-12">
        Approach and Ethos
      </h2>

      <div class="space-y-6 text-parchment/65 font-body leading-relaxed">
        <p>
          The work is held within a clear, boundaried, and respectful framework. The intention is not to create dependence or to establish authority, but to support clarity, stability, and a more grounded ability to respond to experience. Whatever shifts through this process is meant to return people more fully to their own lives, not draw them away from them.
        </p>
        <p>
          There is no expectation to adopt beliefs or identities. Only a willingness to engage honestly. The strongest work often happens with people who arrive with healthy scepticism. Questions are not just welcome. They are essential.
        </p>
      </div>
    </div>
  </section>

  <!-- A NOTE ON DIRECTION -->
  <section class="bg-background">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-3xl">
      <h2 class="font-heading text-3xl md:text-4xl text-foreground text-center mb-10">
        A Note on Direction
      </h2>

      <div class="space-y-6 text-muted-foreground font-body leading-relaxed">
        <p>
          Sangham has evolved considerably over time. What began as a broader offering of classes, group work, and community gatherings has gradually refined into something more focused and more effective.
        </p>
        <p>
          The centre of the work is now counselling and integrative one-on-one process, supported by practices and occasional group offerings. This shift reflects a growing clarity about where the deepest and most lasting change happens: in the specificity of individual relationship, not in the generality of group instruction.
        </p>
        <p>
          Sangham exists as an extension of this orientation: a space where practice is taken seriously, questions are welcomed, and the work is allowed to mature at a human pace.
        </p>
        <p>
          Sangham currently operates as a fully online practice. Sessions are conducted via video call, which has made it possible to work with people across South Africa and internationally. In practice, this format tends to suit the kind of relational, reflective work offered here well. The quality of attention that matters most is not diminished by the absence of a shared physical space.
        </p>
      </div>
    </div>
  </section>

  <!-- PROFESSIONAL ENDORSEMENT -->
  <section class="bg-background">
    <div class="container mx-auto px-6 py-16 md:py-20 max-w-3xl">
      <p class="text-[10px] font-body tracking-[0.14em] uppercase text-muted-foreground/50 mb-8 text-center">Professional Reference</p>
      <figure class="border border-border/20 bg-header/5 rounded-xl overflow-hidden">
        <div class="flex flex-col md:flex-row-reverse">
          <div class="md:w-[28%] shrink-0 bg-[#1a2a1a]">
            <div class="flex items-center justify-center md:h-full p-4 md:p-0">
              <Image
                src={bernardAltmanPortrait}
                alt="Bernard Altman"
                class="w-full h-auto object-contain rounded-lg md:rounded-none"
                widths={[316, 500]}
                sizes="(min-width: 768px) 28vw, 100vw"
                loading="lazy"
              />
            </div>
          </div>
          <div class="p-7 md:p-10 flex flex-col flex-1">
            <blockquote class="flex-1 mb-5 space-y-4">
              <p class="font-heading text-lg md:text-xl text-foreground/75 italic leading-relaxed">I have known Michael for many years through his involvement with Boys to Men, first as a participant in the work and later in leadership and facilitation roles. Over time, I have watched him develop into a capable, thoughtful, and committed facilitator with a genuine ability to work with people in a grounded and sincere way.</p>
              <p class="font-heading text-lg md:text-xl text-foreground/65 italic leading-relaxed">He brings presence, emotional intelligence, maturity, and a strong capacity to engage honestly with difficult human experiences. I have consistently found him to approach this work with integrity, responsibility, and real care for the people he works with.</p>
            </blockquote>
            <figcaption>
              <p class="font-body text-sm text-muted-foreground/60">Bernard Altman &middot; Clinical Psychologist &middot; Founder of Boys to Men</p>
            </figcaption>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- QUOTE DIVIDER -->
  <section class="relative overflow-hidden">
    <Image
      src={desertStars}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      widths={[640, 1024, 1536]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-void/55"></div>
    <div class="relative z-10 container mx-auto px-6 py-24 md:py-28 max-w-3xl">
      <blockquote class="border-l-2 border-primary/40 pl-8">
        <p class="font-heading text-xl md:text-2xl text-parchment/75 italic leading-relaxed">
          The quieter the mind becomes, the more it can hear.
        </p>
      </blockquote>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="bg-header">
    <div class="container mx-auto px-6 py-24 md:py-32 max-w-2xl text-center">
      <p class="font-heading text-2xl md:text-3xl text-header-foreground/70 mb-4">
        This is not about becoming someone else.
      </p>
      <p class="font-heading text-2xl md:text-3xl text-gold-gradient mb-10">
        It is about becoming more capable as you are.
      </p>

      <div class="mt-8">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-10 py-4 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg text-sm tracking-wider uppercase font-body"
        >
          Enquire About Working Together
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </section>

  <script>
    import Swiper from 'swiper';
    import { Navigation, Pagination, A11y, Keyboard } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/navigation';
    import 'swiper/css/pagination';
    import 'swiper/css/a11y';

    new Swiper('#sw-guide', {
      modules: [Navigation, Pagination, A11y, Keyboard],
      slidesPerView: 1,
      loop: false,
      autoplay: false,
      keyboard: { enabled: true },
      a11y: { enabled: true },
      navigation: {
        prevEl: '#sw-guide-prev',
        nextEl: '#sw-guide-next',
      },
      pagination: {
        el: '#sw-guide-pag',
        clickable: true,
      },
    });
  </script>

</BaseLayout>
