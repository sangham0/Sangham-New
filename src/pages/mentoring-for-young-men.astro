  <script>
    import Swiper from 'swiper';
    import { Navigation, Pagination, A11y, Keyboard } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/navigation';
    import 'swiper/css/pagination';
    import 'swiper/css/a11y';

    function makeSw(
      id: string,
      prevId: string,
      nextId: string,
      pagId: string
    ) {
      return new Swiper('#' + id, {
        modules: [Navigation, Pagination, A11y, Keyboard],
        slidesPerView: 1,
        loop: false,
        autoplay: false,
        keyboard: { enabled: true },
        a11y: { enabled: true },
        navigation: {
          prevEl: '#' + prevId,
          nextEl: '#' + nextId,
        },
        pagination: {
          el: '#' + pagId,
          clickable: true,
        },
      });
    }

    makeSw('sw-patterns',     'sw-patterns-prev',     'sw-patterns-next',     'sw-patterns-pag');
    makeSw('sw-dev',          'sw-dev-prev',          'sw-dev-next',          'sw-dev-pag');
    makeSw('sw-process',      'sw-process-prev',      'sw-process-next',      'sw-process-pag');
    makeSw('sw-michael',      'sw-michael-prev',      'sw-michael-next',      'sw-michael-pag');
    makeSw('sw-testimonials', 'sw-testimonials-prev', 'sw-testimonials-next', 'sw-testimonials-pag');
  </script>

