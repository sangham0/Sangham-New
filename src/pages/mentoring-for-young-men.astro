---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import michaelPortrait from '../assets/michael-portrait-new.jpg';
import michaelPortrait2 from '../assets/Michael-portrait-2.PNG';
import jacobSPortrait from '../assets/jacob-s-portrait.jpg';
import antonySPortrait from '../assets/antony-s-portrait.jpg';
import documentaryMountain from '../assets/documentary-mountain.jpg';
import himalayaForestSunset from '../assets/himalaya-forest-sunset.jpg';
import himalayaEditA from '../assets/himalaya-edit-a.jpg';

const canonicalURL = 'https://www.sangham.org/mentoring-for-young-men';

const faqItems = [
  {
    q: 'Is this therapy?',
    a: 'No. This work is better understood as developmental mentorship combined with reflective counselling. Emotional reflection, self-awareness, and psychological insight are part of the process, but the work is not positioned as formal psychotherapy or clinical treatment. The focus is developmental and relational. Building greater emotional grounding, self-awareness, direction, and internal stability over time.',
  },
  {
    q: 'What if I’m not sure this is for me?',
    a: 'That’s what the free 15-minute call is for. It’s a low-stakes conversation to see whether the approach, the timing, and the fit make sense. If it doesn’t, I will say so directly. There is no pressure to continue.',
  },
  {
    q: 'Do I need to be interested in meditation or spirituality?',
    a: 'No. The work is grounded, practical, and psychologically oriented. Where contemplative practices are introduced, they are used as practical tools for attention, regulation, and self-observation rather than as spiritual belief. Many sessions involve none of this directly.',
  },
  {
    q: 'What kinds of things do people usually bring into this work?',
    a: 'Common themes include lack of direction, emotional shutdown, difficulty sustaining attention or discipline, anxiety beneath outward competence, relationship difficulties, identity confusion, masculinity, isolation, compulsive distraction, and the broader question of who you actually want to become.',
  },
  {
    q: 'How long does the process usually last?',
    a: 'There is no fixed timeline. Some people benefit from shorter periods of focused work; others benefit from longer-term mentorship as things gradually stabilise. The work is developmental rather than crisis-oriented. Meaningful change tends to develop gradually rather than instantly.',
  },
  {
    q: 'What does it cost?',
    a: 'The initial 15-minute call is free. Beyond that, individual sessions are R850 (approximately $50 USD) per 60-minute session, with reduced rates available in limited cases where the standard rate is genuinely prohibitive. This can be discussed on the call.',
  },
  {
    q: 'Is this a replacement for psychiatric or specialist psychological care?',
    a: 'No. This work supports developmental and relational growth. Acute psychiatric intervention, crisis management, addiction treatment, and specialist clinical care belong with appropriately licensed professionals. If that is what is needed, I will say so and refer to someone appropriate.',
  },
  {
    q: 'How do sessions actually happen?',
    a: 'Sessions are usually held online via video. Approximately 60 minutes per session. Frequency is typically weekly or fortnightly depending on what is useful. The work is conversational and relational, not lecture-based or curriculum-based.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Mentoring and Counselling for Young Men',
    url: canonicalURL,
    description:
      'Developmental mentorship and reflective counselling for young men aged 18-25. ASCHP-registered wellness counselling. Online sessions worldwide.',
    serviceType: 'Wellness Counselling and Developmental Mentorship',
    provider: {
      '@type': 'Person',
      name: 'Michael Kaplan',
      jobTitle: 'ASCHP Registered Wellness Counsellor',
      url: 'https://www.sangham.org/about',
      affiliation: {
        '@type': 'Organization',
        name: 'Association for Supportive Counsellors and Holistic Practitioners',
        alternateName: 'ASCHP',
        identifier: 'Reg. No. 10559',
      },
    },
    audience: [
      { '@type': 'Audience', audienceType: 'Young Adult' },
    ],
    areaServed: [
      { '@type': 'Country', name: 'South Africa' },
      { '@type': 'Place', name: 'Worldwide' },
    ],
    availableChannel: {
      '@type': 'ServiceChannel',
      serviceType: 'Online via video call',
      availableLanguage: 'English',
    },
    offers: [
      {
        '@type': 'Offer',
        name: 'Free 15-Minute Fit Call',
        price: '0',
        priceCurrency: 'ZAR',
        availability: 'https://schema.org/InStock',
        description: '15-minute online call to discuss fit.',
      },
      {
        '@type': 'Offer',
        name: 'Individual Mentorship Session',
        price: '850',
        priceCurrency: 'ZAR',
        availability: 'https://schema.org/InStock',
        description: '60-minute individual mentorship and reflective counselling session.',
      },
    ],
  },
];
---

<style is:global>
  /* FAQ accordion animation */
  details > .faq-body { animation: faqOpen 0.18s ease; }
  @keyframes faqOpen {
    from { opacity: 0; transform: translateY(-3px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Cal.com inline embed */
  #cal-fit-embed {
    width: 100%;
    min-height: 700px;
  }
  @media (min-width: 768px) {
    #cal-fit-embed {
      min-height: 650px;
    }
  }
  #cal-fit-embed iframe {
    display: block;
    width: 100%;
    border: 0;
  }

  /* Page-scoped design tokens */
  .ym-page {
    --color-void: hsl(220 28% 9%);
    --color-header: hsl(218 24% 14%);
    --color-parchment: hsl(36 18% 92%);
    --color-header-foreground: hsl(36 18% 92%);
    --color-primary: #D4A95C;
    --color-primary-foreground: #0F1422;
    --color-gold: #D4A95C;
    --color-gold-light: #E6BE76;
    --color-gold-dark: #B88A3C;
  }

  .ym-page .text-gold-gradient {
    background: linear-gradient(135deg, #DBAE5E, #D4A95C, #B88A3C);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
</style>

<BaseLayout
  title="Mentoring for Young Men | Sangham"
  description="A grounded space to meet yourself honestly. Reflective counselling and developmental mentorship for men aged 18 to 25. ASCHP registered. Online worldwide."
  canonicalURL={canonicalURL}
  image="/images/og-default.jpg"
  jsonLd={[...jsonLd, faqJsonLd]}
  minimalNav={true}
  hideStickyBar={true}
>
<div class="ym-page">

  <!-- ═══════════════════════════════════════════════════════════════════
       01 · HERO — Type A: Deep navy
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="bg-void -mt-[72px] pt-[72px]">
    <div class="container mx-auto px-6 py-20 md:py-28 lg:py-36 max-w-5xl">
      <div class="grid md:grid-cols-[1fr_auto] gap-12 lg:gap-16 items-start">

        <div class="md:order-1">
          <p class="text-parchment/40 text-xs tracking-[0.2em] uppercase font-body mb-8">
            Sangham &middot; Mentoring for Young Men &middot; Online Worldwide
          </p>

          <h1 class="font-heading text-[38px] sm:text-5xl md:text-6xl lg:text-[72px] text-gold-gradient leading-[1.08] mb-10">
            <span class="block">Most young men are not weak.</span>
            <span class="block mt-2">They are exhausted from being divided against themselves.</span>
          </h1>

          <p class="font-body text-lg md:text-xl text-parchment/70 leading-relaxed mb-10 max-w-2xl">
            A grounded space to meet yourself honestly, and to begin building a life that actually feels like yours. Reflective counselling and developmental mentorship for men aged 18 to 25.
          </p>

          <a
            href="#book-call"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg text-sm tracking-wider uppercase font-body font-medium shadow-lg shadow-primary/15 mb-6"
          >
            Book a Free 15-Minute Call
          </a>

          <p class="text-parchment/35 text-xs font-body tracking-wide">
            Online worldwide &nbsp;&middot;&nbsp; Based in South Africa &nbsp;&middot;&nbsp; ASCHP Registered &nbsp;&middot;&nbsp; Not a replacement for psychiatric care
          </p>
        </div>

        <div class="md:order-2 flex justify-center md:justify-end">
          <div class="w-full max-w-[180px] md:max-w-[200px] lg:max-w-[220px]">
            <div class="rounded-xl overflow-hidden border border-parchment/8">
              <div class="aspect-[4/5] overflow-hidden">
                <Image
                  src={michaelPortrait}
                  alt="Michael Kaplan, ASCHP Registered Wellness Counsellor"
                  class="w-full h-full object-cover object-center"
                  widths={[400, 500, 550]}
                  sizes="(min-width: 1024px) 220px, (min-width: 768px) 200px, 180px"
                  width={1254}
                  height={1254}
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       CREDIBILITY STRIP — Slightly lighter navy
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="bg-header text-header-foreground">
    <div class="container mx-auto px-6 py-14 md:py-18 max-w-5xl">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 sm:gap-0 text-center sm:text-left sm:divide-x sm:divide-parchment/10">
        <div class="sm:pr-10 xl:pr-16">
          <p class="font-heading text-4xl md:text-5xl text-gold-gradient mb-2 leading-none">10+</p>
          <p class="font-body text-sm md:text-[15px] text-parchment/55 leading-relaxed">years working directly with adolescent and young adult men</p>
        </div>
        <div class="sm:px-10 xl:px-16">
          <p class="font-heading text-4xl md:text-5xl text-gold-gradient mb-2 leading-none">Hundreds</p>
          <p class="font-body text-sm md:text-[15px] text-parchment/55 leading-relaxed">of one-on-one and group sessions facilitated across Cape Town and online</p>
        </div>
        <div class="sm:pl-10 xl:pl-16">
          <p class="font-heading text-4xl md:text-5xl text-gold-gradient mb-2 leading-none tracking-tight">Trained&nbsp;under</p>
          <p class="font-body text-sm md:text-[15px] text-parchment/55 leading-relaxed">a clinical and forensic psychologist in adolescent developmental work</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       02 · THE SHAPE OF IT — Type A: Deep navy
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="bg-void">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-3xl">

      <h2 class="font-heading text-3xl md:text-4xl lg:text-[42px] text-gold-gradient leading-tight mb-14">
        Something most young men recognise but rarely name
      </h2>

      <div class="font-body text-lg md:text-xl text-parchment/68 leading-relaxed space-y-8">
        <p>You can be surrounded by people and feel completely unreachable.</p>

        <p>You can be doing well on paper and feel like you're slowly losing contact with yourself underneath it.</p>

        <p>You can scroll for an hour looking for something you couldn't name even if someone asked you directly.</p>

        <p>You can know exactly what you should be doing, and still not do it. Not out of laziness, but because some part of you has gone quiet, and the rest is running on fumes.</p>

        <p class="pt-4">This is not weakness, and it is not failure. It is the predictable cost of trying to build a life inside a culture that offers constant stimulation, fractured messages about who to become, comparison without context, and almost no honest spaces in which to actually think.</p>

        <p>Most of the men I work with arrived not because something dramatic happened, but because something quiet had been going on for a long time. A sense of being slightly out of step with their own life. Performing a version of themselves they didn't quite believe in. Carrying questions they couldn't bring anywhere.</p>

        <p class="text-parchment/80 pt-4">The work begins by taking that seriously.</p>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       TRANSITION 1 — Type C: Full-bleed photographic break
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden">
    <Image
      src={documentaryMountain}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-center"
      widths={[640, 1024, 1536]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-[#070B14]/68"></div>
    <div class="relative z-10 container mx-auto px-6 py-32 md:py-44 max-w-4xl text-center">
      <p class="font-heading text-2xl sm:text-3xl md:text-4xl text-parchment/85 italic leading-relaxed">
        The obstacle is real. So is the way through.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       03 · WHAT THIS WORK IS — Type B: Slightly lighter navy
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="bg-header">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-3xl">

      <h2 class="font-heading text-3xl md:text-4xl lg:text-[42px] text-gold-gradient leading-tight mb-14">
        What this is, and what it isn't
      </h2>

      <div class="font-body text-lg md:text-xl text-parchment/68 leading-relaxed space-y-8">
        <p>This is not motivational coaching. It is not alpha-male content with a softer accent. It is not therapy in the clinical sense, and it is not the kind of mentorship that hands you a system of rules and tells you to comply.</p>

        <p>It is a sustained, one-on-one relationship with someone whose job is to help you see yourself clearly and act from what you find.</p>

        <p>The work draws on several things.</p>

        <p><strong class="text-parchment/85">Reflective counselling.</strong> The slow, careful tracking of how you actually think, what you actually feel, and what patterns you keep returning to without noticing. This is grounded in formal training and registration as a Wellness Counsellor with the ASCHP.</p>

        <p><strong class="text-parchment/85">Developmental mentorship.</strong> Direct conversation about who you are becoming, what you are avoiding, what you are protecting, and what kind of man you actually want to be when no one is watching. This is shaped by years of facilitation work with young men, including group process work, conflict, and the kind of honest reflection that rarely happens elsewhere.</p>

        <p><strong class="text-parchment/85">Embodied and contemplative practice.</strong> Practical tools drawn from years of training in Indian contemplative traditions, used selectively, where useful. Breath, attention, nervous system regulation, the disciplines that make it possible to actually be present in your own life rather than constantly leaving it.</p>

        <p class="pt-4">Underneath all of this is something older than any technique: the recognition that men have always needed other men to become themselves, and that almost no one has that now.</p>

        <p class="text-parchment/55 pt-2">As the old expression goes:</p>
        <p class="font-heading text-2xl md:text-3xl italic text-gold-gradient leading-snug pt-2 pb-4">&ldquo;Iron sharpens iron.&rdquo;</p>

        <p>The work happens in conversation. It moves at the pace trust allows. Nothing is forced. Nothing is performed. Over time, the result is not a new personality but a more honest relationship with the one you already have.</p>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       04 · WHAT WE WORK WITH — Type A: Deep navy
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="bg-void">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-3xl">

      <h2 class="font-heading text-3xl md:text-4xl lg:text-[42px] text-gold-gradient leading-tight mb-10">
        What this work often meets
      </h2>

      <p class="font-body text-lg md:text-xl text-parchment/68 leading-relaxed mb-12">
        Different men arrive with different versions of the same underlying questions. Some of what comes up most often:
      </p>

      <div class="space-y-5">
        <details class="group border-b border-parchment/8 pb-5">
          <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
            <p class="font-heading text-xl md:text-2xl text-parchment/85 leading-snug group-open:text-parchment/95 transition-colors">Directionless despite being capable</p>
            <span class="text-parchment/30 text-xl mt-1 shrink-0 group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <div class="faq-body mt-4">
            <p class="font-body text-base md:text-lg text-parchment/60 leading-relaxed">Knowing you could do more, want to do more, and not understanding why you keep not doing it. The gap between capability and action widens quietly over time, and the frustration of watching yourself stall when you know you have more to give becomes its own weight. This is one of the most common things men bring into the work.</p>
          </div>
        </details>

        <details class="group border-b border-parchment/8 pb-5">
          <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
            <p class="font-heading text-xl md:text-2xl text-parchment/85 leading-snug group-open:text-parchment/95 transition-colors">Difficulty sustaining attention, discipline, or follow-through</p>
            <span class="text-parchment/30 text-xl mt-1 shrink-0 group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <div class="faq-body mt-4">
            <p class="font-body text-base md:text-lg text-parchment/60 leading-relaxed">And a growing suspicion that the problem isn't willpower. You have tried harder, made plans, set goals, and still found yourself back at the same point. At some stage the question shifts from "why can't I just do it" to something deeper about what is actually going on underneath the surface pattern of starting and stopping.</p>
          </div>
        </details>

        <details class="group border-b border-parchment/8 pb-5">
          <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
            <p class="font-heading text-xl md:text-2xl text-parchment/85 leading-snug group-open:text-parchment/95 transition-colors">Compulsive distraction</p>
            <span class="text-parchment/30 text-xl mt-1 shrink-0 group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <div class="faq-body mt-4">
            <p class="font-body text-base md:text-lg text-parchment/60 leading-relaxed">The phone. The scroll. The constant background noise that makes it hard to feel anything fully or hear yourself think. Not because you lack intelligence or awareness, but because the pull toward distraction has become the default response to discomfort, boredom, and the kind of quiet that used to be ordinary. Reclaiming your own attention is often where the work begins.</p>
          </div>
        </details>

        <details class="group border-b border-parchment/8 pb-5">
          <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
            <p class="font-heading text-xl md:text-2xl text-parchment/85 leading-snug group-open:text-parchment/95 transition-colors">Emotional shutdown, or its opposite</p>
            <span class="text-parchment/30 text-xl mt-1 shrink-0 group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <div class="faq-body mt-4">
            <p class="font-body text-base md:text-lg text-parchment/60 leading-relaxed">A reactivity you don't fully understand and can't seem to step out of. Some men arrive having gone numb. Others arrive running hot, with anger or irritability they can feel but not explain. Both patterns point to the same thing: an emotional life that has not been given honest attention, and a nervous system doing its best without much support.</p>
          </div>
        </details>

        <details class="group border-b border-parchment/8 pb-5">
          <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
            <p class="font-heading text-xl md:text-2xl text-parchment/85 leading-snug group-open:text-parchment/95 transition-colors">Loneliness that doesn't make sense on paper</p>
            <span class="text-parchment/30 text-xl mt-1 shrink-0 group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <div class="faq-body mt-4">
            <p class="font-body text-base md:text-lg text-parchment/60 leading-relaxed">Surrounded by people. Still unreachable. You may have friends, a social life, a relationship. And still feel that no one quite sees the version of you that exists underneath the performance. The loneliness of young men in this generation is not always about isolation. It is often about the absence of depth in the connections they do have.</p>
          </div>
        </details>

        <details class="group border-b border-parchment/8 pb-5">
          <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
            <p class="font-heading text-xl md:text-2xl text-parchment/85 leading-snug group-open:text-parchment/95 transition-colors">Confusion around masculinity</p>
            <span class="text-parchment/30 text-xl mt-1 shrink-0 group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <div class="faq-body mt-4">
            <p class="font-body text-base md:text-lg text-parchment/60 leading-relaxed">Competing messages, none of them quite right, no one to talk to about it honestly. The culture offers extremes: either a rigid, performative masculinity or a vague instruction to be softer without much guidance on what that means in practice. Most young men are trying to find something in between, and the absence of honest conversation about it leaves the question unresolved and quietly corrosive.</p>
          </div>
        </details>

        <details class="group border-b border-parchment/8 pb-5">
          <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
            <p class="font-heading text-xl md:text-2xl text-parchment/85 leading-snug group-open:text-parchment/95 transition-colors">Anxiety beneath outward competence</p>
            <span class="text-parchment/30 text-xl mt-1 shrink-0 group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <div class="faq-body mt-4">
            <p class="font-body text-base md:text-lg text-parchment/60 leading-relaxed">Performance on the outside, something quieter and more uncertain underneath. You may present well, hold down a job, show up socially. But the internal experience is different: a persistent hum of doubt, self-monitoring, and the quiet fear that if people saw the full picture they would think less of you. The gap between the exterior and the interior is exhausting to maintain.</p>
          </div>
        </details>

        <details class="group border-b border-parchment/8 pb-5">
          <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
            <p class="font-heading text-xl md:text-2xl text-parchment/85 leading-snug group-open:text-parchment/95 transition-colors">A growing gap between who you appear to be and who you actually are</p>
            <span class="text-parchment/30 text-xl mt-1 shrink-0 group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <div class="faq-body mt-4">
            <p class="font-body text-base md:text-lg text-parchment/60 leading-relaxed">The version of yourself that others see and the version you experience from the inside have slowly diverged, and the distance between them is growing. This is not dishonesty. It is the natural result of not having a space where the real version is welcome. Over time, the gap becomes harder to close without help.</p>
          </div>
        </details>

        <details class="group border-b border-parchment/8 pb-5">
          <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
            <p class="font-heading text-xl md:text-2xl text-parchment/85 leading-snug group-open:text-parchment/95 transition-colors">A sense that you should be further along by now</p>
            <span class="text-parchment/30 text-xl mt-1 shrink-0 group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <div class="faq-body mt-4">
            <p class="font-body text-base md:text-lg text-parchment/60 leading-relaxed">And not knowing what "further" would even mean. The comparison is constant and the benchmarks are borrowed from other people's lives, social media, peers who seem to have it together. The pressure to be somewhere else by now is real, but so is the quiet recognition that no one actually gave you a map. This work is not about catching up. It is about finding your own orientation.</p>
          </div>
        </details>
      </div>

      <p class="font-body text-lg md:text-xl text-parchment/78 leading-relaxed mt-12 mb-10">
        If several of these land, the fit call is a reasonable place to start.
      </p>

      <a
        href="#book-call"
        class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg text-sm tracking-wider uppercase font-body font-medium shadow-lg shadow-primary/15"
      >
        Book a Free 15-Minute Call
      </a>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════
       TRANSITION 2 — Type C: Full-bleed photographic break
  ═══════════════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden">
    <Image
      src={himalayaForestSunset}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-center"
      widths={[640, 1024, 1536]}
      sizes="100vw"
      loading="lazy"
    />
