              </div>
              {i < processStages.length - 1 && (
                <div class="w-px flex-1 bg-header-foreground/8 mt-2"></div>
              )}
            </div>
            <div class="pt-1 pb-2">
              <p class="font-heading text-sm text-header-foreground/85 mb-2">{stage.title}</p>
              <p class="font-body text-sm text-header-foreground/50 leading-relaxed">{stage.text}</p>
