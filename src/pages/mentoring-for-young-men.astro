---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import michaelPortrait from '../assets/michael-portrait-new.jpg';
import himalayaEditA from '../assets/himalaya-edit-a.jpg';
import documentaryWaterfall from '../assets/documentary-waterfall.jpg';
import documentaryMountain from '../assets/documentary-mountain.jpg';

const canonicalURL = 'https://www.sangham.org/mentoring-for-young-men';

// ─── DATA ───────────────────────────────────────────────────────────────────

const patternCards = [
  {
    title: 'Withdrawal and Isolation',
    text: 'A young man who increasingly retreats into screens, distraction, avoidance, or emotional distance while becoming harder to meaningfully reach.',
  },
  {
    title: 'Lack of Direction',
    text: 'Intelligent and capable, yet unable to sustain momentum, make decisions, commit himself fully, or move forward with clarity and confidence.',
  },
  {
    title: 'Emotional Reactivity',
    text: 'Anger, defensiveness, emotional shutdown, impulsivity, or difficulty expressing vulnerability beneath an appearance of indifference or control.',
  },
  {
    title: 'Quiet Loss of Self-Trust',
    text: 'A growing sense that he no longer fully trusts himself, his decisions, his direction, or his own inner stability.',
  },
  {
    title: 'Difficulty Carrying Responsibility',
    text: 'Avoidance of challenge, inconsistency, dependence, or difficulty developing the internal structure needed for adult life.',
  },
  {
    title: 'Disconnection From Meaning',
    text: 'A painful sense of drifting through life without deeper orientation, purpose, belonging, or grounded identity.',
  },
];

const developmentCards = [
  {
    title: 'Emotional Regulation',
    text: 'Learning to recognise emotional states without immediately becoming overwhelmed, reactive, avoidant, or shut down by them. Building greater steadiness, reflection, and capacity under pressure.',
  },
  {
    title: 'Self-Awareness',
    text: 'Developing the ability to honestly observe patterns of thought, behaviour, avoidance, fear, defensiveness, and self-sabotage without collapsing into shame.',
  },
  {
    title: 'Direction and Responsibility',
    text: 'Strengthening the ability to make decisions, sustain commitments, follow through consistently, and gradually take ownership of one\'s life and choices.',
  },
  {
    title: 'Communication and Relational Maturity',
    text: 'Learning to express oneself more honestly and clearly while developing greater capacity for listening, accountability, vulnerability, and respectful engagement with others.',
  },
  {
    title: 'Embodied Awareness',
    text: 'Becoming more connected to the body, nervous system, stress patterns, breath, energy levels, and emotional states rather than living entirely inside compulsive thinking or distraction.',
  },
  {
    title: 'Confidence Rooted In Reality',
    text: 'Not performance, arrogance, or image management, but the quieter confidence that gradually emerges through honesty, competence, self-trust, and lived experience.',
  },
  {
    title: 'Capacity For Challenge',
    text: 'Learning to remain present in difficulty rather than constantly escaping discomfort through distraction, avoidance, withdrawal, or impulsive behaviour.',
  },
  {
    title: 'Meaning and Orientation',
    text: 'Helping a young man gradually clarify what genuinely matters to him beyond external pressure, social comparison, or inherited expectations.',
  },
];

const processStages = [
  {
    stage: '01',
    title: 'Parent Consultation',
    text: 'The process usually begins with a parent consultation. This creates space to discuss concerns, patterns that may have emerged, family dynamics, developmental history, and whether the mentorship approach appears appropriate for the young man involved. It also allows parents to ask questions and gain a clearer understanding of how the work is approached before any ongoing process begins.',
  },
  {
    stage: '02',
    title: 'Initial Sessions',
    text: 'Early sessions focus on building rapport, trust, psychological safety, and honest communication. Rather than forcing immediate vulnerability or compliance, the aim is to gradually create a space where meaningful reflection and authentic engagement can emerge naturally.',
  },
  {
    stage: '03',
    title: 'Ongoing Mentorship and Reflective Counselling',
    text: 'Sessions may involve reflective dialogue, developmental guidance, emotional processing, behavioural reflection, accountability work, nervous system awareness, practical life structure, and carefully introduced contemplative practices where appropriate. The work is grounded in real life: relationships, responsibility, study, work, health, direction, communication, and emotional maturity.',
  },
  {
    stage: '04',
    title: 'Embodied Practices',
    text: 'Where beneficial and appropriate, sessions may incorporate simple breathwork, grounding practices, nervous system regulation tools, meditation, body-awareness work, or reflective exercises designed to help young men become more present, emotionally aware, and internally regulated. These practices are introduced practically and carefully rather than ideologically or dogmatically.',
  },
  {
    stage: '05',
    title: 'Parental Reflection and Communication',
    text: 'Parents may periodically be included in broader reflective conversations where useful and appropriate. The aim is not to create surveillance or remove the young man\'s autonomy, but to support healthier communication, understanding, and alignment around the developmental process where possible.',
  },
  {
    stage: '06',
    title: 'Long-Term Development',
    text: 'Meaningful developmental change rarely happens instantly. Some young men may benefit from shorter periods of focused support, while others benefit more from consistent mentorship over longer periods as they gradually stabilise emotionally, relationally, and practically within their lives.',
  },
];

const testimonials = [
  {
    category: 'Parent Reflection',
    indicatorBg: 'bg-primary/30',
    quote: 'The continued mentorship and guidance Michael has provided for my son has helped us all enormously, and it\'s amazing to see how much more joyful and energised he feels after his sessions.',
    name: '',
  },
  {
    category: 'Young Man Reflection',
    indicatorBg: 'bg-parchment/15',
    quote: 'Michael has a remarkable gift for holding space. He has guided me through some of my toughest moments, helping me find my voice and feel comfortable in situations I once found overwhelming. Every process we\'ve worked through has left me feeling clearer and more at peace.',
    name: 'Jacob S.',
  },
  {
    category: 'Professional Reflection',
    indicatorBg: 'bg-border/30',
    quote: 'On meeting Michael for the first time I was immediately drawn to his insightful, grounded approach. There\'s a depth to him that carries a wisdom beyond his years.',
    name: 'Antony S.',
  },
];

const aboutMichaelCards = [
  {
    title: 'Experience With Young Men',
    paragraphs: [
      'My work with young men began long before formal counselling registration.',
      'As a teenager, I entered a deep process of mentorship, psychological work, and personal development myself under the guidance of clinical and forensic psychologist Bernard Altman through the organisation Boys to Men. Over the years, that gradually evolved into leadership, facilitation, mentorship, and direct work with large numbers of adolescent and young adult men. I also became involved with connected organisations in the same lineage — BoysQuest and The Homestead Project — each focused on different aspects of adolescent development across Cape Town.',
      'Much of this work was with boys from at-risk communities across Cape Town, including Ocean View, Lavender Hill, and Hanover Park — young men navigating identity, emotional struggle, belonging, conflict, responsibility, direction, masculinity, and the difficult transition into adulthood.',
    ],
  },
  {
    title: 'Counselling and Developmental Approach',
    paragraphs: [
      'I am registered with the ASCHP as a Wellness Counsellor. My approach integrates reflective counselling, developmental mentorship, nervous system awareness, embodied practice, emotional reflection, behavioural observation, and practical life-oriented guidance.',
      'The emphasis is not on fixing people or imposing ideology, but on helping individuals gradually develop greater awareness, responsibility, emotional maturity, groundedness, and psychological stability within their own lives.',
    ],
  },
  {
    title: 'Meditation and Embodied Practice',
    paragraphs: [
      'Over recent years, I have also spent extensive time in India studying and practising meditation, breathwork, yoga, contemplative psychology, and embodied awareness practices under experienced teachers and within traditional settings.',
      'These elements are not approached as dogma or spiritual performance. Where relevant, they are integrated carefully and practically as tools for attention, nervous system regulation, emotional awareness, self-observation, grounding, and inner stability. Many sessions involve no formal contemplative practice at all.',
    ],
  },
  {
    title: 'A Grounded Approach to Mentorship',
    paragraphs: [
      'I do not believe young men need endless shaming, performance pressure, emotional suppression, or rigid identity systems in order to mature. Nor do I believe all struggle should immediately be pathologised.',
      'In many cases, young men need something both simpler and more demanding: honest relationship, clear reflection, accountability, guidance, challenge, self-awareness, and meaningful opportunities to consciously participate in shaping who they are becoming.',
    ],
  },
  {
    title: 'Scope and Responsibility',
    paragraphs: [
      'This mentorship work is developmental and relational in nature. It is not a substitute for psychiatric care, emergency psychological intervention, addiction treatment, or specialist clinical services where these are required.',
      'Where appropriate, referrals or collaborative support with other professionals may be recommended. Honesty about scope is part of how this work is conducted.',
    ],
  },
];

const whoForPoints = [
  'Struggling with direction, motivation, identity, or life transition',
  'Emotionally withdrawn, disconnected, or difficult to meaningfully reach',
  'Intelligent and capable but unable to consistently apply themselves',
  'Experiencing low confidence, confusion, or loss of self-trust',
  'Becoming increasingly isolated, avoidant, or dependent on distraction',
  'Navigating tension around masculinity, responsibility, belonging, or adulthood',
  'Open to honest conversation, reflection, and gradual developmental work',
  'Looking for grounded guidance rather than rigid ideology or performance pressure',
];

const whoNotForPoints = [
  'Immediate psychiatric or emergency psychological intervention is required',
  'Severe addiction or acute crisis care is the primary concern',
  'The expectation is rapid behavioural compliance without relational process',
  'A parent is seeking control over the young man rather than developmental support',
  'The young man is entirely unwilling to engage in any form of conversation or reflection',
  'The hope is for motivation tactics, discipline systems, or high-performance coaching alone',
  'Spiritual ideology or dogmatic belief systems are being sought',
];

const faqItems = [
  {
    q: 'Is this therapy?',
    a: [
      'No.',
      'This work is better understood as developmental mentorship combined with reflective counselling. While emotional reflection, self-awareness, and psychological insight are certainly part of the process, the work is not positioned as formal psychotherapy or clinical treatment.',
      'The emphasis is developmental and relational: helping young men build greater emotional grounding, responsibility, self-awareness, maturity, direction, and internal stability over time.',
    ],
  },
  {
    q: 'What ages do you generally work with?',
    a: [
      'The mentorship is primarily oriented toward adolescent and young adult men aged 12 to 25, navigating the transition into adulthood. The exact fit depends on maturity, circumstances, openness to the process, and developmental context.',
    ],
  },
  {
    q: 'Does my son need to be interested in meditation or spirituality?',
    a: [
      'No.',
      'The work is grounded, practical, and psychologically oriented rather than religious or ideological. Where contemplative practices are introduced, they are approached carefully as tools for awareness, nervous system regulation, grounding, emotional reflection, and self-observation rather than spiritual belief systems.',
      'Many sessions involve no formal contemplative practice at all.',
    ],
  },
  {
    q: 'What if my son is resistant or unwilling?',
    a: [
      'Some hesitation is completely normal, especially early on. Young men are often understandably cautious about opening up to someone unfamiliar.',
      'The process therefore focuses first on building trust, honesty, and psychological safety rather than forcing vulnerability or compliance.',
      'That said, some minimal willingness to engage in conversation and reflection is generally necessary for meaningful mentorship to develop over time.',
    ],
  },
  {
    q: 'How involved are parents in the process?',
    a: [
      'Parents are important participants in the broader developmental environment surrounding a young man. At the same time, mentorship also depends on the young man having space to speak honestly and develop trust within the process.',
      'Where appropriate, parents may be included in periodic reflective conversations while still respecting the integrity and confidentiality of the mentorship relationship itself.',
    ],
  },
  {
    q: 'How long does the process usually last?',
    a: [
      'There is no fixed timeline.',
      'Some young men benefit from shorter periods of focused support, while others benefit more from longer-term mentorship as they gradually stabilise emotionally, relationally, and practically within their lives.',
      'The work is developmental rather than crisis-oriented, and meaningful change generally develops gradually rather than instantly.',
    ],
  },
  {
    q: 'What kinds of issues do young men usually bring into this work?',
    a: [
      'Every individual is different, but common themes often include lack of direction, emotional shutdown, withdrawal, anxiety, self-esteem difficulties, family conflict, motivation struggles, identity confusion, relationship difficulties, responsibility, discipline, purpose, masculinity, and difficulty navigating the transition into adulthood.',
    ],
  },
  {
    q: 'Is this a replacement for psychiatric or specialist psychological care?',
    a: [
      'No.',
      'This work is not designed for acute psychiatric intervention, crisis management, addiction treatment, or specialist clinical care where these are required. Where appropriate, referrals or collaborative support with other professionals may be recommended.',
    ],
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a.join(' ') },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Mentoring and Counselling for Young Men',
    url: canonicalURL,
    description:
      'Developmental mentorship and reflective counselling for adolescent and young adult men aged 12-25. ASCHP-registered wellness counselling. Online sessions worldwide.',
    serviceType: 'Wellness Counselling and Developmental Mentorship',
    provider: {
      '@type': 'Person',
      name: 'Michael Kaplan',
      jobTitle: 'ASCHP Registered Wellness Counsellor',
      url: 'https://www.sangham.org/about',
      affiliation: {
        '@type': 'Organization',
        name: 'Association for Supportive Counsellors and Holistic Practitioners',
        alternateName: 'ASCHP',
        identifier: 'Reg. No. 10559',
      },
    },
    audience: [
      { '@type': 'Audience', audienceType: 'Parent' },
      { '@type': 'Audience', audienceType: 'Young Adult' },
    ],
    areaServed: [
      { '@type': 'Country', name: 'South Africa' },
      { '@type': 'Place', name: 'Worldwide' },
    ],
    availableChannel: {
      '@type': 'ServiceChannel',
      serviceType: 'Online via video call',
      availableLanguage: 'English',
    },
    offers: [
      {
        '@type': 'Offer',
        name: 'Parent Consultation',
        price: '600',
        priceCurrency: 'ZAR',
        availability: 'https://schema.org/InStock',
        description: '45-minute online consultation for parents. R600 (charged as approx. $35 USD via PayPal).',
      },
      {
        '@type': 'Offer',
        name: 'Individual Mentorship Session',
        price: '850',
        priceCurrency: 'ZAR',
        availability: 'https://schema.org/InStock',
        description: '60-minute individual mentorship and reflective counselling session.',
      },
      {
        '@type': 'Offer',
        name: 'Five-Session Mentorship Commitment',
        price: '3500',
        priceCurrency: 'ZAR',
        availability: 'https://schema.org/InStock',
        description: 'Five 60-minute sessions. R700 per session.',
      },
    ],
  },
];
---

<style is:global>
  /* Carousel scrollbar hiding */
  .scroll-hide { scrollbar-width: none; -ms-overflow-style: none; }
  .scroll-hide::-webkit-scrollbar { display: none; }

  /* Transform carousel */
  .c-track {
    display: flex;
    will-change: transform;
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .c-slide {
    flex: none;
    min-width: 100%;
    width: 100%;
  }

  /* Scroll carousel slide widths — responsive */
  .c-slide-dev {
    flex: none;
    scroll-snap-align: start;
    width: 84vw;
  }
  @media (min-width: 640px) {
    .c-slide-dev { width: 280px; }
  }
  @media (min-width: 1024px) {
    .c-slide-dev { width: 265px; }
  }

  .c-slide-process {
    flex: none;
    scroll-snap-align: start;
    width: 88vw;
  }
  @media (min-width: 640px) {
    .c-slide-process { width: 360px; }
  }
  @media (min-width: 1024px) {
    .c-slide-process { width: 420px; }
  }

  /* FAQ accordion animation */
  details > .faq-body { animation: faqOpen 0.18s ease; }
  @keyframes faqOpen {
    from { opacity: 0; transform: translateY(-3px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* H2 accent line helper */
  .h2-accent {
    display: block;
    width: 4rem;
    height: 1px;
    margin-top: 1rem;
    margin-bottom: 2.5rem;
    background: rgba(180, 140, 80, 0.4);
  }
</style>

<BaseLayout
  title="Mentoring and Counselling for Young Men | Sangham"
  description="Developmental mentorship and reflective counselling for adolescent and young adult men aged 12-25. ASCHP-registered. Online worldwide. Parental consultation available."
  canonicalURL={canonicalURL}
  image="/images/og-default.jpg"
  jsonLd={[...jsonLd, faqJsonLd]}
  minimalNav={true}
  hideStickyBar={true}
>

  <!-- ═══ 1. HERO — bg-void ════════════════════════════════════════════════ -->
  <section class="bg-void -mt-[72px] pt-[72px]">
    <div class="container mx-auto px-6 py-16 md:py-24 max-w-6xl">
      <div class="grid md:grid-cols-[3fr_2fr] gap-12 lg:gap-20 items-center">

        <!-- Left: content -->
        <div class="order-2 md:order-1">
          <p class="text-primary/40 text-xs tracking-widest uppercase font-body mb-8">
            Sangham &middot; Online Sessions Worldwide
          </p>

          <h1 class="font-heading text-4xl md:text-5xl lg:text-[3.25rem] text-parchment/95 leading-tight mb-8">
            A Different Kind of Support<br class="hidden sm:block" />
            <span class="text-gold-gradient">for Young Men</span>
          </h1>

          <p class="font-body text-base md:text-lg text-parchment/55 leading-relaxed mb-10 max-w-lg">
            Grounded mentorship and reflective counselling for adolescent and young adult men aged 12&ndash;25 navigating direction, identity, emotional maturity, responsibility, and the transition into adulthood.
          </p>

          <!-- Pull quote 1 -->
          <blockquote class="pl-6 border-l-2 border-primary/40 mb-10 pb-10 border-b border-b-parchment/10">
            <p class="font-heading text-2xl md:text-3xl text-parchment/85 leading-snug">
              Your son is not broken. He might just be unsupported at a stage of life that was never meant to be crossed alone.
            </p>
          </blockquote>

          <div class="space-y-3 font-body text-sm text-parchment/55 leading-relaxed mb-10">
            <p>Many young men do not need to be pathologised, rescued, or endlessly managed.</p>
            <div class="pl-4 border-l border-primary/20 space-y-1.5 py-1">
              <p class="text-parchment/70">They need guidance.</p>
              <p class="text-parchment/70">They need challenge.</p>
              <p class="text-parchment/70">They need honesty.</p>
              <p>They need a trustworthy relationship with someone capable of helping them develop greater self-awareness, emotional grounding, direction, and responsibility without shame, performance, or posturing.</p>
            </div>
            <p>This work exists to provide that space.</p>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center gap-5 mb-8">
            <a
              href="#parental-cal"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg text-sm tracking-wider uppercase font-body font-medium shadow-lg shadow-primary/15"
            >
              Book a Parent Consultation
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
            <a
              href="#how-it-works"
              class="inline-flex items-center gap-1.5 text-parchment/40 hover:text-parchment/70 text-sm font-body transition-colors"
            >
              How the Mentorship Works
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>

          <div class="flex flex-wrap gap-x-5 gap-y-1.5">
            {['Online sessions available', 'Based in South Africa', 'Ages 12–25', 'Not a replacement for psychiatric care'].map((t) => (
              <p class="text-parchment/25 text-xs font-body">{t}</p>
            ))}
          </div>
        </div>

        <!-- Right: portrait trust anchor -->
        <div class="order-1 md:order-2 flex justify-center md:justify-end">
          <div class="w-full max-w-[200px] md:max-w-[230px] lg:max-w-[250px]">
            <div class="rounded-xl overflow-hidden mb-4 border border-parchment/8">
              <div class="aspect-[4/5] overflow-hidden">
                <Image
                  src={michaelPortrait}
                  alt="Michael Kaplan, ASCHP Registered Wellness Counsellor and developmental mentor for young men"
                  class="w-full h-full object-cover object-center"
                  widths={[400, 500, 600]}
                  sizes="(min-width: 768px) 250px, 200px"
                  width={1254}
                  height={1254}
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            </div>
            <div class="px-1 mb-3">
              <p class="font-heading text-sm text-parchment/75">Michael Kaplan</p>
              <p class="text-primary/50 text-[11px] font-body tracking-wide mt-0.5 leading-snug">ASCHP Registered Wellness Counsellor</p>
            </div>
            <div class="flex flex-wrap gap-1.5 px-1">
              <span class="px-2.5 py-1 rounded-full border border-parchment/10 text-parchment/30 text-[10px] font-body">ASCHP Reg.&nbsp;10559</span>
              <span class="px-2.5 py-1 rounded-full border border-parchment/10 text-parchment/30 text-[10px] font-body">RYS&nbsp;300</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══ 2. PULL STATEMENT — bg-void + faint image ════════════════════════ -->
  <section class="relative overflow-hidden bg-void">
    <Image
      src={himalayaEditA}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-top"
      widths={[640, 1024, 1536]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-void/88"></div>
    <div class="relative z-10 container mx-auto px-6 py-24 md:py-32 max-w-4xl text-center">
      <p class="font-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-parchment/90 leading-tight tracking-tight">
        The years between twelve and twenty-five do not repeat.
      </p>
    </div>
  </section>

  <!-- ═══ 3. CREDIBILITY STRIP — bg-header ════════════════════════════════ -->
  <section class="bg-header text-header-foreground">
    <div class="container mx-auto px-6 py-16 md:py-20 max-w-4xl">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 sm:gap-6 text-center sm:text-left sm:divide-x sm:divide-header-foreground/8">
        <div class="sm:px-6 first:pl-0 last:pr-0">
          <p class="font-heading text-5xl md:text-6xl text-gold-gradient mb-3 leading-none">10+</p>
          <p class="font-body text-xs text-header-foreground/50 leading-relaxed">years working directly with adolescent and young adult men</p>
        </div>
        <div class="sm:px-6">
          <p class="font-heading text-4xl md:text-5xl text-gold-gradient mb-3 leading-tight">Hundreds</p>
          <p class="font-body text-xs text-header-foreground/50 leading-relaxed">of one-on-one and group sessions facilitated across Cape Town and online</p>
        </div>
        <div class="sm:px-6">
          <p class="font-heading text-2xl md:text-3xl text-parchment/75 mb-3 leading-snug">Trained under</p>
          <p class="font-body text-xs text-header-foreground/50 leading-relaxed">a clinical and forensic psychologist in adolescent developmental work</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 4. SOMETHING IS MISSING — bg-background ══════════════════════════ -->
  <section class="bg-background">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-5xl">

      <div class="max-w-3xl mb-14">
        <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl text-foreground leading-tight">
          Something Is Missing For Many Young Men
        </h2>
        <span class="h2-accent"></span>

        <div class="space-y-4 font-body text-sm md:text-base text-muted-foreground/65 leading-relaxed">
          <p>Many parents can sense when something in their son's life is not fully settling into place, even when there is no dramatic crisis.</p>
          <div class="pl-4 border-l border-border/35 space-y-1 py-1 text-muted-foreground/50">
            <p>Sometimes it appears as withdrawal.</p>
            <p>Sometimes as passivity.</p>
            <p>Sometimes as irritability, defensiveness, lack of direction, compulsive distraction, emotional shutdown, or a loss of confidence.</p>
          </div>
          <p>Often, what parents are witnessing is not simply laziness, rebellion, or pathology.</p>
          <p>It is a young man struggling to find stable ground within himself while moving through one of the most psychologically demanding transitions of life.</p>
        </div>
      </div>

      <p class="font-heading text-xl md:text-2xl lg:text-3xl text-foreground/80 leading-snug max-w-2xl border-t border-border/20 pt-10 mb-14">
        Many young men today are growing older without ever truly being guided into adulthood.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-14">
        {patternCards.map((card) => (
          <div class="border border-border/30 rounded-xl p-6 bg-muted/8">
            <p class="font-heading text-sm text-foreground/75 mb-2.5">{card.title}</p>
            <p class="font-body text-sm text-muted-foreground/60 leading-relaxed">{card.text}</p>
          </div>
        ))}
      </div>

      <div class="max-w-3xl space-y-4 font-body text-sm md:text-base text-muted-foreground/60 leading-relaxed border-t border-border/20 pt-10">
        <p>What many young men need is not endless criticism, over-management, or another system attempting to force them into performance. Nor do they necessarily need to be treated as psychologically damaged.</p>
        <p>Very often, they need something far simpler and far older: a grounded developmental relationship.</p>
      </div>

    </div>
