  <!-- ═══ CAROUSEL SCRIPTS — DOMContentLoaded ══════════════════════════════ -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      'use strict';

      // ── Transform carousel (1 slide at a time) ───────────────────────────
      function initTransform(id) {
        var root = document.getElementById(id);
        if (!root) return;
        var track = root.querySelector('.c-track');
        var slides = Array.from(root.querySelectorAll('.c-slide'));
        var prev = root.querySelector('.c-prev');
        var next = root.querySelector('.c-next');
        var dots = Array.from(root.querySelectorAll('.carousel-dot'));
        var countEl = root.querySelector('#michael-count');
        if (!track || !slides.length) return;

        var current = 0;
        var total = slides.length;
        var touchX = 0;

        function setDot(i, active) {
          dots[i].style.width = active ? '1.25rem' : '0.375rem';
          dots[i].style.opacity = active ? '0.85' : '0.28';
          dots[i].style.background = active ? 'rgba(180,140,80,0.65)' : 'rgba(255,255,255,0.18)';
        }

        function goTo(i) {
          var prev_idx = current;
          current = Math.max(0, Math.min(i, total - 1));
          track.style.transform = 'translateX(-' + (current * 100) + '%)';
          if (prev) prev.disabled = current === 0;
          if (next) next.disabled = current === total - 1;
          dots.forEach(function (d, j) { setDot(j, j === current); });
          if (countEl) countEl.textContent = (current + 1) + ' of ' + total;
        }

        // Touch swipe
        track.addEventListener('touchstart', function (e) { touchX = e.touches[0].clientX; }, { passive: true });
        track.addEventListener('touchend', function (e) {
          var dx = touchX - e.changedTouches[0].clientX;
          if (dx > 40) goTo(current + 1);
          else if (dx < -40) goTo(current - 1);
        }, { passive: true });

        if (prev) prev.addEventListener('click', function () { goTo(current - 1); });
        if (next) next.addEventListener('click', function () { goTo(current + 1); });
        dots.forEach(function (d, i) { d.addEventListener('click', function () { goTo(i); }); });

        goTo(0);
      }

      // ── Scroll carousel (multiple slides visible) ────────────────────────
      function initScroll(id) {
        var root = document.getElementById(id);
        if (!root) return;
        var track = root.querySelector('.c-scroll');
        var slides = Array.from(root.querySelectorAll('[class*="c-slide-"]'));
        var prev = root.querySelector('.c-prev');
        var next = root.querySelector('.c-next');
        var dots = Array.from(root.querySelectorAll('.carousel-dot'));
        if (!track || !slides.length) return;

        var current = 0;
        var total = slides.length;

        function getSlideWidth() {
          if (!slides[0]) return 280;
          var style = getComputedStyle(track);
          var gap = parseFloat(style.gap || style.columnGap || '16');
          return slides[0].offsetWidth + gap;
        }

        function setDot(i, active) {
          if (!dots[i]) return;
          dots[i].style.width = active ? '1.25rem' : '0.375rem';
          dots[i].style.opacity = active ? '0.85' : '0.28';
          dots[i].style.background = active ? 'rgba(180,140,80,0.65)' : 'rgba(255,255,255,0.18)';
        }

        function goTo(i) {
          current = Math.max(0, Math.min(i, total - 1));
          track.scrollTo({ left: current * getSlideWidth(), behavior: 'smooth' });
          if (prev) prev.disabled = current === 0;
          if (next) next.disabled = current >= total - 1;
          dots.forEach(function (d, j) { setDot(j, j === current); });
        }

        // Sync on scroll (handles touch swipe natively)
        track.addEventListener('scroll', function () {
          var sw = getSlideWidth();
          if (sw <= 0) return;
          var idx = Math.round(track.scrollLeft / sw);
          idx = Math.max(0, Math.min(idx, total - 1));
          if (idx !== current) {
            current = idx;
            if (prev) prev.disabled = current === 0;
            if (next) next.disabled = current >= total - 1;
            dots.forEach(function (d, j) { setDot(j, j === current); });
          }
        }, { passive: true });

        if (prev) prev.addEventListener('click', function () { goTo(current - 1); });
        if (next) next.addEventListener('click', function () { goTo(current + 1); });
        dots.forEach(function (d, i) { d.addEventListener('click', function () { goTo(i); }); });

        goTo(0);
      }

      // Initialise all four carousels
      initTransform('carousel-testimonials');
      initTransform('carousel-michael');
      initScroll('carousel-dev');
      initScroll('carousel-process');
    });
  </script>

</BaseLayout>
