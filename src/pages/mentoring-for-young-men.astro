  <!-- ══════════════════════════════════════════════════════════════════════
       6. HOW THE MENTORSHIP WORKS — Image Background (documentaryWaterfall)
  ══════════════════════════════════════════════════════════════════════════ -->
  <section id="how-it-works" class="relative overflow-hidden bg-void">
    <Image
      src={documentaryWaterfall}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-center"
      widths={[640, 1024, 1536]}
      sizes="100vw"
      loading="lazy"
