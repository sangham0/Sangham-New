              </li>
            ))}
          </ul>
        </div>

        <div class="border border-header-foreground/8 rounded-xl p-7 bg-void/8">
          <p class="font-heading text-sm text-header-foreground/65 mb-2">Who This Work May Not Be The Right Fit For</p>
