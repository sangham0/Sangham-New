  <script is:inline>
  (function () {
    var root = document.querySelector('.ym-carousel');
    if (!root) return;
    var track = root.querySelector('.ym-carousel-track');
    var inner = root.querySelector('.ym-carousel-inner');
    var slides = root.querySelectorAll('.ym-slide');
    var prev = root.querySelector('.ym-carousel-prev');
    var next = root.querySelector('.ym-carousel-next');
    var counter = root.querySelector('.ym-carousel-current');
    var dots = root.querySelectorAll('.ym-carousel-dots span');
    var total = slides.length;
    var idx = 0;

    function go(n) {
      idx = Math.max(0, Math.min(total - 1, n));
      counter.textContent = String(idx + 1).padStart(2, '0');
      prev.disabled = idx === 0;
      next.disabled = idx === total - 1;
      dots.forEach(function (d, i) {
        d.style.width = i === idx ? '1.5rem' : '1rem';
        d.className = i === idx
          ? 'w-6 h-[2px] bg-primary/70 rounded-full transition-all duration-300'
          : 'w-4 h-[2px] bg-parchment/15 rounded-full transition-all duration-300';
      });
      slides.forEach(function (s, i) {
        var active = i === idx;
        s.setAttribute('aria-hidden', active ? 'false' : 'true');
        s.style.opacity = active ? '1' : '0';
        s.style.position = active ? 'relative' : 'absolute';
        s.style.top = '0';
        s.style.left = (i * 100) + '%';
        s.style.transition = 'opacity 0.45s ease';
        s.style.pointerEvents = active ? 'auto' : 'none';
      });
      inner.style.transform = 'translateX(-' + (idx * 100) + '%)';
    }

    prev.addEventListener('click', function () { go(idx - 1); });
    next.addEventListener('click', function () { go(idx + 1); });

    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { go(idx - 1); e.preventDefault(); }
      if (e.key === 'ArrowRight') { go(idx + 1); e.preventDefault(); }
    });

    var startX = 0;
    var tracking = false;
    root.addEventListener('touchstart', function (e) {
      startX = e.touches[0].clientX;
      tracking = true;
    }, { passive: true });
    root.addEventListener('touchend', function (e) {
      if (!tracking) return;
      tracking = false;
      var diff = e.changedTouches[0].clientX - startX;
      if (Math.abs(diff) > 40) {
        go(diff < 0 ? idx + 1 : idx - 1);
      }
    }, { passive: true });

    inner.style.position = 'relative';
    go(0);
  })();
  </script>

