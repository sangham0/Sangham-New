---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import michaelPortrait from '../assets/michael-portrait-new.jpg';
import mountainSunrise from '../assets/mountain-sunrise.jpg';
import himalayaEditA from '../assets/himalaya-edit-a.jpg';
import documentaryWaterfall from '../assets/documentary-waterfall.jpg';
import documentaryMountain from '../assets/documentary-mountain.jpg';

const canonicalURL = 'https://www.sangham.org/mentoring-for-young-men';

// ─── DATA ───────────────────────────────────────────────────────────────────

const patternCards = [
  {
    title: 'Withdrawal and Isolation',
    text: 'A young man who increasingly retreats into screens, distraction, avoidance, or emotional distance while becoming harder to meaningfully reach.',
  },
  {
    title: 'Lack of Direction',
    text: 'Intelligent and capable, yet unable to sustain momentum, make decisions, commit himself fully, or move forward with clarity and confidence.',
  },
  {
    title: 'Emotional Reactivity',
    text: 'Anger, defensiveness, emotional shutdown, impulsivity, or difficulty expressing vulnerability beneath an appearance of indifference or control.',
  },
  {
    title: 'Quiet Loss of Self-Trust',
    text: 'A growing sense that he no longer fully trusts himself, his decisions, his direction, or his own inner stability.',
  },
  {
    title: 'Difficulty Carrying Responsibility',
    text: 'Avoidance of challenge, inconsistency, dependence, or difficulty developing the internal structure needed for adult life.',
  },
  {
    title: 'Disconnection From Meaning',
    text: 'A painful sense of drifting through life without deeper orientation, purpose, belonging, or grounded identity.',
  },
];

const developmentCards = [
  {
    title: 'Emotional Regulation',
    text: 'Learning to recognise emotional states without immediately becoming overwhelmed, reactive, avoidant, or shut down by them. Building greater steadiness, reflection, and capacity under pressure.',
  },
  {
    title: 'Self-Awareness',
    text: 'Developing the ability to honestly observe patterns of thought, behaviour, avoidance, fear, defensiveness, and self-sabotage without collapsing into shame.',
  },
  {
    title: 'Direction and Responsibility',
    text: 'Strengthening the ability to make decisions, sustain commitments, follow through consistently, and gradually take ownership of one\'s life and choices.',
  },
  {
    title: 'Communication and Relational Maturity',
    text: 'Learning to express oneself more honestly and clearly while developing greater capacity for listening, accountability, vulnerability, and respectful engagement with others.',
  },
  {
    title: 'Embodied Awareness',
    text: 'Becoming more connected to the body, nervous system, stress patterns, breath, energy levels, and emotional states rather than living entirely inside compulsive thinking or distraction.',
  },
  {
    title: 'Confidence Rooted In Reality',
    text: 'Not performance, arrogance, or image management, but the quieter confidence that gradually emerges through honesty, competence, self-trust, and lived experience.',
  },
  {
    title: 'Capacity For Challenge',
    text: 'Learning to remain present in difficulty rather than constantly escaping discomfort through distraction, avoidance, withdrawal, or impulsive behaviour.',
  },
  {
    title: 'Meaning and Orientation',
    text: 'Helping a young man gradually clarify what genuinely matters to him beyond external pressure, social comparison, or inherited expectations.',
  },
];

const processStages = [
  {
    stage: '01',
    title: 'Parent Consultation',
    text: 'The process usually begins with a parent consultation. This creates space to discuss concerns, patterns that may have emerged, family dynamics, developmental history, and whether the mentorship approach appears appropriate for the young man involved. It also allows parents to ask questions and gain a clearer understanding of how the work is approached before any ongoing process begins.',
  },
  {
    stage: '02',
    title: 'Initial Sessions',
    text: 'Early sessions focus on building rapport, trust, psychological safety, and honest communication. Rather than forcing immediate vulnerability or compliance, the aim is to gradually create a space where meaningful reflection and authentic engagement can emerge naturally.',
  },
  {
    stage: '03',
    title: 'Ongoing Mentorship and Reflective Counselling',
    text: 'Sessions may involve reflective dialogue, developmental guidance, emotional processing, behavioural reflection, accountability work, nervous system awareness, practical life structure, and carefully introduced contemplative practices where appropriate. The work is grounded in real life: relationships, responsibility, study, work, health, direction, communication, and emotional maturity.',
  },
  {
    stage: '04',
    title: 'Embodied Practices',
    text: 'Where beneficial and appropriate, sessions may incorporate simple breathwork, grounding practices, nervous system regulation tools, meditation, body-awareness work, or reflective exercises designed to help young men become more present, emotionally aware, and internally regulated. These practices are introduced practically and carefully rather than ideologically or dogmatically.',
  },
  {
    stage: '05',
    title: 'Parental Reflection and Communication',
    text: 'Parents may periodically be included in broader reflective conversations where useful and appropriate. The aim is not to create surveillance or remove the young man\'s autonomy, but to support healthier communication, understanding, and alignment around the developmental process where possible.',
  },
  {
    stage: '06',
    title: 'Long-Term Development',
    text: 'Meaningful developmental change rarely happens instantly. Some young men may benefit from shorter periods of focused support, while others benefit more from consistent mentorship over longer periods as they gradually stabilise emotionally, relationally, and practically within their lives.',
  },
];

const whoForPoints = [
  'Struggling with direction, motivation, identity, or life transition',
  'Emotionally withdrawn, disconnected, or difficult to meaningfully reach',
  'Intelligent and capable but unable to consistently apply themselves',
  'Experiencing low confidence, confusion, or loss of self-trust',
  'Becoming increasingly isolated, avoidant, or dependent on distraction',
  'Navigating tension around masculinity, responsibility, belonging, or adulthood',
  'Open to honest conversation, reflection, and gradual developmental work',
  'Looking for grounded guidance rather than rigid ideology or performance pressure',
];

const whoNotForPoints = [
  'Immediate psychiatric or emergency psychological intervention is required',
  'Severe addiction or acute crisis care is the primary concern',
  'The expectation is rapid behavioural compliance without relational process',
  'A parent is seeking control over the young man rather than developmental support',
  'The young man is entirely unwilling to engage in any form of conversation or reflection',
  'The hope is for motivation tactics, discipline systems, or high-performance coaching alone',
  'Spiritual ideology or dogmatic belief systems are being sought',
];

const faqItems = [
  {
    q: 'Is this therapy?',
    a: [
      'No.',
      'This work is better understood as developmental mentorship combined with reflective counselling. While emotional reflection, self-awareness, and psychological insight are certainly part of the process, the work is not positioned as formal psychotherapy or clinical treatment.',
      'The emphasis is developmental and relational: helping young men build greater emotional grounding, responsibility, self-awareness, maturity, direction, and internal stability over time.',
    ],
  },
  {
    q: 'What ages do you generally work with?',
    a: [
      'The mentorship is primarily oriented toward adolescent and young adult men navigating the transition into adulthood. The exact age range varies depending on maturity, circumstances, openness to the process, and developmental fit.',
    ],
  },
  {
    q: 'Does my son need to be interested in meditation or spirituality?',
    a: [
      'No.',
      'The work is grounded, practical, and psychologically oriented rather than religious or ideological. Where contemplative practices are introduced, they are approached carefully as tools for awareness, nervous system regulation, grounding, emotional reflection, and self-observation rather than spiritual belief systems.',
      'Many sessions involve no formal contemplative practice at all.',
    ],
  },
  {
    q: 'What if my son is resistant or unwilling?',
    a: [
      'Some hesitation is completely normal, especially early on. Young men are often understandably cautious about opening up to someone unfamiliar.',
      'The process therefore focuses first on building trust, honesty, and psychological safety rather than forcing vulnerability or compliance.',
      'That said, some minimal willingness to engage in conversation and reflection is generally necessary for meaningful mentorship to develop over time.',
    ],
  },
  {
    q: 'How involved are parents in the process?',
    a: [
      'Parents are important participants in the broader developmental environment surrounding a young man. At the same time, mentorship also depends on the young man having space to speak honestly and develop trust within the process.',
      'Where appropriate, parents may be included in periodic reflective conversations while still respecting the integrity and confidentiality of the mentorship relationship itself.',
    ],
  },
  {
    q: 'How long does the process usually last?',
    a: [
      'There is no fixed timeline.',
      'Some young men benefit from shorter periods of focused support, while others benefit more from longer-term mentorship as they gradually stabilise emotionally, relationally, and practically within their lives.',
      'The work is developmental rather than crisis-oriented, and meaningful change generally develops gradually rather than instantly.',
    ],
  },
  {
    q: 'What kinds of issues do young men usually bring into this work?',
    a: [
      'Every individual is different, but common themes often include lack of direction, emotional shutdown, withdrawal, anxiety, self-esteem difficulties, family conflict, motivation struggles, identity confusion, relationship difficulties, responsibility, discipline, purpose, masculinity, and difficulty navigating the transition into adulthood.',
    ],
  },
  {
    q: 'Is this a replacement for psychiatric or specialist psychological care?',
    a: [
      'No.',
      'This work is not designed for acute psychiatric intervention, crisis management, addiction treatment, or specialist clinical care where these are required. Where appropriate, referrals or collaborative support with other professionals may be recommended.',
    ],
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a.join(' ') },
  })),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Mentoring and Counselling for Young Men',
    url: canonicalURL,
    description:
      'Developmental mentorship and reflective counselling for adolescent and young adult men aged 13-25. ASCHP-registered wellness counselling. Online sessions worldwide.',
    serviceType: 'Wellness Counselling and Developmental Mentorship',
    provider: {
      '@type': 'Person',
      name: 'Michael Kaplan',
      alternateName: 'Swami Ramarishi',
      jobTitle: 'ASCHP Registered Wellness Counsellor',
      url: 'https://www.sangham.org/about',
      affiliation: {
        '@type': 'Organization',
        name: 'Association for Supportive Counsellors and Holistic Practitioners',
        alternateName: 'ASCHP',
        identifier: 'Reg. No. 10559',
      },
    },
    audience: [
      { '@type': 'Audience', audienceType: 'Parent' },
      { '@type': 'Audience', audienceType: 'Young Adult' },
    ],
    areaServed: [
      { '@type': 'Country', name: 'South Africa' },
      { '@type': 'Place', name: 'Worldwide' },
    ],
    availableChannel: {
      '@type': 'ServiceChannel',
      serviceType: 'Online via video call',
      availableLanguage: 'English',
    },
    offers: [
      {
        '@type': 'Offer',
        name: 'Parent Consultation',
        price: '850',
        priceCurrency: 'ZAR',
        availability: 'https://schema.org/InStock',
        description: '45-minute online consultation for parents to discuss concerns and explore fit.',
      },
      {
        '@type': 'Offer',
        name: 'Individual Mentorship Session',
        price: '850',
        priceCurrency: 'ZAR',
        availability: 'https://schema.org/InStock',
        description: '60-minute individual mentorship and reflective counselling session.',
      },
      {
        '@type': 'Offer',
        name: 'Five-Session Mentorship Commitment',
        price: '3500',
        priceCurrency: 'ZAR',
        availability: 'https://schema.org/InStock',
        description: 'Five 60-minute sessions. R700 per session.',
      },
    ],
  },
];
---

<BaseLayout
  title="Mentoring and Counselling for Young Men | Sangham"
  description="Developmental mentorship and reflective counselling for adolescent and young adult men. ASCHP-registered. Online worldwide. Parental consultation available."
  canonicalURL={canonicalURL}
  image="/images/og-default.jpg"
  jsonLd={[...jsonLd, faqJsonLd]}
  minimalNav={true}
  hideStickyBar={true}
>

  <!-- ═══ 1. HERO ═══════════════════════════════════════════════════════════ -->
  <section class="bg-void -mt-[72px] pt-[72px]">
    <div class="container mx-auto px-6 py-16 md:py-24 max-w-6xl">
      <div class="grid md:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- Left: content -->
        <div class="order-2 md:order-1">
          <p class="text-primary/45 text-xs tracking-widest uppercase font-body mb-8">
            Sangham &middot; Online Sessions Worldwide
          </p>

          <h1 class="font-heading text-4xl md:text-5xl lg:text-[3.25rem] text-parchment/95 leading-tight mb-8">
            A Different Kind of Support<br class="hidden sm:block" />
            <span class="text-gold-gradient">for Young Men</span>
          </h1>

          <p class="font-body text-base md:text-lg text-parchment/60 leading-relaxed mb-10 max-w-lg">
            Grounded mentorship and reflective counselling for adolescent and young adult men navigating direction, identity, emotional maturity, responsibility, and the transition into adulthood.
          </p>

          <p class="font-heading text-xl md:text-2xl text-parchment/85 leading-snug max-w-md mb-10 pb-10 border-b border-parchment/10">
            Your son may not be broken. He might just be unsupported at a stage of life that was never meant to be crossed alone.
          </p>

          <div class="space-y-3 font-body text-sm text-parchment/60 leading-relaxed mb-10">
            <p>Many young men do not need to be pathologised, rescued, or endlessly managed.</p>
            <div class="pl-4 border-l border-primary/25 space-y-1.5 py-1">
              <p class="text-parchment/75">They need guidance.</p>
              <p class="text-parchment/75">They need challenge.</p>
              <p class="text-parchment/75">They need honesty.</p>
              <p>They need a trustworthy relationship with someone capable of helping them develop greater self-awareness, emotional grounding, direction, and responsibility without shame, performance, or posturing.</p>
            </div>
            <p>This work exists to provide that space.</p>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a
              href="#parental-cal"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg text-sm tracking-wider uppercase font-body font-medium shadow-lg shadow-primary/20"
            >
              Book a Parent Consultation
              <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
            <a
              href="#how-it-works"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-parchment/15 text-parchment/50 hover:border-parchment/30 hover:text-parchment/75 transition-all duration-300 rounded-lg text-sm tracking-wider uppercase font-body"
            >
              How the Mentorship Works
            </a>
          </div>

          <div class="flex flex-wrap gap-x-5 gap-y-1.5">
            {['Online sessions available', 'Based in South Africa', 'Long-term developmental focus', 'Not a replacement for psychiatric or emergency care'].map((t) => (
              <p class="text-parchment/30 text-xs font-body">{t}</p>
            ))}
          </div>
        </div>

        <!-- Right: trust card -->
        <div class="order-1 md:order-2 max-w-sm mx-auto md:max-w-none">
          <div class="rounded-2xl border border-parchment/10 bg-header/50 overflow-hidden">
            <div class="aspect-[3/4] overflow-hidden">
              <Image
                src={michaelPortrait}
                alt="Michael Kaplan, ASCHP Registered Wellness Counsellor and developmental mentor for young men"
                class="w-full h-full object-cover object-center"
                widths={[480, 640, 960]}
                sizes="(min-width: 768px) 45vw, 90vw"
                width={1254}
                height={1254}
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div class="p-6 space-y-4">
              <div>
                <p class="font-heading text-base text-parchment/90">Michael Kaplan</p>
                <p class="text-primary/60 text-xs font-body tracking-wide mt-0.5">ASCHP Registered Wellness Counsellor</p>
              </div>
              <p class="text-parchment/45 text-xs font-body leading-relaxed">
                Former youth leader, central co-ordinator and facilitator at Boys to Men under the mentorship of Bernard Altman, with years of experience working closely with adolescent and young adult men through mentorship, process work, reflective dialogue, and developmental guidance.
              </p>
              <p class="text-parchment/35 text-xs font-body leading-relaxed">
                The mentorship approach also draws from extensive contemplative training in meditation, breathwork, and embodied self-awareness practices developed through years of study and practice in India.
              </p>
              <div class="flex flex-wrap gap-2 pt-1">
                <span class="px-3 py-1 rounded-full border border-parchment/10 text-parchment/35 text-xs font-body">ASCHP Reg.&nbsp;10559</span>
                <span class="px-3 py-1 rounded-full border border-parchment/10 text-parchment/35 text-xs font-body">RYS 300</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══ 2. SOMETHING IS MISSING ══════════════════════════════════════════ -->
  <section class="bg-background">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-5xl">

      <div class="max-w-3xl mb-12">
        <h2 class="font-heading text-3xl md:text-4xl text-foreground mb-8 leading-tight">
          Something Is Missing<br class="hidden sm:block" />For Many Young Men
        </h2>

        <div class="space-y-4 font-body text-sm md:text-base text-muted-foreground/70 leading-relaxed">
          <p>Many parents can sense when something in their son's life is not fully settling into place, even when there is no dramatic crisis.</p>
          <div class="pl-4 border-l border-border/40 space-y-1 py-1 text-muted-foreground/55">
            <p>Sometimes it appears as withdrawal.</p>
            <p>Sometimes as passivity.</p>
            <p>Sometimes as irritability, defensiveness, lack of direction, compulsive distraction, emotional shutdown, or a loss of confidence.</p>
          </div>
          <p>Often, what parents are witnessing is not simply laziness, rebellion, or pathology.</p>
          <p>It is a young man struggling to find stable ground within himself while moving through one of the most psychologically demanding transitions of life.</p>
        </div>
      </div>

      <p class="font-heading text-xl md:text-2xl lg:text-3xl text-foreground/85 leading-snug max-w-2xl border-t border-border/20 pt-10 mb-12">
        Many young men today are growing older without ever truly being guided into adulthood.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-12">
        {patternCards.map((card) => (
          <div class="border border-border/40 rounded-xl p-6 bg-muted/10">
            <p class="font-heading text-sm text-foreground/80 mb-2">{card.title}</p>
            <p class="font-body text-sm text-muted-foreground/65 leading-relaxed">{card.text}</p>
          </div>
        ))}
      </div>

      <div class="max-w-3xl space-y-4 font-body text-sm md:text-base text-muted-foreground/65 leading-relaxed border-t border-border/20 pt-10">
        <p>What many young men need is not endless criticism, over-management, or another system attempting to force them into performance.</p>
        <p>Nor do they necessarily need to be treated as psychologically damaged.</p>
        <p>Very often, they need something far simpler and far older: a grounded developmental relationship capable of helping them build self-awareness, emotional steadiness, direction, honesty, and responsibility over time.</p>
      </div>

    </div>
  </section>

  <!-- ═══ 3. A DIFFERENT WAY OF UNDERSTANDING ═══════════════════════════════ -->
  <section class="bg-header text-header-foreground">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-5xl">

      <div class="max-w-3xl mb-12">
        <h2 class="font-heading text-3xl md:text-4xl text-gold-gradient mb-10 leading-tight">
          A Different Way Of Understanding The Problem
        </h2>

        <div class="font-heading text-xl md:text-2xl text-header-foreground/85 leading-snug max-w-2xl space-y-2 mb-10">
          <p>The question is not always "what is wrong with him?"</p>
          <p class="text-primary/70">Sometimes the better question is: "What has he not yet been given?"</p>
        </div>

        <div class="space-y-4 font-body text-sm md:text-base text-header-foreground/60 leading-relaxed">
          <p>For most of human history, the transition into adulthood did not happen in isolation.</p>
          <p>Young men were gradually shaped through responsibility, challenge, guidance, brotherhood, mentorship, embodied practice, meaningful expectations, and relationships with older men capable of helping them mature psychologically and emotionally.</p>
          <p>Today, many young men are attempting to navigate that transition largely alone.</p>
          <p>They are surrounded by stimulation, information, pressure, comparison, distraction, and performance demands, yet often lack meaningful spaces where they can slow down enough to develop genuine self-understanding, emotional steadiness, direction, and internal structure.</p>
          <p>In many cases, the issue is not simply motivation.</p>
          <div class="pl-4 border-l border-primary/25 space-y-1 py-1 text-header-foreground/50">
            <p>It is disconnection: from self, from responsibility, from embodied presence, from meaningful challenge, and from trustworthy forms of guidance.</p>
          </div>
        </div>
      </div>

      <!-- Contrast panel -->
      <div class="border border-header-foreground/10 rounded-2xl p-8 md:p-10 bg-void/20 mb-12">
        <h3 class="font-heading text-lg text-gold-gradient mb-8">
          What This Work Is, and What It Is Not
        </h3>
        <div class="grid md:grid-cols-3 gap-6 md:gap-8">
          <div>
            <p class="font-heading text-sm text-header-foreground/80 mb-3">Not Performance Coaching</p>
            <p class="font-body text-xs text-header-foreground/50 leading-relaxed">
              This work is not focused on turning young men into hyper-productive achievement machines or forcing them into externally imposed identities. The goal is not performance at any cost, but the development of grounded self-awareness, responsibility, resilience, and inner stability.
            </p>
          </div>
          <div>
            <p class="font-heading text-sm text-header-foreground/80 mb-3">Not Passive Emotional Processing</p>
            <p class="font-body text-xs text-header-foreground/50 leading-relaxed">
              While emotional reflection is important, this work is not based on endless analysis without movement or accountability. Insight must gradually become embodied through action, responsibility, communication, self-observation, and lived change.
            </p>
          </div>
          <div>
            <p class="font-heading text-sm text-header-foreground/80 mb-3">Not Spiritual Escapism</p>
            <p class="font-body text-xs text-header-foreground/50 leading-relaxed">
              Meditation and breathwork are approached practically and carefully as tools for attention, nervous system regulation, emotional awareness, and self-observation. This work is grounded in real life: relationships, study, work, discipline, health, responsibility, and honest engagement with reality.
            </p>
          </div>
        </div>
      </div>

      <!-- Closing reframe -->
      <div class="max-w-3xl space-y-4 font-body text-sm md:text-base text-header-foreground/60 leading-relaxed mb-10">
        <p>Many young men do not need to become somebody else entirely.</p>
        <div class="pl-4 border-l border-primary/25 py-1 space-y-1 text-header-foreground/50">
          <p>They need support in becoming more deeply connected to themselves: more honest, more grounded, more capable of responsibility, more emotionally mature, and more able to consciously shape the direction of their lives.</p>
        </div>
        <p>That process rarely happens through advice alone.</p>
        <p>It happens slowly through relationship, reflection, challenge, practice, and trust built over time.</p>
      </div>

      <a
        href="#how-it-works"
        class="inline-flex items-center gap-2 text-primary/60 hover:text-primary text-sm font-body transition-colors"
      >
        Explore how the mentorship works
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>

    </div>
  </section>

  <!-- ═══ 4. WHAT THIS WORK ACTUALLY DEVELOPS ═══════════════════════════════ -->
  <section class="bg-background">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-5xl">

      <h2 class="font-heading text-3xl md:text-4xl text-foreground mb-6 leading-tight max-w-2xl">
        What This Work Actually Develops
      </h2>

      <div class="space-y-4 font-body text-sm md:text-base text-muted-foreground/65 leading-relaxed mb-8 max-w-2xl">
        <p>This mentorship is not built around quick fixes, rigid systems, or motivational intensity.</p>
        <p>The work is gradual and relational. Over time, the aim is to help young men develop greater psychological grounding, emotional maturity, self-awareness, responsibility, and clarity in how they relate to themselves, other people, and the direction of their lives.</p>
      </div>

      <p class="font-heading text-xl md:text-2xl text-foreground/85 leading-snug max-w-2xl border-t border-border/20 pt-8 mb-12">
        The goal is not to manufacture a new identity. The goal is to help a young man become more deeply connected, responsible, aware, and capable within his own life.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
        {developmentCards.map((card) => (
          <div class="border border-border/40 rounded-xl p-6 bg-muted/10 flex flex-col">
            <p class="font-heading text-sm text-foreground/80 mb-3">{card.title}</p>
            <p class="font-body text-xs text-muted-foreground/65 leading-relaxed flex-1">{card.text}</p>
          </div>
        ))}
      </div>

      <div class="max-w-3xl space-y-4 font-body text-sm md:text-base text-muted-foreground/65 leading-relaxed border-t border-border/20 pt-8 mb-10">
        <p>Different young men arrive with different struggles, personalities, temperaments, and developmental histories. This work is therefore not approached mechanically. The mentorship process is adaptive, relational, and shaped around the actual human being rather than forcing every individual into the same system or ideology.</p>
      </div>

      <p class="font-heading text-xl md:text-2xl text-foreground/85 leading-snug max-w-xl mb-10">
        Real growth rarely happens through advice alone. It happens through relationship, reflection, challenge, practice, honesty, and time.
      </p>

      <a
        href="#how-it-works"
