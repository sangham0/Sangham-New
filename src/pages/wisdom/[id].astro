---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleBadge from '../../components/ArticleBadge.astro';

export async function getStaticPaths() {
  // Drafts never build. The three art-directed essays are not in the
  // collection; they live as hand-built pages alongside this route.
  const entries = await getCollection('writing', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const publishedDate = data.publishedDate.toISOString().slice(0, 10);
const wordCount = (entry.body ?? '').split(/\s+/).length;
const readingTime = Math.max(1, Math.round(wordCount / 200));

const isMeditationArticle =
  data.category === 'practice-guide' ||
  data.tags.includes('meditation') ||
  data.tags.includes('breathwork');

const relatedService = data.tags.includes('teenagers')
  ? { href: '/mentoring-for-adolescents', label: 'Mentoring for teenage boys' }
  : data.tags.includes('young-men')
    ? { href: '/mentoring-for-young-men', label: 'Mentoring for young men' }
    : isMeditationArticle
      ? { href: '/counselling-for-meditators', label: 'Counselling for meditators' }
      : { href: '/counselling', label: 'Online wellness counselling' };

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.sangham.org/' },
      { '@type': 'ListItem', position: 2, name: 'Writing', item: 'https://www.sangham.org/wisdom' },
      { '@type': 'ListItem', position: 3, name: data.title, item: `https://www.sangham.org/wisdom/${entry.id}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.excerpt,
    url: `https://www.sangham.org/wisdom/${entry.id}`,
    datePublished: publishedDate,
    dateModified: publishedDate,
    articleSection: data.category === 'practice-guide' ? 'Practice Guide' : 'Essay',
    inLanguage: 'en',
    image: {
      '@type': 'ImageObject',
      url: 'https://www.sangham.org/images/og-default.jpg',
    },
    author: {
      '@type': 'Person',
      name: 'Michael Kaplan',
      alternateName: 'Swami Ramarishi',
      url: 'https://www.sangham.org/about',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Sangham',
      url: 'https://www.sangham.org',
      logo: {
        '@type': 'ImageObject',
        url: 'https://www.sangham.org/sangham-logo.png',
      },
    },
    isPartOf: {
      '@type': 'WebPage',
      url: 'https://www.sangham.org/wisdom/',
      name: 'Sangham Writing',
    },
  },
];
---

<BaseLayout
  title={data.title}
  description={data.excerpt}
  type="article"
  publishedDate={publishedDate}
  jsonLd={jsonLd}
>

  <!-- ESSAY HEADER -->
  <section class="bg-header py-20 md:py-28">
    <div class="container mx-auto px-6 max-w-3xl">
      <a
        href="/wisdom"
        class="inline-flex items-center gap-2 text-sm text-header-foreground/50 hover:text-header-foreground/80 font-body transition-colors mb-10"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Back to Writing
      </a>

      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-gold-gradient mb-4">
        {data.title}
      </h1>
      <div class="mb-4">
        <ArticleBadge
          type={data.category}
          context="header"
          showPrint={data.category === 'practice-guide'}
        />
      </div>
      <div class="flex items-center gap-3 text-sm text-header-foreground/40 font-body">
        <span>{data.dateLabel}</span>
        <span class="text-header-foreground/20">&middot;</span>
        <span>{readingTime} min read</span>
      </div>
      {data.notebook && (
        <p class="font-body text-sm italic text-header-foreground/55 leading-relaxed mt-6 max-w-xl">
          From the contemplative notebooks: written during traditional training years in India, in the language of the traditions themselves. It sits alongside the counselling work as a different mode of inquiry.
        </p>
      )}
      <div class="divider-gold w-24 mt-8"></div>
    </div>
  </section>

  <!-- ESSAY BODY -->
  <section class="bg-background">
    <div class="container mx-auto px-6 py-16 md:py-24 max-w-2xl">
      <div class="essay-content text-muted-foreground font-body leading-relaxed text-[15px]">
        <Content />
      </div>

      <!-- AUTHOR -->
      <div class="mt-14 border-t border-border/40 pt-8 flex items-start gap-4">
        <img
          src="/images/michael-kaplan.jpg"
          alt="Michael Kaplan"
          width="56"
          height="56"
          loading="lazy"
          class="rounded-full object-cover w-14 h-14 shrink-0 border border-border/60"
        />
        <div>
          <p class="font-body text-sm text-foreground/80">
            Written by <a href="/about" class="text-primary/80 hover:text-primary transition-colors">Michael Kaplan (Swami Ramarishi)</a>
          </p>
          <p class="font-body text-xs text-muted-foreground/70 leading-relaxed mt-1">
            BA Psychology &middot; ASCHP Registered Wellness Counsellor (Reg. 10559). Michael works with individuals online across South Africa and internationally.
          </p>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 border border-border rounded-lg p-8 md:p-10 text-center bg-muted/30">
        <h3 class="font-heading text-xl md:text-2xl text-foreground mb-4">
          Explore This Work Directly
        </h3>
        <p class="text-muted-foreground font-body text-sm leading-relaxed max-w-lg mx-auto mb-8">
          If something in this essay resonates, a free 15-minute call is a simple way to establish whether this work fits what you need.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-10 py-4 bg-primary text-primary-foreground hover:bg-gold-light transition-all duration-300 rounded-lg text-sm tracking-wider uppercase font-body"
        >
          Book a free 15-minute fit call
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
        <p class="text-muted-foreground/70 font-body text-sm leading-relaxed max-w-lg mx-auto mt-6">
          The most relevant service for this topic is
          <a href={relatedService.href} class="text-primary/80 hover:text-primary underline underline-offset-2 decoration-primary/30 transition-colors">{relatedService.label}</a>.
        </p>
      </div>

      <div class="divider-gold w-24 mx-auto mt-16"></div>

      <div class="mt-10 text-center">
        <a
          href="/wisdom"
          class="text-sm text-primary/70 hover:text-primary font-body transition-colors"
        >
          &larr; Back to all essays
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Markdown body styling: mirrors the previous space-y-6 paragraph render. */
  .essay-content :global(p) {
    margin-bottom: 1.5rem;
  }
  .essay-content :global(p:last-child) {
    margin-bottom: 0;
  }
  .essay-content :global(ol),
  .essay-content :global(ul) {
    margin: 0 0 1.5rem 1.5rem;
    list-style: decimal outside;
  }
  .essay-content :global(ul) {
    list-style: disc outside;
  }
  .essay-content :global(li) {
    margin-bottom: 0.75rem;
  }
  /* Closing-bridge treatment: a thin gold rule followed by a quiet italic note. */
  .essay-content :global(hr) {
    border: none;
    height: 1px;
    width: 6rem;
    margin: 2.5rem auto;
    background: linear-gradient(90deg, transparent, hsl(42 52% 40% / 0.4), transparent);
  }
  .essay-content :global(hr + p) {
    text-align: center;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-muted-foreground) 70%, transparent);
  }
  .essay-content :global(a) {
    color: hsl(42 52% 42% / 0.8);
    transition: color 0.2s ease;
  }
  .essay-content :global(a:hover) {
    color: hsl(42 52% 42%);
  }
  .essay-content :global(blockquote) {
    border-left: 2px solid hsl(42 52% 42% / 0.3);
    padding-left: 1.5rem;
    font-style: italic;
    margin-bottom: 1.5rem;
  }
</style>
