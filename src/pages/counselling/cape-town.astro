            Message on WhatsApp
          </a>
        </div>
        <p class="font-body text-sm text-foreground/60 italic mb-12">In person in Newlands, Cape Town &middot; Online worldwide</p>

        <CalEmbed minHeight="640px" service={SERVICE} />
