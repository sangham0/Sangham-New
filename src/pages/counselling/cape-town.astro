---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import CalEmbed from '../../components/CalEmbed.astro';
import StickyConsultationCTA from '../../components/StickyConsultationCTA.astro';
import { Image } from 'astro:assets';
import { getPublishedTestimonial } from '../../data/testimonials';

// ── Michael, and the Newlands consulting room ──
import michaelPortrait from '../../assets/michael-portrait-new.jpg';
import roomChairs from '../../assets/counselling-cape-town-chairs.webp';
import roomInterior from '../../assets/counselling-cape-town-interior.webp';
import roomGarden from '../../assets/counselling-cape-town-garden.webp';

// ── Cape landscape dividers ────────────────────────────────────────────────
// TEMPORARY placeholders. Michael intends to replace these with his own Cape
// Town photography; each divider reads its image from exactly one import
// below, so swapping one is a single-line change (drop the new file into
// src/assets and repoint the import). Every divider uses object-cover plus an
// object-position, so a replacement at any aspect ratio will still frame well.
//
// All three are Pexels-licensed (free for commercial use, no attribution
// required). Provenance is recorded here and in docs/cape-town-imagery.md.
//
// Table Mountain wrapped in cloud at first light. Ryan Lansdown.
//   https://www.pexels.com/photo/majestic-table-mountain-shrouded-in-mist-33283776/
import capeTableMountain from '../../assets/cape-town-table-mountain-cloud.jpg';
// Mist moving across a fynbos slope on Table Mountain. Ryan Lansdown.
//   https://www.pexels.com/photo/moody-foggy-landscape-at-table-mountain-32721030/
import capeMountainMist from '../../assets/cape-town-mountain-mist.jpg';
// The Twelve Apostles and the Atlantic seaboard at dusk. Mimi.
//   https://www.pexels.com/photo/dramatic-coastal-view-of-cape-town-at-sunset-35924017/
import capeAtlanticDusk from '../../assets/cape-town-atlantic-dusk.jpg';

const canonicalURL = 'https://www.sangham.org/counselling/cape-town/';
const WHATSAPP = 'https://wa.me/27736738063';
// Retain the existing service identifier; page_path distinguishes this location.
const SERVICE = 'adult-counselling';

// The major meta-analytic synthesis of the alliance literature. Linked once,
// quietly, rather than carried as citation apparatus on the page.
const ALLIANCE_META_ANALYSIS = 'https://pubmed.ncbi.nlm.nih.gov/29792475/';

const primaryButton =
  'ctc-button inline-flex items-center justify-center px-8 py-4 rounded-lg text-sm tracking-wider uppercase font-body font-medium transition-colors duration-200';
const ghostButtonDark =
  'inline-flex items-center justify-center gap-2 px-7 py-4 border border-parchment/30 text-parchment/85 hover:border-gold-light hover:text-gold-light transition-colors duration-300 rounded-lg text-sm tracking-wide font-body';

// Reflections come from src/content/testimonials/, so this page can never drift
// from /testimonials. All three list /counselling among their services.
const reflectionSources = [
  { id: 'nikhita-leela', pos: 'object-[center_20%]' },
  { id: 'jacob-s', pos: 'object-[center_top]' },
  { id: 'bernard-altman', pos: 'object-[center_25%]' },
];

const reflections = await Promise.all(
  reflectionSources.map(async (source) => {
    const { data } = await getPublishedTestimonial(source.id);
    return {
      pos: source.pos,
      portrait: data.portrait,
      portraitAlt: data.portraitAlt ?? data.name,
      label: data.label,
      name: data.name,
      role: data.attribution,
      quote: data.cardQuote ?? data.excerpt.join(' '),
    };
  })
);

const bernard = await getPublishedTestimonial('bernard-altman');

// Lived starting points, written as people actually describe them rather than
// as diagnostic categories. Replaces the earlier generic problem grid.
const startingPoints = [
  {
    head: 'You understand the pattern perfectly well, and it still happens.',
    body: 'A particular kind of relationship keeps bringing out a version of you that you do not like, or you make decisions you can explain clearly afterwards and still cannot seem to live differently.',
  },
  {
    head: 'From the outside, things look fine.',
    body: 'You are functioning well enough by most measures while privately feeling anxious, disconnected, restless, or unsure what all the effort is actually for.',
  },
  {
    head: 'Something that ended is still shaping the present.',
    body: 'The situation is over in practical terms, but it continues to set how much you trust, what you expect of other people, how quickly you become defensive, and how safe it feels to depend on anyone.',
  },
  {
    head: 'The ground has shifted and the old frameworks no longer convince you.',
    body: 'Work, adulthood, a relationship, identity or family life is changing, and the things that used to give direction have quietly stopped doing so.',
  },
  {
    head: 'The thinking will not settle.',
    body: 'A persistent internal pressure that makes it difficult to be present, to rest, or to trust a decision once you have made it.',
  },
  {
    head: 'Nothing is wrong, exactly.',
    body: 'There is no crisis. There is a wish to understand yourself more deeply, be less governed by patterns you did not consciously choose, and live with more clarity and intention.',
  },
];

const fiveSteps = [
  { num: '01', title: 'Mapping', text: 'Understanding current patterns, dynamics, and the specific areas where there is a sense of being stuck or challenged.' },
  { num: '02', title: 'Identifying', text: 'Seeing what is actually maintaining these patterns. Looking beyond the familiar explanation to how they operate.' },
  { num: '03', title: 'Intervening', text: 'Introducing targeted adjustments, chosen for the specific situation. These may be changes in behaviour, ways of attending to experience, or a practical exercise.' },
  { num: '04', title: 'Applying', text: 'Testing changes in real time. Seeing what holds, what needs adjustment, and what emerges as the real work.' },
  { num: '05', title: 'Consolidating', text: 'Reviewing what has shifted, clarifying next steps, and establishing a sustainable foundation for continued development.' },
];

const supportPaths = [
  { title: 'Counselling for adults', text: 'The main counselling offer, for adults looking at recurring patterns, relationships, or a difficult stretch of life.', href: '/counselling/' },
  { title: 'Mentoring for young men', text: 'Reflective counselling and developmental mentorship for men aged 18 to 25, working with direction, identity, responsibility, or emotional shutdown.', href: '/mentoring-for-young-men/' },
  { title: 'Mentoring for teenage boys', text: 'Developmental mentorship and reflective counselling for boys aged 12 to 17. The service is for the young person, with a clear process for parent involvement.', href: '/mentoring-for-adolescents/' },
  { title: 'Counselling for meditators', text: 'Support for practice-related questions, difficult experiences, and the work of integrating contemplative insight into ordinary life.', href: '/counselling-for-meditators/' },
];

const faqItems = [
  { q: 'Where are in-person sessions held?', a: 'In Newlands, in the Southern Suburbs of Cape Town, in the private consulting room shown on this page. Appointments are arranged in advance. The exact address and arrival details are shared privately when your appointment is confirmed.' },
  { q: 'Do you work in one particular therapeutic approach?', a: 'No. The work is integrative and responsive rather than built on a single method. What is useful varies between people, and often between different stages of the same person’s life. Some of the work is practical and focused on behaviour and decisions; some of it is slower, and concerned with history, emotion, or patterns that have been carried a long time. The approach is chosen in relation to the person rather than applied in advance.' },
  { q: 'Do you also offer online counselling?', a: 'Yes. Online sessions remain available by video call, including for people outside Cape Town. We can discuss which format makes practical sense for you. There is no requirement to work in person.' },
  { q: 'What does a session cost?', a: 'An individual session is R850 for 60 minutes. The structured five-session process is R3,400. The first 15-minute fit call is free. If cost is a genuine barrier, mention it when reaching out; reduced-rate availability can be discussed.' },
  { q: 'Do I need experience with meditation?', a: 'No. The work is grounded, practical, and psychologically informed. Where contemplative practices are introduced, they are used as optional tools for attention and self-observation, not as spiritual beliefs. Many sessions involve none of this directly.' },
  { q: 'Do you work with teenagers?', a: 'Yes, with teenage boys aged 12 to 17. Parents can begin with a free fit call. The next step in that pathway is a 45-minute parent consultation at R600, before work with the young person begins. Confidentiality, safeguarding, and parent involvement are explained on the teenage mentoring page.' },
  { q: 'Do you work with men and young adults?', a: 'Yes. Work with boys and young men is a long-standing part of Michael’s practice. There is a dedicated mentoring pathway for men aged 18 to 25, alongside general counselling for adults. The general counselling offer is not restricted to men.' },
  { q: 'Is this psychotherapy?', a: 'No. This is supportive Wellness Counselling under ASCHP registration. It is distinct from clinical psychology, psychotherapy, psychiatry, and medical treatment. It does not include diagnosis or medication management. Where specialist care is needed, Michael will say so directly and recommend an appropriate professional.' },
  { q: 'Is medical aid accepted?', a: 'Sessions are offered on a private, self-funded basis. Please budget for the fees listed on this page.' },
  { q: 'When are in-person appointments available?', a: 'In-person appointments are currently available at selected times in the Southern Suburbs. Availability is agreed directly. The online calendar below is for the introductory fit call; it does not reserve a counselling-room appointment.' },
  { q: 'How do I book?', a: 'Start with the free 15-minute fit call below, or send a WhatsApp message if you would prefer to write first. Mention that you are interested in meeting in Cape Town. We will discuss fit and availability, then arrange the appropriate first consultation.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${canonicalURL}#service`,
    name: 'In-Person Wellness Counselling in Cape Town',
    url: canonicalURL,
    description: 'Reflective Wellness Counselling with Michael Kaplan in Newlands, Southern Suburbs, Cape Town. Relationship-led and integrative rather than built on a single method. Private appointments by arrangement; online sessions also available.',
    serviceType: 'Wellness Counselling',
    provider: { '@id': 'https://www.sangham.org/about/#michael-kaplan' },
    areaServed: { '@type': 'City', name: 'Cape Town' },
    availableChannel: [
      { '@type': 'ServiceChannel', serviceUrl: canonicalURL, serviceLocation: { '@type': 'Place', name: 'Newlands, Southern Suburbs, Cape Town' }, availableLanguage: 'English' },
      { '@type': 'ServiceChannel', serviceUrl: 'https://www.sangham.org/online-counselling-south-africa/', availableLanguage: 'English' },
    ],
    offers: [
      { '@type': 'Offer', name: 'Free 15-Minute Fit Call', price: '0', priceCurrency: 'ZAR', url: `${canonicalURL}#book-call` },
      { '@type': 'Offer', name: 'Individual Counselling Session', price: '850', priceCurrency: 'ZAR', description: 'A 60-minute session, by appointment.' },
      { '@type': 'Offer', name: 'Five-Session Process', price: '3400', priceCurrency: 'ZAR', description: 'Five 60-minute counselling sessions, with a review at the end.' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.sangham.org/' },
      { '@type': 'ListItem', position: 2, name: 'Counselling', item: 'https://www.sangham.org/counselling/' },
      { '@type': 'ListItem', position: 3, name: 'Cape Town', item: canonicalURL },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
  },
];
---

<style is:global>
  /* Colour, typography and motion borrowed from /counselling-for-meditators/
     and /mentoring-for-young-men/ so this page reads as part of the same set. */
  .ctc {
    --ctc-warm: hsl(38 30% 84%);
    --ctc-gold: hsl(41 48% 31%);        /* headings and links on light */
    --ctc-gold-deep: hsl(40 52% 26%);   /* small labels on light */
    --ctc-gold-light: hsl(42 54% 57%);  /* gold on deep navy */
    --ctc-navy: hsl(220 22% 12%);
    --ctc-navy-deep: hsl(220 26% 8%);
    --ctc-parch: hsl(36 22% 86%);
  }
  .ctc-warm-bg { background-color: var(--ctc-warm); }

  .ctc-dark { background-color: var(--ctc-navy); color: var(--ctc-parch); }
  .ctc-dark-deep { background-color: var(--ctc-navy-deep); color: var(--ctc-parch); }
  .ctc-dark p, .ctc-dark li, .ctc-dark-deep p { color: hsl(36 20% 86% / 0.84); }
  .ctc-dark .ctc-emph, .ctc-dark-deep .ctc-emph { color: hsl(36 24% 92%); }

  .ctc-gold-text { color: var(--ctc-gold); }
  .ctc-gold-deep-text { color: var(--ctc-gold-deep); }
  .ctc-gold-light-text { color: var(--ctc-gold-light); }
  .ctc-rule { height: 1px; background: linear-gradient(90deg, transparent, var(--ctc-gold), transparent); opacity: 0.5; }
  .ctc-rule-light { height: 1px; background: linear-gradient(90deg, transparent, var(--ctc-gold-light), transparent); opacity: 0.55; }

  /* Pull-quote over a light break: ink serif on a cream scrim */
  .ctc-quote { color: hsl(30 14% 18%); text-shadow: 0 1px 16px hsl(36 30% 96% / 0.6); }
  /* Pull-quote over a dark break: warm gold serif on a navy scrim */
  .ctc-quote-dark { color: var(--ctc-gold-light); text-shadow: 0 2px 30px hsl(220 30% 4% / 0.6); }

  /* One warm grade so the Cape landscapes, the portrait and the room photographs
     read as a single set rather than three different cameras. */
  .ctc-graded img { filter: saturate(0.95) brightness(1.02) contrast(0.99) sepia(0.07); }
  .ctc-graded-dark img { filter: saturate(0.9) brightness(0.92) contrast(1.04) sepia(0.06); }

  .ctc-link {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px; background-repeat: no-repeat; background-position: 0 100%;
    transition: background-size 0.3s ease; padding-bottom: 1px;
  }
  .ctc-link:hover, .ctc-link:focus-visible { background-size: 100% 1px; }

  /* Inline links inside reading columns keep a visible underline. */
  .ctc-inline-link { color: var(--ctc-gold); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: hsl(41 48% 31% / .4); }
  .ctc-inline-link:hover { text-decoration-color: currentColor; }
  .ctc-dark .ctc-inline-link, .ctc-dark-deep .ctc-inline-link { color: var(--ctc-gold-light); text-decoration-color: hsl(42 54% 57% / .45); }

  .ctc-button { background: #D4A95C; color: #0F1422; text-align: center; }
  .ctc-button:hover { background: #E6BE76; }

  .ctc-reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease-out, transform 0.6s ease-out; }
  .ctc-reveal.ctc-in { opacity: 1; transform: none; }

  .ctc-kb-img { animation: ctcKb 26s ease-in-out infinite alternate; transform-origin: center; will-change: transform; }
  @keyframes ctcKb { from { transform: scale(1.03); } to { transform: scale(1.11); } }

  /* Progressive-disclosure card body */
  .ctc-card > .ctc-card-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.3s ease; }
  .ctc-card[open] > .ctc-card-body { grid-template-rows: 1fr; }
  .ctc-card > .ctc-card-body > div { overflow: hidden; }

  .ctc-faq :global(summary) { font-size: 1.0625rem; }
  .ctc-faq :global(details p) { font-size: 1rem; color: hsl(30 12% 25%); }

  .ctc a:focus-visible, .ctc summary:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .ctc :global(#cal-inline-embed) { scroll-margin-top: 88px; }

  @media (prefers-reduced-motion: reduce) {
    .ctc-reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
    .ctc-kb-img { animation: none !important; }
    .ctc-card > .ctc-card-body { transition: none !important; }
    .ctc :global(*) { scroll-behavior: auto; }
  }
</style>

<BaseLayout
  title="In-Person Counselling in Cape Town | Michael Kaplan"
  description="Counselling built around the person rather than a fixed method. Michael Kaplan, ASCHP-registered Wellness Counsellor, in person in Newlands, Cape Town, and online. Free 15-minute fit call."
  canonicalURL={canonicalURL}
  image="/images/og-counselling.jpg"
  jsonLd={jsonLd}
  hideStickyBar={true}
>
  <div class="ctc bg-background text-foreground">

    <!-- ═══ 01 · HERO: Michael as the human centre of the offer ═══ -->
    <section class="ctc-dark-deep">
      <div class="container mx-auto px-6 py-12 md:py-24 lg:py-28 max-w-5xl">
        <div class="grid md:grid-cols-[1fr_auto] gap-8 md:gap-12 lg:gap-16 items-center">

          <div>
            <p class="font-body text-xs sm:text-sm tracking-[0.18em] uppercase text-parchment/60 mb-7">
              Counselling in Cape Town and online
            </p>

            <h1 class="font-heading text-gold-gradient text-[34px] sm:text-5xl md:text-[52px] lg:text-[60px] leading-[1.08] mb-7 md:mb-8">
              Counselling built around the person, not the method.
            </h1>

            <p class="font-body text-lg md:text-xl text-parchment/82 leading-relaxed mb-6 max-w-xl">
              Meaningful counselling begins in a relationship. The work develops around your history, your temperament, what you are facing now, and what you want your life to become, rather than asking you to fit an approach decided in advance.
            </p>

            <div class="flex flex-col sm:flex-row gap-3 mb-4">
              <a href="#book-call" class={primaryButton} data-cta="book-fit-call" data-service={SERVICE} data-placement="hero">Book a free 15-minute fit call</a>
              <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class={ghostButtonDark} data-cta="whatsapp" data-channel="whatsapp" data-service={SERVICE} data-placement="hero">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Message on WhatsApp
              </a>
            </div>
            <p class="font-body text-sm italic text-parchment/60">Free, unhurried, and no obligation to continue.</p>
          </div>

          <div class="flex justify-center md:justify-end">
            <div class="w-full max-w-[240px] sm:max-w-[250px] lg:max-w-[260px]">
              <div class="rounded-xl overflow-hidden border border-parchment/15 shadow-xl shadow-black/30 ctc-graded">
                <div class="aspect-[4/5] overflow-hidden">
                  <Image
                    src={michaelPortrait}
                    alt="Michael Kaplan, ASCHP-registered Wellness Counsellor, who sees clients in Newlands, Cape Town and online"
                    class="w-full h-full object-cover object-center"
                    widths={[400, 520, 640]}
                    sizes="(min-width: 1024px) 260px, (min-width: 640px) 250px, 240px"
                    width={1254}
                    height={1254}
                    loading="eager"
                    fetchpriority="high"
                  />
                </div>
              </div>
              <p class="font-heading text-base text-parchment/90 mt-4">Michael Kaplan</p>
              <p class="ctc-gold-light-text text-[11px] font-body tracking-wide mt-1 leading-snug">BA Psychology &middot; ASCHP-registered Wellness Counsellor (Reg. 10559)</p>
              <p class="font-body text-[11px] text-parchment/60 tracking-wide mt-2 leading-snug">In person in Newlands, Cape Town<br />Online worldwide</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ 01b · CREDIBILITY STRIP ═══ -->
    <section class="ctc-warm-bg border-b border-border/50">
      <div class="container mx-auto px-6 py-14 md:py-20 max-w-5xl ctc-reveal">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 sm:gap-0 text-center sm:text-left sm:divide-x sm:divide-border/70">
          <div class="sm:pr-10 lg:pr-14">
            <p class="font-heading ctc-gold-text text-4xl md:text-5xl lg:text-[52px] leading-none mb-3">10+ Years</p>
            <p class="font-body text-[15px] text-foreground/70 leading-relaxed max-w-[28ch] mx-auto sm:mx-0">of developmental, relational and group work</p>
          </div>
          <div class="sm:px-10 lg:px-14">
            <p class="font-heading ctc-gold-text text-3xl md:text-4xl lg:text-[42px] leading-tight mb-3">BA Psychology</p>
            <p class="font-body text-[15px] text-foreground/70 leading-relaxed max-w-[28ch] mx-auto sm:mx-0">and registration as a Wellness Counsellor with the ASCHP (Reg. 10559)</p>
          </div>
          <div class="sm:pl-10 lg:pl-14">
            <p class="font-heading ctc-gold-text text-3xl md:text-4xl lg:text-[42px] leading-tight mb-3">Newlands &amp; Online</p>
            <p class="font-body text-[15px] text-foreground/70 leading-relaxed max-w-[28ch] mx-auto sm:mx-0">in person in Cape Town's Southern Suburbs, or by video call from anywhere</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 02 · A RELATIONSHIP IN WHICH CHANGE CAN HAPPEN ═══ -->
    <section id="the-work" class="bg-background">
      <div class="container mx-auto px-6 py-20 md:py-28 max-w-3xl ctc-reveal">
        <h2 class="font-heading ctc-gold-text text-3xl md:text-4xl lg:text-[44px] leading-tight mb-10">A relationship in which change can happen</h2>

        <div class="font-body text-lg text-foreground/78 leading-relaxed space-y-7 max-w-[65ch]">
          <p>There are many schools of counselling and psychotherapy, each with its own theories, techniques and ways of understanding people. Those differences matter. But underneath them sits something more fundamental: the relationship between the person seeking help and the person sitting across from them. Across decades of psychotherapy research, the quality of that therapeutic alliance has <a href={ALLIANCE_META_ANALYSIS} target="_blank" rel="noopener noreferrer" class="ctc-inline-link">repeatedly been associated with better outcomes</a> across very different forms of treatment.</p>

          <p>That makes intuitive sense. It is difficult to explore the parts of ourselves we usually keep hidden in a relationship where we do not feel safe. It is difficult to be challenged by someone we do not trust. And it is difficult for another person to understand what might genuinely help us if they have not first taken the time to understand who we are.</p>

          <p>So I do not treat the relationship as the setting in which counselling techniques are delivered. It is part of the work itself. A good counselling relationship gives you somewhere to slow things down, notice what keeps happening, say something you have never quite managed to put into words, and test assumptions you have carried for years. It is where you might discover that you have been avoiding yourself in one particular place, or that what you actually need is more patience rather than another strategy. Over time it can become a relationship in which it is possible to be known more honestly.</p>
        </div>

        <blockquote class="mt-12 md:mt-14 border-l-2 border-primary/50 pl-7 md:pl-8">
          <p class="font-heading ctc-gold-text text-[26px] md:text-[32px] italic leading-snug max-w-[32ch]">The relationship is not only the container the work happens in. A good deal of the time, it is the work.</p>
        </blockquote>
      </div>
    </section>

    <!-- ═══ BREAK 01 · Table Mountain in cloud ═══ -->
    <section class="relative overflow-hidden ctc-graded">
      <Image src={capeTableMountain} alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover object-[center_55%] ctc-kb-img" widths={[640, 1024, 1600]} quality={60} sizes="100vw" loading="lazy" />
      <!-- Lighter scrim than the meditators page uses: these Cape photographs are
           pale to begin with, so the cream veil there would erase them entirely.
           The quote keeps its contrast from the band behind the text. -->
      <div class="absolute inset-0" style="background: linear-gradient(180deg, hsl(36 18% 90% / 0.7), hsl(36 18% 90% / 0.5) 50%, hsl(36 18% 90% / 0.7));"></div>
      <div class="absolute inset-0" style="background: radial-gradient(70% 52% at 50% 50%, hsl(36 20% 92% / 0.72), transparent 72%);"></div>
      <div class="relative z-10 container mx-auto px-6 py-28 md:py-44 max-w-3xl text-center ctc-reveal">
        <div class="ctc-rule w-16 mx-auto mb-8"></div>
        <p class="font-heading ctc-quote text-2xl sm:text-3xl md:text-4xl italic leading-relaxed">Change begins differently when you no longer have to work everything out alone.</p>
      </div>
    </section>

    <!-- ═══ 03 · PEOPLE ARE NOT PROBLEMS TO WHICH METHODS ARE APPLIED ═══ -->
    <section class="ctc-dark relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(120% 90% at 50% 0%, hsl(42 40% 30% / 0.1), transparent 55%);"></div>
      <div class="relative container mx-auto px-6 py-20 md:py-28 max-w-3xl ctc-reveal">
        <h2 class="font-heading text-gold-gradient text-3xl md:text-4xl lg:text-[44px] leading-tight mb-10">People are not problems to which methods are applied</h2>

        <div class="font-body text-lg leading-relaxed space-y-7 max-w-[65ch]">
          <p>The same approach will not serve every person, and even for the same person, what is useful at one stage of life may be quite wrong at another.</p>

          <p>Sometimes the work needs to be practical. There is a decision to make, a behaviour that needs to change, a boundary that needs to be set, or a pattern that needs to be interrupted before it runs its usual course. Sometimes it is slower than that. Something painful from the past continues to shape relationships, self-worth, or the way you respond to the world, even when you understand intellectually where it came from. Sometimes what is needed is greater awareness of emotion or of the body, or learning to stay with discomfort rather than escaping it immediately. Sometimes it is grief, or identity, or the difficult question of what kind of life you actually want to build.</p>

          <p class="ctc-emph">The interventions used in counselling should serve the person, rather than requiring the person to fit the intervention.</p>

          <p>My approach is therefore integrative and responsive. Psychological reflection, behavioural experiments, mindfulness, attention training, body awareness, journalling, breath practices or structured exercises may each be genuinely useful in the right circumstances. They are tools rather than doctrines, and no interest in contemplative practice is required for any of them. The question is always the same: what would actually be useful here, for this person, at this point in their life?</p>
        </div>

        <p class="mt-10">
          <a href="#book-call" data-cta="book-fit-call" data-service={SERVICE} data-placement="approach" class="ctc-link ctc-gold-light-text font-body text-sm tracking-wide">Book a free 15-minute fit call &rarr;</a>
        </p>
      </div>
    </section>

    <!-- ═══ 04 · MORE THAN A PLACE TO TALK ═══ -->
    <section class="bg-background">
      <div class="container mx-auto px-6 py-20 md:py-28 max-w-3xl ctc-reveal">
        <h2 class="font-heading ctc-gold-text text-3xl md:text-4xl lg:text-[44px] leading-tight mb-10">More than a place to talk</h2>

        <div class="font-body text-lg text-foreground/78 leading-relaxed space-y-7 max-w-[65ch]">
          <p>Counselling is sometimes imagined as little more than having someone listen while you speak. Listening is certainly part of it, but a working counselling relationship becomes something more substantial: a place where another person comes to know you well enough to recognise recurring patterns, remember what mattered months ago, notice when an old difficulty is appearing in a new form, and help you look at what is happening without rushing to explain it away.</p>

          <p>That relationship should be supportive, though support does not mean agreement. At times it means helping you make sense of something painful or confusing. At other times it means asking a question you would rather avoid, pointing out a contradiction, or helping you stay with something long enough to understand it properly. Much of the value lies in having a relationship warm enough to feel safe and boundaried enough to allow honesty.</p>

          <p>Some of the patterns people struggle with elsewhere in their lives also begin to appear, often quietly, inside counselling itself. A tendency to please, to withdraw, to avoid disagreement, to hide uncertainty, to distrust care, to over-explain, or to struggle to ask directly for what is needed may all become visible between counsellor and client. Because that relationship has clearer boundaries and fewer of the usual social stakes, it can be a relatively safe place to notice such patterns and experiment with something different. In that sense counselling is not only somewhere to talk about relationships. It is a relationship in which new ways of relating can be practised.</p>

          <p>None of this means that one person holds the answers and the other gradually learns to accept them. The work is better understood as an alliance: two people paying careful attention to one life, from different positions. My responsibility is to listen closely, remember what matters, notice patterns and contradictions, ask questions that open things up rather than close them down, and challenge you where challenge is more useful than reassurance. The direction of the work stays yours. I cannot decide what a meaningful life should look like for you, and I would not want to.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 05 · WHAT MIGHT BRING YOU HERE ═══ -->
    <section class="ctc-warm-bg">
      <div class="container mx-auto px-6 py-20 md:py-28 max-w-4xl ctc-reveal">
        <h2 class="font-heading ctc-gold-text text-3xl md:text-4xl lg:text-[44px] leading-tight mb-8">What might bring you here</h2>

        <div class="font-body text-lg text-foreground/78 leading-relaxed space-y-7 max-w-[65ch] mb-4">
          <p>People do not always arrive in counselling with a diagnosis or a neatly defined problem. Often the starting point is simply a growing sense that something is not working as well as it could, and a suspicion that it will not resolve on its own.</p>
        </div>
        <p class="font-body text-sm text-foreground/60 italic mb-10">Select any that feels familiar to read more.</p>

        <div class="grid md:grid-cols-2 gap-4 mb-12">
          {startingPoints.map((item) => (
            <details class="ctc-card group rounded-xl border border-border/60 bg-background/70 hover:border-primary/40 hover:shadow-md hover:shadow-black/5 transition-all duration-300">
              <summary class="flex items-start justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <span class="font-heading text-lg text-foreground/90 leading-snug">{item.head}</span>
                <svg class="w-4 h-4 shrink-0 mt-1.5 ctc-gold-text transition-transform duration-200 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
              </summary>
              <div class="ctc-card-body"><div class="px-6 pb-5"><p class="font-body text-base text-foreground/72 leading-relaxed">{item.body}</p></div></div>
            </details>
          ))}
        </div>

        <div class="font-body text-lg text-foreground/78 leading-relaxed space-y-7 max-w-[65ch]">
          <p>Counselling does not have to begin with something being badly wrong. It can just as well begin with the recognition that life could be more honest, more connected and more your own than it currently feels. You do not need to arrive with a precise explanation either. Part of the first conversation is working out what actually needs attention.</p>
        </div>
      </div>
    </section>

    <!-- ═══ BREAK 02 · mist on the mountain ═══ -->
    <section class="relative overflow-hidden ctc-graded">
      <Image src={capeMountainMist} alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover object-[center_60%] ctc-kb-img" widths={[640, 1024, 1600]} quality={60} sizes="100vw" loading="lazy" />
      <div class="absolute inset-0" style="background: linear-gradient(180deg, hsl(36 18% 90% / 0.72), hsl(36 18% 90% / 0.52) 50%, hsl(36 18% 90% / 0.72));"></div>
      <div class="absolute inset-0" style="background: radial-gradient(70% 52% at 50% 50%, hsl(36 20% 92% / 0.7), transparent 72%);"></div>
      <div class="relative z-10 container mx-auto px-6 py-28 md:py-44 max-w-3xl text-center ctc-reveal">
        <div class="ctc-rule w-16 mx-auto mb-8"></div>
        <p class="font-heading ctc-quote text-2xl sm:text-3xl md:text-4xl italic leading-relaxed">The aim is not simply to feel better in the room. It is to build a life outside it that you are increasingly glad to wake up to.</p>
      </div>
