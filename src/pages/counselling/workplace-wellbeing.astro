---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import CtaPair from '../../components/CtaPair.astro';
import StickyConsultationCTA from '../../components/StickyConsultationCTA.astro';
import OrganisationEnquiryForm from '../../components/OrganisationEnquiryForm.astro';
import { Image } from 'astro:assets';

// ── Michael, and the Newlands consulting room ──────────────────────────────
// The room matters here: the proposal offers selected weekday evenings and
// Saturday mornings in Newlands alongside online sessions, so employees can
// see where in-person appointments would actually happen.
import michaelPortrait from '../../assets/michael-portrait-new.jpg';
import michaelSeated from '../../assets/Michael-portrait-2.PNG';
import roomChairs from '../../assets/counselling-cape-town-chairs.webp';
import roomGarden from '../../assets/counselling-cape-town-garden.webp';

// ── Landscape dividers ─────────────────────────────────────────────────────
// From the existing Sangham library. Deliberately no office photography: the
// subject of this page is people, not workplaces.
import stillWater from '../../assets/river-sunrise.jpg';
import coastTwilight from '../../assets/twilight-coast.jpg';
import duskLake from '../../assets/mountain-lake.jpg';

// ── Section backgrounds ────────────────────────────────────────────────────
// Carried under a heavy scrim, in the same idiom /counselling/ uses for its
// approach section. Landscape rather than workplace: the subject of this page
// is the person, and an office photograph would say the opposite.
import heroTexture from '../../assets/above-clouds.jpg';
import supportTexture from '../../assets/ancient-tree.jpg';
import michaelTexture from '../../assets/majestic-landscape-hills-and-clouds.JPG';
import closingTexture from '../../assets/mountain-sunrise.jpg';

const canonicalURL = 'https://www.sangham.org/counselling/workplace-wellbeing/';

const EMAIL = 'michael@sangham.org';
const MAILTO = `mailto:${EMAIL}?subject=${encodeURIComponent(
  'Corporate counselling and workplace wellbeing enquiry'
)}&body=${encodeURIComponent(
  'Hello Michael,\n\nWe are looking into counselling and wellbeing support for our team.\n\nA little about us:\n- Organisation:\n- Roughly how many employees:\n- Location, and whether online or in person suits better:\n- What has prompted this:\n\nI would be glad to arrange a conversation.\n\n'
)}`;
const WHATSAPP_NUMBER = '27736738063';
const WHATSAPP = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
  'Hi Michael, I came across the workplace wellbeing page and wanted to ask about counselling support for our team.'
)}`;

const SERVICE = 'workplace-wellbeing';
const CTA_ID = 'organisation-enquiry';

const primaryButton =
  'cww-button inline-flex items-center justify-center px-8 py-4 rounded-lg text-sm tracking-wider uppercase font-body font-medium transition-colors duration-200';

const howItWorks = [
  {
    num: '01',
    title: 'The company funds access',
    text: 'An agreed allocation of counselling sessions is purchased for eligible employees. The organisation decides the size of the pool and who may draw on it.',
  },
  {
    num: '02',
    title: 'Employees book directly',
    text: 'Employees contact Sangham themselves, so access stays private, simple, and independent of management.',
  },
  {
    num: '03',
    title: 'Counselling stays confidential',
    text: 'Session content is not reported back to the employer, except with the employee’s consent or where a recognised safety or legal exception applies.',
  },
  {
    num: '04',
    title: 'Organisational work is added where it belongs',
    text: 'Workshops, group sessions and facilitated conversations can be added where the difficulty sits with the team rather than with one person.',
  },
];

// Shown directly under the three boundaries, so a reader can place their own
// organisation before reading any further.
const designedFor = [
  'Small and medium businesses',
  'Professional practices',
  'NGOs and non-profits',
  'Agencies and studios',
  'Growing teams',
];

const notThis = [
  {
    head: 'Not a full EAP',
    body: 'This is an independent counselling and workplace wellbeing service, not a 24-hour employee assistance programme or an emergency response service.',
  },
  {
    head: 'Not performance management',
    body: 'Counselling is not used to judge quotas, discipline employees, or supply management with private clinical information.',
  },
  {
    head: 'Not clinical diagnosis',
    body: 'Where psychiatric diagnosis, specialised treatment, emergency care or formal assessment is required, referral is made to an appropriate professional.',
  },
];

const individualAreas = [
  'Stress and emotional strain',
  'Anxiety',
  'Grief and loss',
  'Relationship difficulties',
  'Life transitions and adjustment',
  'Recurring patterns',
  'Motivation',
  'Workplace conflict',
  'Boundaries and difficult conversations',
];

const facilitatedFocus = [
  {
    head: 'Communication and difficult conversations',
    body: 'Where something needs to be said, has not been said, and the cost of the silence is starting to show in the work.',
  },
  {
    head: 'Interpersonal conflict',
    body: 'Where a tension between colleagues has settled into a pattern that neither party can now step out of alone.',
  },
  {
    head: 'Trust and psychological safety',
    body: 'Where people have learned that raising a concern is not worth what it costs them, and have quietly stopped raising them.',
  },
  {
    head: 'Stress and burnout awareness',
    body: 'Where overload has become the normal operating state, and nobody is noticing it early enough to act on.',
  },
];

const workshops = [
  {
    head: 'Workplace communication',
    body: 'Listening, feedback and repair: what makes a difficult conversation usable rather than merely survivable.',
  },
  {
    head: 'Stress and self-regulation',
    body: 'Recognising overload earlier, and practical ways to pause and respond with more awareness.',
  },
  {
    head: 'Connection and team culture',
    body: 'Healthier ways of relating, and what it takes for a team to repair after tension rather than route around it.',
  },
  {
    head: 'Change and transition',
    body: 'Navigating uncertainty together, and what people need from one another while the ground is moving.',
  },
];

const outcomes = [
  {
    head: 'Earlier support',
    body: 'A low-friction route to support before stress or personal difficulty becomes more entrenched.',
  },
  {
    head: 'Healthier communication',
    body: 'More capacity to name concerns, listen, set boundaries, and approach difficult conversations constructively.',
  },
  {
    head: 'Self-regulation',
    body: 'Practical ways to recognise overload, pause, and respond with greater awareness.',
  },
  {
    head: 'Stronger team culture',
    body: 'Shared sessions can strengthen empathy, mutual support, and the ability to repair after tension. Over time, asking for help becomes more ordinary than exceptional.',
  },
];

// Rates as set out in the 2026 corporate proposal. Any change here should be
// made against that document rather than adjusted in isolation.
const fees = [
  {
    label: 'Individual session',
    price: 'R850',
    unit: '60 minutes',
    note: 'Online, or in person in Newlands where available.',
  },
  {
    label: 'Five-session package',
    price: 'R3,400',
    unit: 'total, at R680 a session',
    note: 'A contained piece of work at a lower rate per session.',
  },
  {
    label: 'Corporate counselling pool',
    price: 'R680',
    unit: 'per session, from 5 prepaid',
    note: 'Non-refundable, and valid for 12 months from purchase.',
    featured: true,
  },
  {
    label: 'Focused facilitated session',
    price: 'From R1,750',
    unit: '60 to 90 minutes',
    note: 'A small team or a specific workplace issue.',
  },
  {
    label: 'Three-hour workshop',
    price: 'R5,500',
    unit: 'up to 20 participants',
    note: 'Preparation included.',
  },
  {
    label: 'Half-day workshop',
    price: 'R7,500',
    unit: 'up to 20 participants',
    note: 'Approximately four hours, preparation included.',
  },
];

const appropriate = [
  'Total sessions used and remaining',
  'Service uptake at an aggregate level',
  'Agreed attendance confirmation, where genuinely necessary and consented to',
  'Broad non-identifying organisational themes, where anonymity is realistic',
  'Recommendations for workshops, manager training or systemic support',
];

const notAppropriate = [
  'Counselling notes or detailed session content',
  'Diagnosis or psychiatric opinion',
  'Whether an employee is telling the truth',
  'Performance, disciplinary or fitness-for-duty conclusions',
  'Personal histories, or judgments about an employee’s character',
];

const faqItems = [
  {
    q: 'Can employees use sessions for something unrelated to work?',
    a: 'Yes, and most do. Stress, grief, anxiety, relationship difficulties and life transitions do not stay neatly outside the office, and an employee is not required to justify their reason for attending to anyone.',
  },
  {
    q: 'What happens if someone needs more support than the allocation covers?',
    a: 'The pool can be extended, or the employee can continue privately at the standard session rate. Where the need is for specialist care rather than more sessions, referral is made to an appropriate professional. Nobody is left without a next step because an allocation ran out.',
  },
  {
    q: 'Can you guarantee an improvement in productivity?',
    a: 'No, and it would be worth being sceptical of any provider who does. Counselling supports the person. What it can reasonably aim at is earlier support, better communication, and more capacity for reflection, all of which tend to help how a workplace functions.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${canonicalURL}#service`,
    name: 'Corporate Counselling and Workplace Wellbeing',
    url: canonicalURL,
    description:
      'A workplace wellbeing partnership combining confidential one-to-one counselling for employees with facilitated team sessions and practical workshops. The employer funds access; the employee remains the counselling client.',
    serviceType: 'Corporate Counselling and Workplace Wellbeing',
    provider: { '@id': 'https://www.sangham.org/about/#michael-kaplan' },
    areaServed: [
      { '@type': 'City', name: 'Cape Town' },
      { '@type': 'Country', name: 'South Africa' },
    ],
    audience: { '@type': 'Audience', audienceType: 'Employers and organisations' },
    availableChannel: [
      { '@type': 'ServiceChannel', serviceUrl: canonicalURL, availableLanguage: 'English' },
      {
        '@type': 'ServiceChannel',
        serviceUrl: canonicalURL,
        serviceLocation: { '@type': 'Place', name: 'Newlands, Southern Suburbs, Cape Town' },
        availableLanguage: 'English',
      },
    ],
    offers: [
      { '@type': 'Offer', name: 'Individual Session', price: '850', priceCurrency: 'ZAR', description: 'A 60-minute counselling session, online or in person where available.' },
      { '@type': 'Offer', name: 'Five-Session Package', price: '3400', priceCurrency: 'ZAR', description: 'Five 60-minute sessions paid in advance, which works out at R680 a session.' },
      { '@type': 'Offer', name: 'Corporate Counselling Pool', price: '680', priceCurrency: 'ZAR', description: 'Per session, from five prepaid sessions. Non-refundable and valid for 12 months.' },
      { '@type': 'Offer', name: 'Focused Facilitated Session', price: '1750', priceCurrency: 'ZAR', description: 'From R1,750 for a 60 to 90 minute facilitated session on a small-team or workplace issue.' },
      { '@type': 'Offer', name: 'Three-Hour Workplace Workshop', price: '5500', priceCurrency: 'ZAR', description: 'Up to 20 participants, preparation included.' },
      { '@type': 'Offer', name: 'Half-Day Workshop', price: '7500', priceCurrency: 'ZAR', description: 'Approximately four hours for up to 20 participants, preparation included.' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.sangham.org/' },
      { '@type': 'ListItem', position: 2, name: 'Counselling', item: 'https://www.sangham.org/counselling/' },
      { '@type': 'ListItem', position: 3, name: 'Workplace Wellbeing', item: canonicalURL },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<style is:global>
  /* Same colour, typography and motion vocabulary as /counselling/cape-town/,
     so a commercially framed page still reads as a Sangham counselling page
     rather than as an HR consultancy bolted onto the side of the site. */
  .cww {
    --cww-warm: hsl(38 30% 84%);
    --cww-gold: hsl(41 48% 31%);
    --cww-gold-deep: hsl(40 52% 26%);
    --cww-gold-light: hsl(42 54% 57%);
    --cww-navy: hsl(220 22% 12%);
    --cww-navy-deep: hsl(220 26% 8%);
    --cww-parch: hsl(36 22% 86%);
  }
  .cww-warm-bg { background-color: var(--cww-warm); }

  .cww-dark { background-color: var(--cww-navy); color: var(--cww-parch); }
  .cww-dark-deep { background-color: var(--cww-navy-deep); color: var(--cww-parch); }
  .cww-dark p, .cww-dark li, .cww-dark-deep p, .cww-dark-deep li { color: hsl(36 20% 86% / 0.84); }
  .cww-dark .cww-emph, .cww-dark-deep .cww-emph { color: hsl(36 24% 92%); }

  .cww-gold-text { color: var(--cww-gold); }
  .cww-gold-deep-text { color: var(--cww-gold-deep); }
  .cww-gold-light-text { color: var(--cww-gold-light); }
  .cww-rule { height: 1px; background: linear-gradient(90deg, transparent, var(--cww-gold), transparent); opacity: 0.5; }
  .cww-rule-light { height: 1px; background: linear-gradient(90deg, transparent, var(--cww-gold-light), transparent); opacity: 0.55; }

  .cww-quote { color: hsl(30 14% 16%); text-shadow: 0 1px 10px hsl(36 30% 96% / 0.92), 0 2px 26px hsl(36 30% 96% / 0.75); }
  .cww-quote-dark { color: var(--cww-gold-light); text-shadow: 0 2px 30px hsl(220 30% 4% / 0.75); }

  .cww-graded img { filter: saturate(0.95) brightness(1.02) contrast(0.99) sepia(0.07); }
  .cww-graded-dark img { filter: saturate(0.9) brightness(0.92) contrast(1.04) sepia(0.06); }

  .cww-link {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px; background-repeat: no-repeat; background-position: 0 100%;
    transition: background-size 0.3s ease; padding-bottom: 1px;
  }
  .cww-link:hover, .cww-link:focus-visible { background-size: 100% 1px; }

  .cww-inline-link { color: var(--cww-gold); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: hsl(41 48% 31% / .4); }
  .cww-inline-link:hover { text-decoration-color: currentColor; }
  .cww-dark .cww-inline-link, .cww-dark-deep .cww-inline-link { color: var(--cww-gold-light); text-decoration-color: hsl(42 54% 57% / .45); }

  .cww-button { background: #D4A95C; color: #0F1422; text-align: center; }
  .cww-button:hover { background: #E6BE76; }

  .cww-reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease-out, transform 0.6s ease-out; }
  .cww-reveal.cww-in { opacity: 1; transform: none; }

  .cww-kb-img { animation: cwwKb 26s ease-in-out infinite alternate; transform-origin: center; will-change: transform; }
  @keyframes cwwKb { from { transform: scale(1.03); } to { transform: scale(1.11); } }

  .cww-card > .cww-card-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.3s ease; }
  .cww-card[open] > .cww-card-body { grid-template-rows: 1fr; }
  .cww-card > .cww-card-body > div { overflow: hidden; }

  @media (min-width: 1024px) {
    .cww-aside { position: sticky; top: 7rem; }
  }

  .cww-faq :global(summary) { font-size: 1.0625rem; }
  .cww-faq :global(details p) { font-size: 1rem; color: hsl(30 12% 25%); }

  .cww a:focus-visible, .cww summary:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }

  @media (prefers-reduced-motion: reduce) {
    .cww-reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
    .cww-kb-img { animation: none !important; }
    .cww-card > .cww-card-body { transition: none !important; }
    .cww :global(*) { scroll-behavior: auto; }
  }
</style>

<BaseLayout
  title="Corporate Counselling and Workplace Wellbeing in Cape Town"
  description="Confidential counselling for employees, facilitated team sessions and workplace workshops, from Michael Kaplan, ASCHP-registered Wellness Counsellor. The employer funds access; the employee remains the client. Cape Town and online, with published rates."
  canonicalURL={canonicalURL}
  image="/images/og-counselling.jpg"
  jsonLd={jsonLd}
  hideStickyBar={true}
>
  <div class="cww bg-background text-foreground">

    <!-- ═══ 01 · HERO ═══ -->
    <section class="cww-dark-deep relative overflow-hidden">
      <Image
        src={heroTexture}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover object-[center_65%]"
        widths={[640, 1024, 1600]}
        quality={60}
        sizes="100vw"
        loading="eager"
      />
      <div class="absolute inset-0 bg-void/[0.91]"></div>
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(120% 100% at 30% 0%, hsl(42 40% 30% / 0.14), transparent 60%);"></div>
      <div class="relative z-10 container mx-auto px-6 py-12 md:py-24 lg:py-28 max-w-5xl">
        <div class="grid md:grid-cols-[1fr_auto] gap-8 md:gap-12 lg:gap-16 items-center">

          <div>
            <p class="font-body text-xs sm:text-sm tracking-[0.18em] uppercase text-parchment/60 mb-7">
              Corporate counselling and workplace wellbeing &middot; Cape Town and online
            </p>

            <h1 class="font-heading text-gold-gradient text-[34px] sm:text-5xl md:text-[52px] lg:text-[60px] leading-[1.08] mb-7 md:mb-8">
              Support the person. Strengthen the workplace.
            </h1>

            <p class="font-body text-lg md:text-xl text-parchment/82 leading-relaxed mb-5 max-w-xl">
              Confidential one-to-one counselling for employees, with facilitated team sessions and practical workshops where the difficulty belongs to the group rather than to one person.
            </p>
            <p class="font-body text-base text-parchment/70 leading-relaxed mb-8 max-w-xl">
              The employer funds access without becoming part of the counselling room. That distinction is what makes the support worth having.
            </p>

            <CtaPair
              tone="dark"
              placement="hero"
              service={SERVICE}
              href={MAILTO}
              primaryLabel="Discuss a partnership"
              primaryCta={CTA_ID}
              primaryChannel="email"
              whatsappHref={WHATSAPP}
              whatsappLabel="Ask a question on WhatsApp"
              note="Rates are published further down this page. A partnership begins with a short conversation."
            />
          </div>

          <div class="flex justify-center md:justify-end">
            <div class="w-full max-w-[240px] sm:max-w-[250px] lg:max-w-[260px]">
              <div class="rounded-xl overflow-hidden border border-parchment/15 shadow-xl shadow-black/30 cww-graded">
                <div class="aspect-[4/5] overflow-hidden">
                  <Image
                    src={michaelPortrait}
                    alt="Michael Kaplan, ASCHP-registered Wellness Counsellor, who provides counselling for employees online and in Newlands, Cape Town"
                    class="w-full h-full object-cover object-center"
                    widths={[400, 520, 640]}
                    sizes="(min-width: 1024px) 260px, (min-width: 640px) 250px, 240px"
                    width={1254}
                    height={1254}
                    loading="eager"
                    fetchpriority="high"
                  />
                </div>
              </div>
              <p class="font-heading text-base text-parchment/90 mt-4">Michael Kaplan</p>
              <p class="cww-gold-light-text text-[11px] font-body tracking-wide mt-1 leading-snug">BA Psychology &middot; ASCHP-registered Wellness Counsellor (Reg. 10559)</p>
              <p class="font-body text-[11px] text-parchment/60 tracking-wide mt-2 leading-snug">Online during working hours<br />In person in Newlands, Cape Town</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ 02 · THE THREE BOUNDARIES THAT MAKE IT WORK ═══ -->
    <section class="cww-warm-bg border-b border-border/50">
      <div class="container mx-auto px-6 py-14 md:py-20 max-w-5xl cww-reveal">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 sm:gap-0 text-center sm:text-left sm:divide-x sm:divide-border/70">
          <div class="sm:pr-10 lg:pr-14">
            <p class="font-heading cww-gold-text text-2xl md:text-3xl lg:text-[32px] leading-tight mb-3">The employer funds</p>
            <p class="font-body text-[15px] text-foreground/70 leading-relaxed max-w-[30ch] mx-auto sm:mx-0">an agreed pool of sessions, sized to the organisation and topped up as it is used</p>
          </div>
          <div class="sm:px-10 lg:px-14">
            <p class="font-heading cww-gold-text text-2xl md:text-3xl lg:text-[32px] leading-tight mb-3">The employee is the client</p>
            <p class="font-body text-[15px] text-foreground/70 leading-relaxed max-w-[30ch] mx-auto sm:mx-0">booking directly, without explaining the reason to anyone at work</p>
          </div>
          <div class="sm:pl-10 lg:pl-14">
            <p class="font-heading cww-gold-text text-2xl md:text-3xl lg:text-[32px] leading-tight mb-3">The content stays private</p>
            <p class="font-body text-[15px] text-foreground/70 leading-relaxed max-w-[30ch] mx-auto sm:mx-0">with utilisation reported, and session material not reported at all</p>
          </div>
        </div>

        <div class="mt-12 pt-8 border-t border-border/50">
          <p class="cww-gold-deep-text font-body text-xs tracking-[0.14em] uppercase mb-5 text-center">Designed for</p>
          <ul class="flex flex-wrap justify-center gap-x-3 gap-y-3 mb-5">
            {designedFor.map((item) => (
              <li class="font-body text-[15px] text-foreground/78 border border-border/70 rounded-full px-4 py-1.5 bg-background/60">{item}</li>
            ))}
          </ul>
          <p class="font-body text-[15px] text-foreground/70 leading-relaxed text-center max-w-[58ch] mx-auto">
            Organisations that want confidential support in place for their people without commissioning a full traditional employee assistance programme.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ 03 · THE IDEA BEHIND THE PARTNERSHIP ═══ -->
    <section id="the-partnership" class="bg-background">
      <div class="container mx-auto px-6 py-20 md:py-28 max-w-5xl cww-reveal">
        <div class="grid lg:grid-cols-[1fr_1.7fr] gap-10 lg:gap-16">

          <div>
            <h2 class="font-heading cww-gold-text text-3xl md:text-4xl lg:text-[42px] leading-tight mb-8">The idea behind the partnership</h2>
            <div class="cww-aside hidden lg:block border-l-2 border-primary/40 pl-6">
              <p class="font-heading cww-gold-text text-[22px] italic leading-snug">The aim is not simply to help people cope. It is to create more capacity for reflection, communication and constructive action.</p>
            </div>
          </div>

          <div class="font-body text-lg text-foreground/78 leading-relaxed space-y-7 max-w-[65ch]">
            <p>Workplace wellbeing is not only about what happens when somebody reaches breaking point.</p>

            <p>Stress, grief, relationship difficulties, anxiety, conflict and life transitions do not stay neatly outside the office. When people are struggling, concentration, motivation, communication and relationships at work are all affected, usually well before anyone names the problem out loud.</p>

            <p>Sangham offers employees a confidential place to work through what is happening before it becomes more entrenched. The employer funds that access. The employee remains the counselling client, and the content of their sessions stays between them and the counsellor.</p>

            <p>Alongside individual support, an organisation can add carefully designed group sessions and workshops focused on communication, stress, emotional awareness, conflict, trust and healthier team functioning. Not every workplace difficulty is one person’s private problem, and treating it as one tends to leave the actual pattern in place.</p>

            <p class="text-base text-foreground/72">A partnership can begin simply, with a pool of counselling sessions, and expand into team development, facilitated conversations or focused workshops where that turns out to be useful.</p>

            <blockquote class="lg:hidden border-l-2 border-primary/40 pl-6 pt-1">
              <p class="font-heading cww-gold-text text-[22px] md:text-2xl italic leading-snug">The aim is not simply to help people cope. It is to create more capacity for reflection, communication and constructive action.</p>
            </blockquote>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ 04 · HOW SUPPORT WORKS ═══ -->
    <section class="cww-dark relative overflow-hidden">
      <Image src={supportTexture} alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover object-[center_50%]" widths={[640, 1024, 1600]} quality={58} sizes="100vw" loading="lazy" />
      <!-- Heavier than the other section scrims: this photograph is bright, and
           its vertical trunks otherwise compete with the numbered list rules. -->
      <div class="absolute inset-0 bg-cosmos/[0.93]"></div>
