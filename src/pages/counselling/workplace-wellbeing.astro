    <!-- ═══ 07 · CONFIDENTIALITY AND REPORTING ═══ -->
    <section id="confidentiality" class="bg-background scroll-mt-[88px]">
      <div class="container mx-auto px-6 py-20 md:py-28 max-w-4xl cww-reveal">
        <p class="cww-gold-deep-text font-body text-xs tracking-[0.14em] uppercase mb-5">Boundaries</p>
        <h2 class="font-heading cww-gold-text text-3xl md:text-4xl lg:text-[44px] leading-tight mb-7">Useful information for the employer, without turning counselling into surveillance</h2>

        <p class="font-body text-lg text-foreground/78 leading-relaxed max-w-[65ch] mb-12">
          An employer can reasonably know how many sessions have been funded and used, and can receive carefully aggregated observations where the numbers are large enough to protect identity. What an employer does not automatically receive is anything about a particular person.
        </p>

        <div class="grid md:grid-cols-2 gap-5 mb-12">
