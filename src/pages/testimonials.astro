---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import {
  getPublishedTestimonials,
  getTestimonialsByCategory,
  testimonialsJsonLd,
} from '../data/testimonials';

import ancientTree from '../assets/ancient-tree.jpg';
import sanghamCircle from '../assets/sangham-circle.jpg';

const canonicalURL = 'https://www.sangham.org/testimonials/';

// Every reflection on this page comes from src/content/testimonials/.
// Adding a person there places them here automatically; see docs/testimonials.md.
const all = await getPublishedTestimonials();

const featured = all.find((item) => item.data.featured);
const { Content: FeaturedStory } = featured
  ? await render(featured)
  : { Content: null };

const individualWork = await getTestimonialsByCategory('individual-work');
const community = await getTestimonialsByCategory('community');
// The featured story already appears in full above, so it is not repeated here.
const workshops = (await getTestimonialsByCategory('workshops')).filter(
  (item) => item.id !== featured?.id,
);

const reference = (await getTestimonialsByCategory('professional-reference'))[0];
const { Content: ReferenceLetter } = reference
  ? await render(reference)
  : { Content: null };

const startingPoints = [
  {
    href: '/counselling',
    label: 'Counselling',
    note: 'One-on-one work for adults, online.',
  },
  {
    href: '/counselling-for-meditators',
    label: 'Counselling for meditators',
    note: 'For people making sense of what practice has opened.',
  },
  {
    href: '/mentoring-for-adolescents',
    label: 'Mentoring for teenagers',
    note: 'Long-form mentorship for boys aged 12 to 17.',
  },
  {
    href: '/mentoring-for-young-men',
    label: 'Mentoring for young men',
    note: 'For men aged 18 to 25 finding their direction.',
  },
  {
    href: '/workshops',
    label: 'Workshops',
    note: 'Occasional small group sessions and immersions.',
  },
  {
    href: '/contact',
    label: 'Get in touch',
    note: 'A free 15-minute fit call, or a message first.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.sangham.org/' },
      { '@type': 'ListItem', position: 2, name: 'Reflections', item: canonicalURL },
    ],
  },
  ...testimonialsJsonLd(all),
];
---

<BaseLayout
  title="Reflections from People Who Have Worked with Michael"
  description="Reflections from people who have encountered this work through counselling, mentorship, workshops, community practice, and professional collaboration. Shared with permission."
  canonicalURL={canonicalURL}
  image="/images/og-testimonials.jpg"
  jsonLd={jsonLd}
  hideStickyBar={true}
>

  <!-- ═══ HERO ═══ -->
  <section class="relative overflow-hidden -mt-[72px] pt-[72px]">
    <Image
      src={ancientTree}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-center"
      widths={[768, 1280, 1600]}
      sizes="100vw"
      quality={70}
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-void/78"></div>
    <div class="relative z-10 container mx-auto px-6 py-24 md:py-32 max-w-3xl text-center">
      <p class="font-body text-xs tracking-[0.2em] uppercase text-primary/60 mb-6">Reflections</p>
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-gold-gradient leading-tight mb-7">
        Reflections from people who have worked with Michael
      </h1>
      <div class="divider-gold w-24 mx-auto"></div>
    </div>
  </section>

  <!-- ═══ OPENING ═══ -->
  <section class="bg-background">
    <div class="container mx-auto px-6 py-20 md:py-24 max-w-2xl t-reveal">
      <div class="font-body text-lg text-foreground/78 leading-relaxed space-y-6">
        <p>
          What follows are reflections from people who have encountered this work in
          different ways: through counselling, through mentorship carried over years,
          through workshops and group process, through ordinary community life, and
          through professional collaboration.
        </p>
        <p>
          They are not outcome claims, and they are not offered as evidence that this
          work will do anything in particular for you. They are individual accounts,
          written by the people whose names appear beneath them, describing their own
          experience.
        </p>
      </div>
      <p class="font-body text-sm text-muted-foreground/70 italic mt-9 pt-7 border-t border-border/60">
        Shared with permission. Some identifying details have been limited to protect privacy.
      </p>
    </div>
  </section>

  {featured && (
    <!-- ═══ FEATURED STORY ═══ -->
    <section id="featured-story" class="bg-header text-header-foreground scroll-mt-[72px]">
      <div class="container mx-auto px-6 py-20 md:py-28 max-w-5xl t-reveal">

        <div class="grid lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] gap-10 lg:gap-16 items-start">

          <div class="lg:sticky lg:top-[96px]">
            {featured.data.portrait && (
              <figure>
                <div class="aspect-[4/5] sm:aspect-[3/4] lg:aspect-[4/5] overflow-hidden rounded-xl shadow-xl shadow-black/30">
                  <Image
                    src={featured.data.portrait}
                    alt={featured.data.portraitAlt ?? featured.data.name}
                    class="w-full h-full object-cover"
                    style={`object-position: ${featured.data.portraitPosition};`}
                    widths={[400, 640, 853]}
                    sizes="(min-width: 1024px) 38vw, 100vw"
                    loading="lazy"
                  />
                </div>
                <figcaption class="mt-5">
                  <p class="font-heading text-2xl text-header-foreground/90">{featured.data.name}</p>
                  <p class="font-body text-sm text-header-foreground/50 mt-1">{featured.data.attribution}</p>
                </figcaption>
              </figure>
            )}
          </div>

          <div>
            <p class="font-body text-[10px] tracking-[0.18em] uppercase text-primary/70 mb-5">
              A Longer Reflection
            </p>
            <h2 class="font-heading text-3xl md:text-4xl text-gold-gradient leading-tight mb-8">
              An evening, a father, and a room full of people
            </h2>

            <!-- Set upright rather than italic: six paragraphs of italic serif is
                 tiring to read. The Cormorant face already separates her voice
                 from the Inter body copy around it. -->
            <blockquote class="t-longform font-heading text-lg md:text-[1.3rem] text-header-foreground/82 leading-relaxed space-y-6">
              <FeaturedStory />
            </blockquote>

            {featured.data.contextNote && (
              <aside class="mt-10 border-l-2 border-primary/40 pl-6 py-1">
                <p class="font-body text-[10px] tracking-[0.16em] uppercase text-primary/60 mb-3">
                  A note on this account
                </p>
                <p class="font-body text-sm text-header-foreground/60 leading-relaxed">
                  {featured.data.contextNote}
                </p>
              </aside>
            )}
          </div>

        </div>
      </div>
    </section>
  )}

  <!-- ═══ INDIVIDUAL WORK AND MENTORSHIP ═══ -->
  <section id="individual-work" class="bg-background scroll-mt-[72px]">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-5xl">

      <div class="max-w-2xl mb-14 md:mb-20 t-reveal">
        <h2 class="font-heading text-3xl md:text-4xl text-gold-gradient leading-tight mb-5">
          Individual work and mentorship
        </h2>
        <p class="font-body text-base text-foreground/70 leading-relaxed">
          Longer relationships, carried over years rather than sessions. These reflections
          come from one-on-one work, and from a family around it.
        </p>
      </div>

      <div class="space-y-16 md:space-y-24">
        {individualWork.map((item, index) => (
          item.data.portrait ? (
            <figure class={`grid gap-8 md:gap-12 items-center t-reveal ${index % 2 === 1 ? 'md:grid-cols-[minmax(0,1fr)_minmax(0,0.6fr)]' : 'md:grid-cols-[minmax(0,0.6fr)_minmax(0,1fr)]'}`}>
              <div class={index % 2 === 1 ? 'md:order-2' : ''}>
                <div class="aspect-[4/5] sm:aspect-[3/2] md:aspect-[4/5] overflow-hidden rounded-xl">
                  <Image
                    src={item.data.portrait}
                    alt={item.data.portraitAlt ?? item.data.name}
                    class="w-full h-full object-cover"
                    style={`object-position: ${item.data.portraitPosition};`}
                    widths={[320, 500, 640]}
                    sizes="(min-width: 768px) 34vw, 100vw"
                    loading="lazy"
                  />
                </div>
              </div>
              <div class={index % 2 === 1 ? 'md:order-1' : ''}>
                <p class="font-body text-[10px] tracking-[0.16em] uppercase text-primary/60 mb-5">{item.data.label}</p>
                <blockquote class="space-y-5 mb-7">
                  {item.data.excerpt.map((paragraph) => (
                    <p class="font-heading text-lg md:text-[1.3rem] text-foreground/82 italic leading-relaxed">{paragraph}</p>
                  ))}
                </blockquote>
                <figcaption class="border-t border-border/60 pt-5">
                  <p class="font-body text-sm text-foreground/85">{item.data.name}</p>
                  <p class="font-body text-xs text-muted-foreground/70 mt-1">{item.data.attribution}</p>
                </figcaption>
              </div>
            </figure>
          ) : (
            <figure class="max-w-3xl mx-auto text-center border border-border/60 rounded-2xl bg-card/50 px-7 py-12 md:px-16 md:py-16 t-reveal">
              <p class="font-body text-[10px] tracking-[0.16em] uppercase text-primary/60 mb-4">{item.data.label}</p>
              <p class="font-heading text-[5rem] md:text-[6.5rem] text-primary/20 leading-none select-none mb-1" aria-hidden="true">&ldquo;</p>
              <blockquote class="space-y-5 mb-8">
                {item.data.excerpt.map((paragraph) => (
                  <p class="font-heading text-lg md:text-[1.25rem] text-foreground/80 italic leading-relaxed">{paragraph}</p>
                ))}
              </blockquote>
              <figcaption>
                <p class="font-body text-sm text-foreground/85">{item.data.name}</p>
                <p class="font-body text-xs text-muted-foreground/70 mt-1">{item.data.attribution}</p>
              </figcaption>
            </figure>
          )
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PHOTOGRAPHIC BREAK ═══ -->
  <section class="relative overflow-hidden aspect-[5/4] sm:aspect-[2/1] md:aspect-[5/2]">
    <Image
      src={sanghamCircle}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-center"
      widths={[640, 1024, 1600]}
      sizes="100vw"
      quality={65}
      loading="lazy"
    />
    <div class="absolute inset-0 bg-void/45"></div>
  </section>

  <!-- ═══ WORKSHOPS AND GROUP EXPERIENCES ═══ -->
  <section id="workshops" class="bg-header text-header-foreground scroll-mt-[72px]">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-5xl">

      <div class="max-w-2xl mb-14 md:mb-20 t-reveal">
        <h2 class="font-heading text-3xl md:text-4xl text-gold-gradient leading-tight mb-5">
          Workshops and group experiences
        </h2>
        <p class="font-body text-base text-header-foreground/65 leading-relaxed">
          Reflections from people who have practised in a room with others, in workshops
          and small group sessions.
        </p>
      </div>

      <div class="space-y-16 md:space-y-24">
        {workshops.map((item) => (
          <figure class="grid md:grid-cols-[minmax(0,1fr)_minmax(0,0.6fr)] gap-8 md:gap-12 items-center t-reveal">
            <div class="order-2 md:order-1">
              <p class="font-body text-[10px] tracking-[0.16em] uppercase text-primary/70 mb-5">{item.data.label}</p>
              <blockquote class="space-y-5 mb-7">
                {item.data.excerpt.map((paragraph) => (
                  <p class="font-heading text-lg md:text-[1.3rem] text-header-foreground/82 italic leading-relaxed">{paragraph}</p>
                ))}
              </blockquote>
              <figcaption class="border-t border-header-foreground/15 pt-5">
                <p class="font-body text-sm text-header-foreground/85">{item.data.name}</p>
                <p class="font-body text-xs text-header-foreground/50 mt-1">{item.data.attribution}</p>
              </figcaption>
            </div>
            {item.data.portrait && (
              <div class="order-1 md:order-2">
                <div class="aspect-[4/5] sm:aspect-[3/2] md:aspect-[4/5] overflow-hidden rounded-xl">
                  <Image
                    src={item.data.portrait}
                    alt={item.data.portraitAlt ?? item.data.name}
                    class="w-full h-full object-cover"
                    style={`object-position: ${item.data.portraitPosition};`}
                    widths={[320, 500, 640]}
                    sizes="(min-width: 768px) 34vw, 100vw"
                    loading="lazy"
                  />
                </div>
              </div>
            )}
          </figure>
        ))}
      </div>

      {featured && (
        <p class="mt-16 pt-10 border-t border-header-foreground/10 font-body text-sm text-header-foreground/55 leading-relaxed max-w-2xl">
          {featured.data.name}&rsquo;s account of a full moon session, and of the group
          process and yoga work that followed, is
          <a href="#featured-story" class="t-link text-gold-light">at the top of this page</a>.
        </p>
      )}
    </div>
  </section>

  <!-- ═══ COMMUNITY REFLECTIONS ═══ -->
  <section id="community" class="bg-background scroll-mt-[72px]">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-4xl">

      <div class="max-w-2xl mb-14 md:mb-20 t-reveal">
        <h2 class="font-heading text-3xl md:text-4xl text-gold-gradient leading-tight mb-5">
          Community reflections
        </h2>
        <p class="font-body text-base text-foreground/70 leading-relaxed">
          These speak less to a particular service and more to how Michael is with people
          over time, in shared community life and in groups.
        </p>
      </div>

      <div class="space-y-14 md:space-y-20">
        {community.map((item) => (
          <figure class="t-reveal">
            <div class="flex items-center gap-5 mb-7">
              {item.data.portrait && (
                <div class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 rounded-full overflow-hidden border border-border">
                  <Image
                    src={item.data.portrait}
                    alt={item.data.portraitAlt ?? item.data.name}
                    class="w-full h-full object-cover"
                    style={`object-position: ${item.data.portraitPosition};`}
                    widths={[80, 160]}
                    sizes="80px"
                    loading="lazy"
                  />
                </div>
              )}
              <figcaption>
                <p class="font-body text-sm text-foreground/85">{item.data.name}</p>
                <p class="font-body text-xs text-muted-foreground/70 mt-1 max-w-[36ch]">{item.data.attribution}</p>
              </figcaption>
            </div>
            <blockquote class="space-y-5 border-l-2 border-primary/35 pl-6 md:pl-8">
              {item.data.excerpt.map((paragraph) => (
                <p class="font-heading text-lg md:text-[1.3rem] text-foreground/80 italic leading-relaxed">{paragraph}</p>
              ))}
            </blockquote>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {reference && (
    <!-- ═══ PROFESSIONAL REFERENCE ═══ -->
    <section id="professional-reference" class="bg-header text-header-foreground scroll-mt-[72px]">
      <div class="container mx-auto px-6 py-20 md:py-28 max-w-4xl t-reveal">

        <div class="max-w-2xl mb-12 md:mb-16">
          <h2 class="font-heading text-3xl md:text-4xl text-gold-gradient leading-tight mb-5">
            Professional reference
          </h2>
          <p class="font-body text-base text-header-foreground/65 leading-relaxed">
            The reflections above come from people who have been on the receiving end of
            the work. This one comes from the clinician who supervised it.
          </p>
        </div>

        <article class="bg-parchment text-parchment-foreground rounded-xl shadow-2xl shadow-black/30 overflow-hidden">
          <div class="px-7 py-10 sm:px-10 md:px-16 md:py-16">

            <header class="flex flex-col sm:flex-row sm:items-center gap-5 pb-8 mb-9 border-b border-parchment-foreground/15">
              {reference.data.portrait && (
                <div class="w-20 h-20 shrink-0 rounded-full overflow-hidden border border-parchment-foreground/15 bg-[#1a2a1a]">
                  <Image
                    src={reference.data.portrait}
                    alt={reference.data.portraitAlt ?? reference.data.name}
                    class="w-full h-full object-cover"
                    style={`object-position: ${reference.data.portraitPosition};`}
                    widths={[80, 160]}
                    sizes="80px"
                    loading="lazy"
                  />
                </div>
              )}
              <div>
                <p class="font-body text-[10px] tracking-[0.16em] uppercase text-gold-dark/80 mb-2">
                  {reference.data.label}
                </p>
                <p class="font-heading text-2xl text-parchment-foreground/90">{reference.data.name}</p>
                <p class="font-body text-sm text-parchment-foreground/60 mt-1">{reference.data.attribution}</p>
              </div>
            </header>

            <!-- The excerpt steps aside once the letter is open, so the card
                 becomes the complete document instead of repeating its own
                 opening lines. Browsers without :has() simply show both. -->
            <blockquote class="t-letter-excerpt space-y-6">
              {reference.data.excerpt.map((paragraph) => (
                <p class="font-heading text-lg md:text-[1.3rem] text-parchment-foreground/85 leading-relaxed">{paragraph}</p>
              ))}
            </blockquote>

            <details class="t-letter mt-9 pt-8 border-t border-parchment-foreground/15">
              <summary class="t-letter-summary inline-flex items-center gap-2.5 font-body text-sm tracking-wide text-gold-dark cursor-pointer rounded-sm">
                <svg class="t-letter-chevron w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
                <span class="t-letter-open">Read the complete letter</span>
                <span class="t-letter-close">Show the short excerpt instead</span>
              </summary>

              <div class="t-letter-body pt-8">
                <div class="t-longform font-heading text-lg md:text-[1.25rem] text-parchment-foreground/80 leading-relaxed space-y-6">
                  <ReferenceLetter />
                </div>
                <footer class="mt-9 pt-7 border-t border-parchment-foreground/15">
                  <p class="font-heading text-xl text-parchment-foreground/85">{reference.data.name}</p>
                  <p class="font-body text-sm text-parchment-foreground/60 mt-1">{reference.data.attribution}</p>
                </footer>
              </div>
            </details>

          </div>
        </article>
      </div>
    </section>
  )}

  <!-- ═══ CLOSING INVITATION ═══ -->
  <section class="bg-background">
    <div class="container mx-auto px-6 py-20 md:py-28 max-w-4xl t-reveal">

      <div class="max-w-2xl mb-12">
        <h2 class="font-heading text-3xl md:text-4xl text-gold-gradient leading-tight mb-5">
          Where to begin
        </h2>
        <p class="font-body text-base text-foreground/70 leading-relaxed">
          If any of this is close to what you are looking for, these are the places
          people usually start. A first conversation costs nothing and carries no
          obligation to continue.
        </p>
      </div>

      <ul class="grid sm:grid-cols-2 gap-px bg-border/60 rounded-xl overflow-hidden border border-border/60 mb-12">
        {startingPoints.map((point) => (
          <li class="bg-background">
            <a href={point.href} class="t-start block h-full px-6 py-6 hover:bg-card/60 transition-colors duration-300">
              <span class="font-heading text-xl text-foreground/88 flex items-center gap-2">
                {point.label}
                <svg class="t-start-arrow w-3.5 h-3.5 text-primary/60 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </span>
              <span class="block font-body text-sm text-muted-foreground/75 mt-2 leading-relaxed">{point.note}</span>
            </a>
          </li>
        ))}
      </ul>

      <a
        href="/contact#cal-section"
        data-cta="book-fit-call"
        data-service="general"
        data-placement="testimonials-closing"
        class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary text-primary-foreground hover:bg-gold-light transition-colors duration-300 rounded-lg text-sm tracking-wider uppercase font-body"
      >
        Book a free 15-minute fit call
      </a>

      <p class="font-body text-sm text-muted-foreground/70 leading-relaxed mt-10 pt-8 border-t border-border/60 max-w-2xl">
        Counselling and mentorship at Sangham are offered in a supportive, non-clinical
        capacity. They are not psychotherapy, psychiatric treatment, or emergency care.
        You can read the full
        <a href="/scope" class="t-link text-primary/80">scope and ethics</a> statement at any time.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  /* Scroll reveal, disabled entirely under reduced-motion (see below). */
  .t-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .t-reveal.t-in {
    opacity: 1;
    transform: none;
  }

  /* Markdown bodies rendered from the testimonial collection. */
  .t-longform :global(p) {
    margin: 0;
  }
  .t-longform :global(p + p) {
    margin-top: 1.5rem;
  }

  /* Expandable full letter. <details> keeps this keyboard operable natively. */
  .t-letter-summary {
    list-style: none;
    transition: color 0.25s ease;
  }
  .t-letter-summary::-webkit-details-marker {
    display: none;
  }
  .t-letter-summary:hover {
    color: var(--color-gold);
  }
  .t-letter-summary:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 4px;
  }
  .t-letter-chevron {
    transition: transform 0.25s ease;
  }
  .t-letter[open] .t-letter-chevron {
    transform: rotate(180deg);
  }
  .t-letter .t-letter-close,
  .t-letter[open] .t-letter-open {
    display: none;
  }
  .t-letter[open] .t-letter-close {
    display: inline;
  }
  .t-letter[open] .t-letter-body {
    animation: tLetterIn 0.35s ease-out;
  }
  /* Fold the excerpt away while the full letter is showing. */
  article:has(.t-letter[open]) .t-letter-excerpt {
    display: none;
  }
  article:has(.t-letter[open]) .t-letter {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  @keyframes tLetterIn {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: none; }
  }

  /* Inline links keep an underline so they read as links without colour alone. */
  .t-link {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: opacity 0.25s ease;
  }
  .t-link:hover {
    opacity: 0.75;
  }

  .t-start:hover .t-start-arrow {
    transform: translateX(4px);
  }
  .t-start:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .t-reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .t-letter[open] .t-letter-body {
      animation: none !important;
    }
    .t-letter-chevron,
    .t-start-arrow {
      transition: none !important;
    }
  }
</style>

<script>
  // Reveal-on-scroll. Under reduced-motion the CSS above already shows every
  // section, so the observer is never attached.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealTargets = document.querySelectorAll('.t-reveal');

  if (reduceMotion || !('IntersectionObserver' in window)) {
    revealTargets.forEach((el) => el.classList.add('t-in'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('t-in');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    revealTargets.forEach((el) => observer.observe(el));
  }
</script>
